# aas-android-build: offline Capacitor 8 debug-APK build image (DESIGN 3.5; PB7a/PB7b). SKELETON - NOT BUILT YET.
# See README.md in this directory for the exact steps and the values that must be filled in (marked TODO-PIN).
# Facts verified from @capacitor/android 8.6.2 and the @capacitor/cli android template (2026-11-23):
#   compileSdk/targetSdk 36, minSdk 24, AGP 8.13.0 (capacitor/build.gradle), template wrapper gradle-8.14.3-all.zip.
ARG TEMURIN_DIGEST=TODO-PIN
FROM eclipse-temurin:21-jdk-jammy@sha256:${TEMURIN_DIGEST}

ARG CMDLINE_TOOLS_ZIP=commandlinetools-linux-TODO-PIN_latest.zip
ARG CMDLINE_TOOLS_SHA256=TODO-PIN
ARG ANDROID_PLATFORM=36
ARG ANDROID_BUILD_TOOLS=36.0.0
ARG GRADLE_VERSION=8.14.3
ARG GRADLE_DIST_SHA256=TODO-PIN

ENV ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk GRADLE_RO_DEP_CACHE=/opt/gradle-ro \
    GRADLE_USER_HOME=/tmp/gradle-home

# 1. SDK command-line tools, hash-checked. Network is available only while the image is BUILT (never at run time).
RUN apt-get update && apt-get install -y --no-install-recommends unzip ca-certificates curl && rm -rf /var/lib/apt/lists/* \
 && mkdir -p ${ANDROID_HOME}/cmdline-tools \
 && curl -fsSL -o /tmp/cmdline.zip https://dl.google.com/android/repository/${CMDLINE_TOOLS_ZIP} \
 && echo "${CMDLINE_TOOLS_SHA256}  /tmp/cmdline.zip" | sha256sum -c - \
 && unzip -q /tmp/cmdline.zip -d ${ANDROID_HOME}/cmdline-tools && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
 && rm /tmp/cmdline.zip

# 2. Platform + build-tools; licence acceptance writes ${ANDROID_HOME}/licenses (hashes are committed in DIGESTS.json check).
RUN yes | ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --licenses >/dev/null \
 && ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager "platforms;android-${ANDROID_PLATFORM}" "build-tools;${ANDROID_BUILD_TOOLS}"

# 3. Gradle distribution pre-placed with distributionSha256Sum (wrapper must not download).
RUN curl -fsSL -o /tmp/gradle.zip https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip \
 && echo "${GRADLE_DIST_SHA256}  /tmp/gradle.zip" | sha256sum -c - \
 && mkdir -p /opt/gradle-dist && mv /tmp/gradle.zip /opt/gradle-dist/

# 4. Studio-owned Android project template (`cap add android` output for the kit) + pre-resolved read-only dependency cache
#    + gradle/verification-metadata.xml (sha256 for every artifact). Generated by a CI step, copied in here:
#      COPY android-template /opt/aas/android-template
#      RUN ... gradlew --write-verification-metadata sha256 assembleDebug  (network on, build time only)
#           && cp -r $GRADLE_USER_HOME/caches/modules-2 /opt/gradle-ro   # becomes GRADLE_RO_DEP_CACHE
# TODO: steps 4 (see README.md); this skeleton intentionally does not yet produce a working image.

RUN chmod -R a+rX /opt && useradd -m -u 1000 aas || true
USER 1000:1000
WORKDIR /tmp
# Run: --network none --read-only --tmpfs /tmp:rw,exec --memory 4g --cpus 4 -v <dist>:/dist:ro -v <keystore>:/keys/aas-debug.keystore:ro
#   gradlew --offline --no-daemon --dependency-verification strict assembleDebug ...
ENTRYPOINT ["/usr/local/bin/aas-build-android"]
