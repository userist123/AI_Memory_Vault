#!/bin/sh
# Runs inside the container: /src (read-only: kit + src/ + public/) -> /out/dist. No network is available.
# vite and its dependencies come from the image (/opt/aas/kit/node_modules, read-only, exec allowed); /tmp is noexec.
set -eu
W=/tmp/w
mkdir -p "$W" "${HOME:-/tmp/home}"
cp -R /src/. "$W/"
cd "$W"
# Only the lockfile baked into this image is approved (DESIGN 3.3). Anything else fails closed.
want=$(cat /opt/aas/kit.lock.sha256)
have=$(sha256sum pnpm-lock.yaml | cut -d' ' -f1)
[ "$want" = "$have" ] || { echo "aas-build-web: unapproved lockfile (sha256 $have is not the approved $want)" >&2; exit 3; }
if [ -e node_modules ] || [ -L node_modules ]; then echo "aas-build-web: node_modules in the source tree is not allowed" >&2; exit 4; fi
# Real (tmpfs) node_modules dir whose entries link into the baked one: vite can write node_modules/.vite-temp (bundled
# config) while every package file stays in the read-only image.
mkdir node_modules
for e in /opt/aas/kit/node_modules/* /opt/aas/kit/node_modules/.[!.]*; do
  if [ -e "$e" ] || [ -L "$e" ]; then ln -s "$e" "node_modules/$(basename "$e")"; fi
done
exec node /opt/aas/kit/node_modules/vite/bin/vite.js build --outDir /out/dist --emptyOutDir
