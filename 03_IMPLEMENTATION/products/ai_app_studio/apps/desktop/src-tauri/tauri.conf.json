{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI App Studio",
  "version": "0.1.0",
  "identifier": "dev.aiappstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm icons && pnpm dev",
    "beforeBuildCommand": "pnpm icons && pnpm build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AI App Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --proxy-server=http://127.0.0.1:9 --force-webrtc-ip-handling-policy=disable_non_proxied_udp"
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:17875 ws://127.0.0.1:17875; frame-src http://*.localhost:17880; worker-src 'self'; media-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": false,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "publisher": "AI App Studio",
    "shortDescription": "Watch the AI build phone, tablet and desktop apps live",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
