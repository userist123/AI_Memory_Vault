<Application x:Class="XAU_Kinetic.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dark Theme Resources -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#0F172A" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1E293B" />
            <SolidColorBrush x:Key="HeaderBrush" Color="#334155" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
            <SolidColorBrush x:Key="AccentGoldBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="SignalGreenBrush" Color="#10B981" />
            <SolidColorBrush x:Key="EmergencyRedBrush" Color="#EF4444" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
