       # P0-012: LearningEngine promotes to partially_verified legitimately without breakage
>>>>>> def test_p0_012_learning_engine_partially_verified_promotion():
    1:     storage = StorageEngine()
    1:     controller = MemoryController(storage)
    1:     router = ToolRouter(controller)
           
    1:     note_id = str(uuid.uuid4())
           # Create active note with medium confidence and 6 relations (>= threshold*2)
    7:     relations = [{"relation": "related_to", "target": "knowledge", "target_id": str(uuid.uuid4())} for _ in range(6)]
    1:     note = make_test_note(note_id, lifecycle="ACTIVE", verification="unverified")
    1:     note["confidence"] = "medium"
    1:     note["relations"] = relations
    1:     note["provenance"] = {"source_type": "user", "source_ref": "user-base"}
           
           # Store note directly in storage as test fixture
    1:     storage.set(note_id, note)
           
    1:     engine = LearningEngine(controller, router)
    1:     promoted = engine.promote_memories(Principal.AI_AGENT)
           
    1:     assert note_id in promoted
    1:     updated_note = storage.get(note_id)
    1:     assert updated_note["confidence"] == "high"
    1:     assert updated_note["verification"] == "partially_verified"
