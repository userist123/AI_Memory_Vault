>>>>>>         level += 1
>>>>>>         i = start
>>>>>>         while i < end:
>>>>>>             start = i
>>>>>>             op = code[i]
>>>>>>             i += 1
>>>>>>             op = OPCODES[op]
>>>>>>             if op in (SUCCESS, FAILURE, ANY, ANY_ALL,
>>>>>>                       MAX_UNTIL, MIN_UNTIL, NEGATE):
>>>>>>                 print_(op)
