>>>>>> def dis(code):
>>>>>>     import sys
       
>>>>>>     labels = set()
>>>>>>     level = 0
>>>>>>     offset_width = len(str(len(code) - 1))
       
>>>>>>     def dis_(start, end):
>>>>>>         def print_(*args, to=None):
>>>>>>             if to is not None:
>>>>>>                 labels.add(to)
>>>>>>                 args += ('(to %d)' % (to,),)
>>>>>>             print('%*d%s ' % (offset_width, start, ':' if start in labels else '.'),
>>>>>>                   end='  '*(level-1))
