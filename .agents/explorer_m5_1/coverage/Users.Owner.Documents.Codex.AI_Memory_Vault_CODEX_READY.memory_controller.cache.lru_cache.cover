>>>>>>     def _make_key(self, *parts: Any) -> str:
               """Create a deterministic hash key from arbitrary serializable parts."""
   12:         raw = "|".join(str(p) for p in parts)
    4:         return hashlib.sha256(raw.encode()).hexdigest()
       
