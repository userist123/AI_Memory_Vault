>>>>>> from typing import List, Dict
>>>>>> import math
       
>>>>>> class RelevanceScorer:
           """Simple relevance scoring based on token overlap and confidence.
       
           The score is a float between 0 and 1.
           """
       
>>>>>>     def __init__(self):
    2:         pass
       
>>>>>>     def score(self, query: str, notes: List[Dict[str, any]]) -> List[Dict[str, any]]:
    2:         query_tokens = set(query.lower().split())
    2:         scored = []
    4:         for note in notes:
    2:             content = note.get("content", "")
    2:             note_tokens = set(content.lower().split())
    2:             overlap = query_tokens.intersection(note_tokens)
    2:             overlap_ratio = len(overlap) / max(len(query_tokens), 1)
    2:             confidence = note.get("confidence", 0.5)
                   # Convert confidence string to numeric if needed
    2:             if isinstance(confidence, str):
    2:                 confidence_map = {
    2:                     'very_high': 1.0,
    2:                     'high': 0.9,
    2:                     'medium': 0.5,
    2:                     'low': 0.2,
    2:                     'unknown': 0.0
                       }
    2:                 confidence = confidence_map.get(confidence.lower(), 0.5)
    2:             final = (overlap_ratio + confidence) / 2
    2:             scored.append({"id": note.get("id"), "score": final})
    4:         scored.sort(key=lambda x: x["score"], reverse=True)
    2:         return scored
