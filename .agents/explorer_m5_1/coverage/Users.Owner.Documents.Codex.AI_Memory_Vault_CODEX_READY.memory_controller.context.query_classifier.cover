   20:         for t in ["knowledge", "project", "procedure", "decision", "error", "lesson", "experience", "resource", "hypothesis"]:
   18:             if t in lowered:
    2:                 target_types.append(t)
               # Lifecycle filters – e.g., "active", "verified".
    2:         lifecycle_filters = []
   18:         for stage in ["raw", "classified", "normalized", "review", "verified", "active", "superseded", "archived"]:
   16:             if stage in lowered:
>>>>>>                 lifecycle_filters.append(stage.upper())
    2:         confidence = 0.9 if intent != Intent.READ else 0.5
