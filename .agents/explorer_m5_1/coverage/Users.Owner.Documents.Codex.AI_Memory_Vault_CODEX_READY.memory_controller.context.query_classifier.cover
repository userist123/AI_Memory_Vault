>>>>>>     PROMOTE = "promote"
>>>>>>     ARCHIVE = "archive"
       
>>>>>> class QueryClassifier:
           """Classify a raw query string into intent and target memory types.
       
           This is a rule‑based lightweight classifier; can be extended with
