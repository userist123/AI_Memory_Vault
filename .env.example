# Local-only runtime configuration. Never place real credentials here.
# Copy to .env locally and keep the real file untracked.

LOCAL_INBOX_PATH=./06_INBOX/local_only
MEMORY_STORAGE_PATH=./.memory-runtime
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=all-minilm

# External integrations (optional)
GITHUB_TOKEN=YOUR_GITHUB_TOKEN_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_HERE
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST/DATABASE
