<Window x:Class="RegistruTransferuri.UI.Dialogs.EnrollMediaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ ÎNREGISTRARE &amp; AMPRENTARE MEDIU FIZIC DE STOCARE"
        Height="620" Width="700"
        MinHeight="500" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Notice -->
        <Border Grid.Row="0" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <TextBlock Text="🔒 Datele hardware fizice (VID/PID, S/N Firmware, Capacitate) sunt extrase direct din sistem și sunt IMUTABILE. Completați Denumirea Volumului / Numărul de Înregistrare din registrul intern HG 585."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CyberBlueBrush}" />
        </Border>

        <!-- Scrollable Form Container -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Metadata editabile -->
                <GroupBox Header="📋 1. Denumire Volum &amp; Număr Înregistrare Mediu (HG 585)" Style="{StaticResource TacticalGroupBoxStyle}">
                    <Grid Margin="4,8,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                            <TextBlock Text="Denumire Volum / Nr. Înregistrare Mediu: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtFriendlyName" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Plafon Maxim Clasificare: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbMaxClass" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Politică Acces Stație: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CmbPolicy" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Gestionar / Responsabil:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtCustodian" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Unitate Militară:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtUnit" Text="MApN / Structura Securitate" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 2. Date Hardware Strict Read-Only -->
                <GroupBox Header="🔒 2. Date Tehnice Hardware Extrase din Windows (Strict Read-Only)" Style="{StaticResource TacticalGroupBoxStyle}">
                    <Grid Margin="4,8,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Model Fabrică &amp; Producător: 🔒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHwModel" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Tip Mediu &amp; Conexiune: 🔒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHwType" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                            <TextBlock Text="Serie Hardware Firmware (S/N): 🔒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHwSn" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="34" FontFamily="Consolas, Cascadia Code" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                            <TextBlock Text="Identificator Hardware (VID : PID): 🔒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHwVidPid" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="Capacitate Fizică &amp; Literă Volum: 🔒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHwCap" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="34" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Anulează" Width="110" Height="36" Margin="0,0,10,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnCancelClick" />
            <Button Content="💾 Salvează în Whitelist" Width="200" Height="36" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
