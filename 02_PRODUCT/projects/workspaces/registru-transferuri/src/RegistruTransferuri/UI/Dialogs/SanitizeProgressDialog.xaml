<Window x:Class="RegistruTransferuri.UI.Dialogs.SanitizeProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧹 Execuție Sanitizare Activă NIST SP 800-88r2" 
        Height="370" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🧹 MOTOR DE SANITIZARE ACTIVĂ &amp; DISTRUGERE DATE" FontWeight="Bold" FontSize="14" Foreground="{StaticResource CyberBlueBrush}" />
            <TextBlock x:Name="TxtMediaInfo" Text="Unitate: E:\ | Suport: Kingston DataTraveler (64 GB)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <ProgressBar x:Name="PrgSanitize" Grid.Row="1" Height="18" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10" Foreground="{StaticResource EmeraldSecurityBrush}" Background="{StaticResource BgElevatedBrush}" />

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="Inițializare proces de suprascriere..." FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

        <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtLog" Text="[INFO] Începere procedură NIST SP 800-88r2..." FontFamily="Consolas, Cascadia Code" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnClose" Content="Închide &amp; Deschide Certificat" Width="220" Height="36" Style="{StaticResource TacticalPrimaryButtonStyle}" IsEnabled="False" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
