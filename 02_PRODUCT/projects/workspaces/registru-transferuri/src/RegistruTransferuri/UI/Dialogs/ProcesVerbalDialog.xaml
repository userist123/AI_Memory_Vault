<Window x:Class="RegistruTransferuri.UI.Dialogs.ProcesVerbalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📄 PROCES-VERBAL DE PREDARE-PRIMIRE (HG 585/2002)"
        Height="720" Width="860"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WebBrowser x:Name="BrowserPreview" Grid.Row="0" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="📥 Export PDF Nativ" Width="170" Height="36" Margin="0,0,10,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnExportPdfClick" />
            <Button Content="💾 Salvează HTML" Width="150" Height="36" Margin="0,0,10,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnSaveHtmlClick" />
            <Button Content="Închide" Width="100" Height="36" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
