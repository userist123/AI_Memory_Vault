<Window x:Class="RegistruTransferuri.UI.Dialogs.ReceiverVerifyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 VERIFICATOR INTEGRITATE PACHET RECEPȚIONAT (SHA-256)"
        Height="480" Width="700"
        MinHeight="400" MinWidth="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
            <TextBlock Text="🔍 Operatorul de la destinație selectează fișierul fizic recepționat pentru calcularea bit-cu-bit a sumei SHA-256 și compararea automată cu hash-ul înregistrat la predare."
                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource CyberBlueBrush}" />
        </Border>

        <GroupBox Grid.Row="1" Header="📦 Comparare Integritate Criptografică" Style="{StaticResource TacticalGroupBoxStyle}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="1. Hash Înregistrat la Expediere (SHA-256):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="TxtRegisteredHash" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="36" FontFamily="Consolas, Cascadia Code" Margin="0,0,0,12" />

                <TextBlock Text="2. Selectează Fișierul Recepționat Fizic:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSelectedFilePath" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Content="📁 Răsfoiește..." Width="130" Height="36" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnBrowseFileClick" />
                </Grid>

                <TextBlock Text="3. Rezultat Validare Integritate:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock x:Name="LblResultStatus" Text="Așteaptă selectarea fișierului..." FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Închide" Width="110" Height="36" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
