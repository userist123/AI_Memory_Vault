<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= OBSIDIAN TACTICAL COMMAND COLOR TOKENS ================= -->
    <!-- Surfaces -->
    <Color x:Key="BgDeepColor">#080C14</Color>
    <Color x:Key="BgBaseColor">#0D1322</Color>
    <Color x:Key="BgCardColor">#121A2D</Color>
    <Color x:Key="BgSurfaceColor">#121A2D</Color>
    <Color x:Key="BgElevatedColor">#18233C</Color>
    <Color x:Key="BgHighlightColor">#223254</Color>

    <!-- Borders -->
    <Color x:Key="BorderDefaultColor">#1E2C48</Color>
    <Color x:Key="BorderSubtleColor">#2D3F66</Color>
    <Color x:Key="BorderFocusVioletColor">#7C3AED</Color>
    <Color x:Key="BorderFocusCyanColor">#00E5FF</Color>

    <!-- Semantic Accents -->
    <Color x:Key="TacticalVioletColor">#7C3AED</Color>
    <Color x:Key="TacticalVioletLightColor">#8B5CF6</Color>
    <Color x:Key="CyberBlueColor">#00E5FF</Color>
    <Color x:Key="CyberBlueLightColor">#38BDF8</Color>
    <Color x:Key="EmeraldSecurityColor">#10B981</Color>
    <Color x:Key="EmeraldDarkColor">#064E3B</Color>
    <Color x:Key="AmberWarningColor">#F59E0B</Color>
    <Color x:Key="AmberDarkColor">#78350F</Color>
    <Color x:Key="CrimsonDangerColor">#EF4444</Color>
    <Color x:Key="CrimsonDarkColor">#7F1D1D</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- ================= FROZEN SOLID COLOR BRUSHES (GPU OPTIMIZED) ================= -->
    <!-- Surfaces -->
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgBaseBrush" Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgHighlightBrush" Color="{StaticResource BgHighlightColor}" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderFocusVioletBrush" Color="{StaticResource BorderFocusVioletColor}" />
    <SolidColorBrush x:Key="BorderFocusCyanBrush" Color="{StaticResource BorderFocusCyanColor}" />

    <!-- Accents -->
    <SolidColorBrush x:Key="TacticalVioletBrush" Color="{StaticResource TacticalVioletColor}" />
    <SolidColorBrush x:Key="TacticalVioletLightBrush" Color="{StaticResource TacticalVioletLightColor}" />
    <SolidColorBrush x:Key="CyberBlueBrush" Color="{StaticResource CyberBlueColor}" />
    <SolidColorBrush x:Key="CyberBlueLightBrush" Color="{StaticResource CyberBlueLightColor}" />
    <SolidColorBrush x:Key="EmeraldSecurityBrush" Color="{StaticResource EmeraldSecurityColor}" />
    <SolidColorBrush x:Key="EmeraldDarkBrush" Color="{StaticResource EmeraldDarkColor}" />
    <SolidColorBrush x:Key="AmberWarningBrush" Color="{StaticResource AmberWarningColor}" />
    <SolidColorBrush x:Key="AmberDarkBrush" Color="{StaticResource AmberDarkColor}" />
    <SolidColorBrush x:Key="CrimsonDangerBrush" Color="{StaticResource CrimsonDangerColor}" />
    <SolidColorBrush x:Key="CrimsonDarkBrush" Color="{StaticResource CrimsonDarkColor}" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Legacy Compatibility Aliases (maps to new tokens) -->
    <SolidColorBrush x:Key="Brush.Bg.Deep" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource BgBaseColor}" />
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="Brush.Bg.Highlight" Color="{StaticResource BgHighlightColor}" />
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource BorderDefaultColor}" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Violet" Color="{StaticResource TacticalVioletColor}" />
    <SolidColorBrush x:Key="Brush.Accent.VioletHover" Color="{StaticResource TacticalVioletLightColor}" />
    <SolidColorBrush x:Key="Brush.Accent.CyberBlue" Color="{StaticResource CyberBlueColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Cyan" Color="{StaticResource CyberBlueLightColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Emerald" Color="{StaticResource EmeraldSecurityColor}" />
    <SolidColorBrush x:Key="Brush.Accent.EmeraldGlow" Color="{StaticResource EmeraldDarkColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Amber" Color="{StaticResource AmberWarningColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Crimson" Color="{StaticResource CrimsonDangerColor}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Brush.Text.Cyan" Color="{StaticResource CyberBlueLightColor}" />

</ResourceDictionary>
