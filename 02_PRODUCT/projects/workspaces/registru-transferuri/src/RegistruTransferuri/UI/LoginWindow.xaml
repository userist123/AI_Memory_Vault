<Window x:Class="RegistruTransferuri.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUTENTIFICARE — REGISTRU MILITAR DE TRANSFERURI"
        Height="520" Width="500"
        MinHeight="450" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo & Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource TacticalVioletBrush}" BorderThickness="1.5" CornerRadius="12" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🛡️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ROMÂNIA • MApN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberBlueBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Registru Transferuri Date" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                <TextBlock Text="Sistem Informatic Securizat Air-Gapped" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Form Card -->
            <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Selectați Operator Militar: *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="OperatorCombo" Height="38" Margin="0,0,0,14" />

                    <TextBlock Text="PIN Numeric de Autentificare (6 cifre): *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PinBox" Height="40" FontSize="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MaxLength="6" KeyDown="OnPinKeyDown" />
                </StackPanel>
            </Border>

            <!-- Action Button -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Button Content="🔓 Autentificare în Sistem" Height="40" FontSize="13" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnLoginClick" />
                <TextBlock x:Name="LblError" Text="" FontSize="11" Foreground="{StaticResource CrimsonDangerBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
