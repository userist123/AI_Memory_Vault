{
  "$description": "Build settings for the Casa3D brand. aliases keeps the CSS names the app already uses (old name -> token path); scopes re-theme a selector from tokens/brands/<brand>/scopes/<name> (nested under parent when given); copyTo lists files the build also writes, relative to the design-system directory.",
  "name": "casa3d",
  "aliases": {
    "bg": "color.bg.canvas", "bg-2": "color.bg.sunken", "surface": "color.bg.surface", "surface-2": "color.bg.raised",
    "ink": "color.fg.default", "ink-2": "color.fg.secondary", "ink-3": "color.fg.muted", "ink-num": "color.fg.numeric",
    "line": "color.border.default", "line-strong": "color.border.strong",
    "accent": "color.accent.default", "accent-soft": "color.accent.soft",
    "ok": "color.status.ok", "ok-soft": "color.status.ok-soft", "warn": "color.status.warn", "warn-soft": "color.status.warn-soft",
    "err": "color.status.err", "err-soft": "color.status.err-soft", "focus": "color.focus.ring",
    "paper": "color.paper.default", "paper-2": "color.paper.sunken", "graphite": "color.fg.default", "lead": "color.fg.muted", "rule": "color.border.rule",
    "s-1": "space.1", "s-2": "space.2", "s-3": "space.3", "s-4": "space.4", "s-5": "space.5", "s-6": "space.6", "s-7": "space.7",
    "r-sm": "radius.sm", "r-md": "radius.md", "r-full": "radius.full",
    "shadow-1": "shadow.1", "shadow-2": "shadow.2",
    "fs-xs": "font.size.xs", "fs-sm": "font.size.sm", "fs-md": "font.size.md", "fs-lg": "font.size.lg", "fs-xl": "font.size.xl", "fs-2xl": "font.size.2xl",
    "serif": "font.family.serif", "sans": "font.family.sans", "mono": "font.family.sans",
    "h-sm": "size.control.sm", "h-md": "size.control.md", "h-lg": "size.control.lg", "hit": "size.hit", "sheet-peek": "size.sheet-peek"
  },
  "scopes": [
    { "name": "home", "selector": ".home" },
    { "name": "ws", "selector": ".ws" },
    { "name": "ws-side", "selector": ".ws .side", "parent": "ws" }
  ],
  "copyTo": ["../casa3d/app/app/tokens.css"]
}
