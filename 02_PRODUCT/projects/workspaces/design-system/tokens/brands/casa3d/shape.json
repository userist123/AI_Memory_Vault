{
  "radius": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "shadow": {
    "$type": "shadow",
    "1": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2276, 0.0065, 78.19], "hex": "#1E1C19", "alpha": 0.08 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "2": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2276, 0.0065, 78.19], "hex": "#1E1C19", "alpha": 0.14 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 8, "unit": "px" },
        "blur": { "value": 24, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    }
  }
}
