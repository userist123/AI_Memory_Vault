# PostgreSQL (în producție: Neon din Vercel Marketplace setează automat această variabilă).
# Fără ea, aplicația folosește PGlite local în ./.data/pglite (dezvoltare).
DATABASE_URL=
# Opțional: propuneri de design generate de Claude. Fără cheie, aplicația folosește motorul de reguli (marcat clar în interfață).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Administrare (preț manual, linkuri de afiliere, statistici). Minimum 16 caractere; fără el rutele de administrare răspund 404.
ADMIN_TOKEN=
