<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogAnalyzer.Dfir</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- WP11 rule data (known security agents, remote-access tools, shared lists): data, not code; embedded so the rules never depend on a file next to the exe. -->
    <EmbeddedResource Include="Analysis\Data\*.json" LogicalName="LogAnalyzer.Dfir.Analysis.Data.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Detection rules shipped with the application (YARA-lite, Sigma-lite); hashed and versioned when loaded. -->
    <None Include="Rules\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
