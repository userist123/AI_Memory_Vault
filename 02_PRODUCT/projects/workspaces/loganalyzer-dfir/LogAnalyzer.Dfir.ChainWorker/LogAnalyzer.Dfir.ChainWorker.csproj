<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test-only helper process for the multi-process HashChain / SharedAppend tests (LogAnalyzer.Dfir.Tests/MultiProcessChainTests).
       Never published with the application: the Package job publishes only the three edition projects. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LogAnalyzer.Dfir.Core\LogAnalyzer.Dfir.Core.csproj" />
  </ItemGroup>
</Project>
