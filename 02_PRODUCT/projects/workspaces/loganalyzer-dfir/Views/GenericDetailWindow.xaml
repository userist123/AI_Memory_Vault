<Window x:Class="LogAnalyzer.UI.Views.GenericDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LogAnalyzer.Core.Models;assembly=LogAnalyzer.Core"
        Title="Forensic Event &amp; Artifact Inspection" Height="700" Width="880"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.20"/>
                    <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:0.20" DecelerationRatio="0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" CornerRadius="10" Opacity="0" Effect="{StaticResource ModalShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="20"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource Surface2Brush}" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <Path Data="M 15.5 14 h -.79 l -.28 -.27 A 6.471 6.471 0 0 0 16 9.5 A 6.5 6.5 0 1 0 9.5 16 c 1.61 0 3.09 -.59 4.23 -1.57 l .27 .28 v .79 l 5 4.99 L 20.49 19 l -4.99 -5 z m -6 0 C 7.01 14 5 11.99 5 9.5 S 7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14 z"
                          Fill="{StaticResource PrimaryAccentBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="DETAILED FORENSIC EVENT &amp; ARTIFACT INSPECTOR" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Width="38" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"/>
            </Grid>

            <!-- Body Area -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Metadata Summary -->
                <Border Grid.Row="0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,24,0">
                            <TextBlock Text="EVENT ID / ARTIFACT:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="EventIdBlock" Text="4624 (Logon)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TIMESTAMP (UTC):" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="TimestampBlock" Text="2026-08-23 10:14:22" FontSize="12" FontFamily="{StaticResource CodeFontFamily}" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" x:Name="TypeBadge" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock x:Name="TypeBlock" Text="SECURITY AUDIT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tabs: Structured Properties & Raw Payload -->
                <TabControl Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <TabItem Header="Structured Attributes" Style="{StaticResource InspectorTabItemStyle}">
                        <Grid Margin="12">
                            <DataGrid x:Name="PropertiesDataGrid" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Property Field" Binding="{Binding Key}" Width="200" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <DataGridTextColumn Header="Extracted Value" Binding="{Binding Value}" Width="*" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Raw Message / Payload" Style="{StaticResource InspectorTabItemStyle}">
                        <Grid Margin="12">
                            <TextBox x:Name="RawMessageTextBox" IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource CodeTextBrush}" BorderBrush="{StaticResource BorderBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Padding="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Close Inspector" Click="Close_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>