<UserControl x:Class="LogAnalyzer.UI.Views.IncidentTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,20">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Incident Timeline" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Margin="12,0,0,0" BorderBrush="{StaticResource PrimaryAccentBrush}" Background="{StaticResource Surface3Brush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="LIVE NARRATIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TOTAL EVENTS: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TimelineItems.Count, FallbackValue=0}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Main Timeline Content: Left Track + Right Summary Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Vertical Timeline Track -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,16,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TimelineItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Monospace Timestamp -->
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{StaticResource CyanAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>

                                    <!-- Vertical Axis & Glowing Dot -->
                                    <Grid Grid.Column="1" HorizontalAlignment="Center">
                                        <Rectangle Width="2" Fill="{StaticResource BorderBrush}" VerticalAlignment="Stretch" Margin="0,12,0,0"/>
                                        <Ellipse Width="10" Height="10" Fill="{Binding DotColor}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                    </Grid>

                                    <!-- Event Card -->
                                    <Border Grid.Column="2" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="TYPE: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                                                <TextBlock Text="SEVERITY: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="Bold" Foreground="{Binding SeverityColor}" Margin="0,0,12,0"/>
                                                <TextBlock Text="SOURCE: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding Source}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Right: Chronological Summary & Metrics -->
            <Border Grid.Column="1" Style="{StaticResource ObsidianCardStyle}" Padding="16">
                <StackPanel>
                    <TextBlock Text="TIMELINE SUMMARY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="TOTAL CORRELATED EVENTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TimelineItems.Count, FallbackValue=0}" FontSize="18" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,14"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="FIRST DETECTION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="09:15:32 UTC" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,14"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="LAST DETECTED ACTIVITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="09:27:18 UTC" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{StaticResource CyanAccentBrush}" Margin="0,0,0,14"/>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                    <TextBlock Text="PEAK THREAT LEVEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="CRITICAL (3 ALERTS)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBlock Text="EDR Shield active: C2 beacon isolated &amp; suspicious processes contained." FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>