<Window x:Class="LogAnalyzer.UI.Views.AlertDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Triage Incident Securitate"
        Height="750" Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0D1117" Foreground="#C9D1D9">

    <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Border x:Name="SeverityBadge" Background="#30363D" CornerRadius="4" Padding="10,4">
                    <TextBlock x:Name="TxtSeverity" Text="CRITIC" FontSize="11" FontWeight="Bold" Foreground="#F85149"/>
                </Border>
                <Border Background="#2D2140" BorderBrush="#503770" BorderThickness="1" CornerRadius="4" Margin="10,0,0,0" Padding="8,4">
                    <TextBlock x:Name="TxtMitre" Text="MITRE: T1070" FontSize="11" FontWeight="Bold" Foreground="#D2A8FF"/>
                </Border>
            </StackPanel>

            <TextBlock x:Name="TxtTitle" Grid.Row="1" Text="Titlu Alerta" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="DIAGNOSTIC SOC" FontSize="10" FontWeight="Bold" Foreground="#58A6FF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtExplanation" Text="..." FontSize="13" Foreground="#C9D1D9" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="MAPPING MITRE ATT&amp;CK" FontSize="10" FontWeight="Bold" Foreground="#D2A8FF" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtMitreTactica" Text="Tactica: -" FontSize="12" Foreground="#C9D1D9"/>
                                    <TextBlock x:Name="TxtMitreTehnica" Text="Tehnica: -" FontSize="12" Foreground="#C9D1D9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="EVENIMENT BRUT" FontSize="10" FontWeight="Bold" Foreground="#D29922" Margin="0,0,0,6"/>
                                    <TextBox x:Name="TxtTriggerInfo" AcceptsReturn="True" Background="Transparent" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="12" Foreground="#8B949E" IsReadOnly="True" MaxHeight="150" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Background="#010409" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="15" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="CHECKLIST TRIAGE L1" FontSize="11" FontWeight="Bold" Foreground="#E3B341" Margin="0,0,0,10"/>
                                <CheckBox Content="1. Valideaza User / IP" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                                <CheckBox Content="2. Identifica IOC-uri" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                                <CheckBox Content="3. Verifica Timeline +/-10 min" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                                <CheckBox Content="4. Construieste un timeline scurt" Foreground="#C9D1D9" Margin="0,0,0,6"/>
                                <CheckBox Content="5. Clasifica incidentul (TP/FP)" Foreground="#C9D1D9" Margin="0,0,0,6"/>

                                <TextBlock Text="CLASIFICARE / STATUS:" FontSize="10" FontWeight="Bold" Foreground="#8B949E" Margin="0,15,0,5"/>
                                <ComboBox x:Name="CmbStatus" Background="#161B22" Foreground="#FFFFFF" Margin="0,0,0,5">
                                    <ComboBoxItem Content="Noua"/>
                                    <ComboBoxItem Content="In Analiza"/>
                                    <ComboBoxItem Content="Escalata (L2)"/>
                                    <ComboBoxItem Content="Inchisa"/>
                                </ComboBox>
                                <ComboBox x:Name="CmbResolution" Background="#161B22" Foreground="#FFFFFF">
                                    <ComboBoxItem Content="Neclasificat"/>
                                    <ComboBoxItem Content="True Positive (Atac)"/>
                                    <ComboBoxItem Content="False Positive (Zgomot)"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Margin="0,15,0,0" Padding="15">
                        <StackPanel>
                            <CheckBox x:Name="ChkVerified" Content="Marcheaza alerta ca Finalizata / Analizata vizual" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,10"/>
                            <TextBlock Text="NOTITE INVESTIGATIE SOC:" FontSize="10" FontWeight="Bold" Foreground="#8B949E" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtNotes" AcceptsReturn="True" Background="#010409" BorderBrush="#30363D" BorderThickness="1"
                                     FontSize="12" Foreground="#FFFFFF" Height="70" Padding="8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Salveaza si Inchide" Click="SaveButton_Click" Background="#238636" BorderThickness="0" FontWeight="Bold" Foreground="White" Height="38" Margin="0,0,10,0" Width="160"/>
                <Button Content="Anuleaza" Click="CancelButton_Click" Background="#21262D" BorderThickness="0" FontWeight="Bold" Foreground="#C9D1D9" Height="38" Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
