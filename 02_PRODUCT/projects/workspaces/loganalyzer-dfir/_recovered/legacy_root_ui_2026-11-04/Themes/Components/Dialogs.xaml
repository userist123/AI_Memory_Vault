<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Modal Backdrop -->
    <Style x:Key="ModalBackdropStyle" TargetType="Grid">
        <Setter Property="Background" Value="#E6080B12"/>
        <Setter Property="Panel.ZIndex" Value="99999"/>
    </Style>

    <!-- Modal Dialog Window Frame -->
    <Style x:Key="ModalDialogStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

</ResourceDictionary>