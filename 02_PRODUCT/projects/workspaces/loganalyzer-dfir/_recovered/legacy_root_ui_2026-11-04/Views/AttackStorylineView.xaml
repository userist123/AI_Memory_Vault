<UserControl x:Class="LogAnalyzer.UI.Views.AttackStorylineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Attack Storyline &amp; Kill Chain Lineage" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Margin="14,0,0,0" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentStoryline.RiskLevel, StringFormat='SEVERITY: {0}', FallbackValue='CRITICAL INTRUSION'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                </Border>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Export Incident PDF Report" Command="{Binding ExportPdfReportCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8"/>
        </DockPanel>

        <!-- Summary & Kill Chain Stage Progression Breadcrumbs -->
        <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentStoryline.IncidentTitle, FallbackValue='Multi-Stage Campaign Attribution'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="ISO/IEC 27042 Validated" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding CurrentStoryline.OverallSummary, FallbackValue='Correlated forensic evidence indicates persistent adversary activity progressing across lateral pivots.'}" FontSize="12" LineHeight="18" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                
                <!-- Visual Stage Progression Rail -->
                <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="01. INITIAL ACCESS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="T1110 (Brute Force)" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="→" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="02. EXECUTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="T1059 (PowerShell)" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="→" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="03. PERSISTENCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource HighBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="T1547 (Run Keys)" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="5" Text="→" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <TextBlock Text="04. LATERAL MOVE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="T1021 (WinRM/SMB)" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Kill Chain Stages List -->
        <Border Grid.Row="2" Style="{StaticResource ObsidianCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="Chronological Intrusion Stages Identified" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="Click row to pivot to raw telemetry" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StorylineNodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{Binding SeverityColor, FallbackValue={StaticResource BorderBrush}}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="14" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotStorylineStageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                <TextBlock Text="{Binding TechniqueId}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{StaticResource CyanAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>