<Project Sdk="Microsoft.NET.Sdk">
  <!-- The optional AI explanation layer (local model over loopback). Nothing in the deterministic pipeline depends on it.
       Not part of the classified edition unless that build is made with -p:ClassifiedIncludeLocalAi=true (requires owner approval). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogAnalyzer.Ai</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Dfir.Core\LogAnalyzer.Dfir.Core.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Dfir.Windows\LogAnalyzer.Dfir.Windows.csproj" />
  </ItemGroup>
</Project>
