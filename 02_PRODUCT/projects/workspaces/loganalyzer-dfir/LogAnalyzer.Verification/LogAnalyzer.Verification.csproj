<Project Sdk="Microsoft.NET.Sdk">
  <!-- WP4 verification layer v1. Deliberately small and isolated: it references LogAnalyzer.Dfir.Core only (no WPF, no Windows, no network,
       no AI, no process start), reads the case's outputs from disk and never calls producer code (parsers, correlation, rules).
       Edition.Tests checks that it is present in both edition outputs and that it contains no network or process-start code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogAnalyzer.Verification</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\LogAnalyzer.Dfir.Core\LogAnalyzer.Dfir.Core.csproj" />
  </ItemGroup>
</Project>
