<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LogAnalyzer.KeyGen</AssemblyName>
    <RootNamespace>LogAnalyzer.KeyGen</RootNamespace>
    <DefineConstants>$(DefineConstants);LOGANALYZER_KEYGEN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- SignedCms for verify-report on officer-signed PDFs: the Microsoft WPF shared framework, no NuGet package (owner-approved 2026-10-16).
         The CMS verifier is the application's own source file, linked, so the command line and the app check signatures identically. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <Compile Include="..\LogAnalyzer.App\Services\OfficerCms.cs" Link="OfficerCms.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Key and Hardware ID come from the same LicenseService the editions use at activation. -->
    <ProjectReference Include="..\LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Dfir.Core\LogAnalyzer.Dfir.Core.csproj" />
  </ItemGroup>

</Project>
