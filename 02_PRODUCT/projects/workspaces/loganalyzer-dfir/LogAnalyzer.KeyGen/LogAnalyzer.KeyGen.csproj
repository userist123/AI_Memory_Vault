    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LogAnalyzer.KeyGen</AssemblyName>
    <RootNamespace>LogAnalyzer.KeyGen</RootNamespace>
