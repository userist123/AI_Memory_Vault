  <ItemGroup>
    <!-- Key and Hardware ID come from the same LicenseService the editions use at activation. -->
    <ProjectReference Include="..\LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
  </ItemGroup>

</Project>
