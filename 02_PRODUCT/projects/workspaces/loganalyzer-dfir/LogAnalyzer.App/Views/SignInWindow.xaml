<Window x:Class="LogAnalyzer.UI.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LogAnalyzer - autentificare" Height="560" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Border BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" Padding="28">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Text="Autentificare" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="IntroText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}"/>
                <Button x:Name="ExitButton" Content="Ieșire" Click="Exit_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,6"/>
            </StackPanel>

            <StackPanel>
                <!-- Card sign-in (default) -->
                <Border x:Name="CardPanel" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Card (smart card cu contacte, în slotul tastaturii) + PIN" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Introduceți cardul, apăsați butonul și introduceți PIN-ul în fereastra Windows / SafeNet. Aplicația nu vede, nu stochează și nu înregistrează PIN-ul."/>
                        <ListBox x:Name="CardList" Height="70" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="CardButton" Content="Autentificare cu card" Click="Card_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="Reîncarcă cardurile" Click="Refresh_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Password sign-in: primary administrator only -->
                <Border x:Name="PasswordPanel" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="PasswordTitle" Text="Administrator principal: cont + parolă (fără card)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PasswordHint" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Numai administratorul principal se poate autentifica cu parolă, oricând, chiar dacă are card înrolat. Celelalte conturi folosesc numai card și PIN."/>
                        <TextBlock x:Name="AccountLabel" Text="Cont" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="AccountBox" Margin="0,2,0,6"/>
                        <TextBlock x:Name="PersonLabel" Text="Nume și prenume" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="PersonBox" Margin="0,2,0,6"/>
                        <TextBlock x:Name="PasswordLabel" Text="Parolă" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,6"/>
                        <TextBlock x:Name="ConfirmLabel" Text="Confirmare parolă" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <PasswordBox x:Name="ConfirmBox" Margin="0,2,0,8"/>
                        <Button x:Name="PasswordButton" Content="Autentificare cu parolă" Click="Password_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
