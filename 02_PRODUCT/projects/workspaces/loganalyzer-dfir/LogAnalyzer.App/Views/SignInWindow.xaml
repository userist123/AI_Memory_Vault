<Window x:Class="LogAnalyzer.UI.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fit="clr-namespace:LogAnalyzer.UI.Views.Controls"
        Title="LogAnalyzer DFIR - autentificare" fit:WindowFit.ToWorkArea="True" Height="720" Width="1080" MinHeight="460" MinWidth="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Plan 2026-11-04 (R3): who and what the person signs in to, before anything else: product, module, station, level, version, licence, notice -->
        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="32,36">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="ProductText" Text="LogAnalyzer DFIR" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ModuleText" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock x:Name="ModulePurposeText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24,0,16"/>
                    <ItemsControl x:Name="IdentityList" AutomationProperties.Name="Identitatea stației">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" VerticalAlignment="Bottom" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Notificare de utilizare" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock x:Name="NoticeText" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Padding="40,36">
            <DockPanel MaxWidth="640" HorizontalAlignment="Left">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock x:Name="TitleText" Text="Autentificare" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="IntroText" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <!-- Security audit #4: the auth folder can be written by non-administrators -->
                    <Border x:Name="StorePanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="10" BorderThickness="1" BorderBrush="{StaticResource CriticalBrush}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock x:Name="StoreText" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}"/>
                            <CheckBox x:Name="StoreAck" Margin="0,8,0,0" Foreground="{StaticResource TextPrimaryBrush}"
                                      Content="Sunt administrator și continui conștient cu magazia de conturi neprotejată (se înregistrează în audit)"/>
                        </StackPanel>
                    </Border>
                    <!-- Independent review #5: the audit head was sealed but the record of it could not be written -->
                    <TextBlock x:Name="SealText" Visibility="Collapsed" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}"/>
                    <Button x:Name="ExitButton" Content="Ieșire" Click="Exit_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,6" Style="{StaticResource OutlineButtonStyle}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Card sign-in (default) -->
                    <Border x:Name="CardPanel" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Card + PIN" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,10" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Introduceți cardul (smart card cu contacte) în slotul tastaturii, apăsați butonul și introduceți PIN-ul în fereastra Windows / SafeNet. Aplicația nu vede, nu stochează și nu înregistrează PIN-ul."/>
                            <ListBox x:Name="CardList" MinHeight="56" MaxHeight="120" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Carduri detectate">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="CardButton" Content="Autentificare cu card" Click="Card_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                                <Button Content="Reîncarcă cardurile" Click="Refresh_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Password sign-in: primary administrator only -->
                    <Border x:Name="PasswordPanel" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="PasswordTitle" Text="Administrator principal: cont și parolă" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="PasswordHint" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,10" Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Numai administratorul principal se poate autentifica cu parolă, oricând, chiar dacă are card înrolat. Celelalte conturi folosesc numai card și PIN."/>
                            <TextBlock x:Name="AccountLabel" Text="Cont" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="AccountBox" Margin="0,2,0,8" AutomationProperties.Name="Cont"/>
                            <TextBlock x:Name="PersonLabel" Text="Nume și prenume" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="PersonBox" Margin="0,2,0,8" AutomationProperties.Name="Nume și prenume"/>
                            <TextBlock x:Name="PasswordLabel" Text="Parolă" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <PasswordBox x:Name="PasswordBox" Margin="0,2,0,8" AutomationProperties.Name="Parolă"/>
                            <TextBlock x:Name="ConfirmLabel" Text="Confirmare parolă" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <PasswordBox x:Name="ConfirmBox" Margin="0,2,0,10" AutomationProperties.Name="Confirmare parolă"/>
                            <Button x:Name="PasswordButton" Content="Autentificare cu parolă" Click="Password_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
