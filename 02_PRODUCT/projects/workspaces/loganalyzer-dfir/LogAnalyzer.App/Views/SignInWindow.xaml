<Window xmlns:loc="clr-namespace:LogAnalyzer.UI.Views" xmlns:svc="clr-namespace:LogAnalyzer.UI.Services" x:Class="LogAnalyzer.UI.Views.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{loc:T signin.loganalyzer_autentificare}" Height="560" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Border BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" Padding="28">
        <DockPanel>
            <ComboBox DockPanel.Dock="Top" HorizontalAlignment="Right" MinWidth="100" Margin="0,0,0,8"
                      ItemsSource="{x:Static svc:LanguageChoice.Options}" DisplayMemberPath="NativeName" SelectedValuePath="Language"
                      SelectedValue="{Binding Source={x:Static svc:LanguageChoice.Instance}, Path=Selected, Mode=TwoWay}"
                      ToolTip="{loc:T shell.language.tip}" AutomationProperties.Name="{loc:T shell.language}"/>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Text="{loc:T signin.autentificare}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="IntroText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}"/>
                <Button x:Name="ExitButton" Content="{loc:T signin.iesire}" Click="Exit_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="18,6"/>
            </StackPanel>

            <StackPanel>
                <!-- Card sign-in (default) -->
                <Border x:Name="CardPanel" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:T signin.card_smart_card_cu_contacte}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{loc:T signin.introduceti_cardul_apasati_butonul_si}"/>
                        <ListBox x:Name="CardList" Height="70" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="CardButton" Content="{loc:T signin.autentificare_cu_card}" Click="Card_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" Margin="0,0,8,0"/>
                            <Button Content="{loc:T signin.reincarca_cardurile}" Click="Refresh_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Password sign-in: primary administrator only -->
                <Border x:Name="PasswordPanel" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="PasswordTitle" Text="{loc:T signin.administrator_principal_cont_parola_fara}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PasswordHint" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,8" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{loc:T signin.numai_administratorul_principal_se_poate}"/>
                        <TextBlock x:Name="AccountLabel" Text="{loc:T signin.cont}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="AccountBox" Margin="0,2,0,6"/>
                        <TextBlock x:Name="PersonLabel" Text="{loc:T signin.nume_si_prenume}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="PersonBox" Margin="0,2,0,6"/>
                        <TextBlock x:Name="PasswordLabel" Text="{loc:T signin.parola}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,6"/>
                        <TextBlock x:Name="ConfirmLabel" Text="{loc:T signin.confirmare_parola}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <PasswordBox x:Name="ConfirmBox" Margin="0,2,0,8"/>
                        <Button x:Name="PasswordButton" Content="{loc:T signin.autentificare_cu_parola}" Click="Password_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
