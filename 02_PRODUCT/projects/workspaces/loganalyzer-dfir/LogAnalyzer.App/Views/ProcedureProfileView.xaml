<UserControl xmlns:loc="clr-namespace:LogAnalyzer.UI.Views" x:Class="LogAnalyzer.UI.Views.ProcedureProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:T proc.profil_de_proceduri}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:T proc.program_de_lucru_mentenanta_jurnalelor}"/>
            <TextBlock Text="{Binding AccessNotice}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:T reg.fisier}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding ProfilePath, Mode=OneWay}" IsReadOnly="True" Width="420" Margin="0,0,10,0"/>
                    <Button Content="{loc:T reg.salveaza}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{loc:T proc.salveaza_ca}" Command="{Binding SaveAsCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{loc:T reg.reincarca}" Command="{Binding ReloadCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{loc:T reg.deschide}" Command="{Binding OpenFileCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{loc:T reg.valideaza}" Command="{Binding ValidateCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,0"/>
                    <Button Content="{loc:T reg.importa_json}" Command="{Binding ImportJsonCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{loc:T proc.importa_csv_in_tabel}" Command="{Binding ImportCsvCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{loc:T reg.lipeste_in_tabel}" Command="{Binding PasteCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>
                    <CheckBox Content="{loc:T proc.inlocuieste_continutul_tabelului_la_import}" IsChecked="{Binding ReplaceOnImport}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable, Mode=TwoWay}" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource InspectorTabItemStyle}"/>
            </TabControl.ItemContainerStyle>
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <DockPanel Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Section}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                        <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="True" CanUserAddRows="True" CanUserDeleteRows="True"
                                  HeadersVisibility="Column" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader"/>
                    </DockPanel>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T proc.sectiuni}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding SectionLines}">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource ObsidianCardStyle}" MaxHeight="150">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:T reg.erori_si_avertismente_pe_linii}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding Issues}" Background="Transparent" BorderThickness="0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
