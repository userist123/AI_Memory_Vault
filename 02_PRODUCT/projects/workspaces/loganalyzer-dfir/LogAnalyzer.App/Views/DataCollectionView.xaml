<UserControl x:Class="LogAnalyzer.UI.Views.DataCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- design pass 2026-11-10: a long source name wraps instead of being cut at the card edge -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Colectare date"/>
                <TextBlock Style="{StaticResource PageLeadStyle}" Text="Triaj în timp real al stației țintă, furnizori ETW, telemetrie din memoria volatilă și împachetare cu lanț de custodie"/>
            </StackPanel>
            <!-- lab 2026-11-07: under the title and wrapping, so at 1024 px no button is cut off -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button AutomationProperties.Name="Sanitizare mediu și certificat PDF" Command="{Binding SanitizeMediaAndGenerateCertPdfCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="14,8" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE83D;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Sanitizare mediu și certificat PDF" VerticalAlignment="Center"/></StackPanel></Button>
                <Button AutomationProperties.Name="Rulează trierea pe loc" Command="{Binding StartCollectionCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,8" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Rulează trierea pe loc" VerticalAlignment="Center"/></StackPanel></Button>
                <Button AutomationProperties.Name="Sigilează pachetul cazului" Command="{Binding SealDfirCaseBundleCommand}" Padding="14,8"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Sigilează pachetul cazului" VerticalAlignment="Center"/></StackPanel></Button>
            </WrapPanel>
        </DockPanel>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <!-- Status Cards -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Ținta colectării" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding LiveRemoteTargetHost, FallbackValue='Nespecificată'}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Triaj fără agent (ETW / RPC)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Clasificare" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="Nesetată" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <TextBlock Text="Aplicația nu a primit o clasificare pentru acest caz" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 2-Pane Intake Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Triage Checklists & Artifact Sources -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ce se colectează" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <CheckBox Content="EVTX Security (ID-uri de eveniment 4624, 4625, 4672, 4688, 4720, 4732)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="EVTX System și Application (instalări de servicii 7045, erori)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Sysmon / Microsoft-Windows-Sysmon/Operational (Process Guid, rețea)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="PowerShell ScriptBlock Logging (EID 4104) și istoricul comenzilor" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Fișiere de registru offline (SYSTEM, SOFTWARE, SAM, NTUSER.DAT)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Conexiuni de rețea volatile (conexiuni TCP/UDP active și porturi în ascultare)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Cache-ul DNS și tabela de rutare" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Drivere de kernel încărcate și semnături de cod lipsă" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Conturi locale, grupuri și privilegii" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Protecția în timp real Windows Defender și căile excluse" IsChecked="True" Margin="0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" Margin="6,0"/>

            <!-- Right: Real-Time Acquisition Log -->
            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- design pass 2026-11-10: the standard is a second line, not a label docked over the wrapping title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Rezultatul colectării și sumele de control" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="Conform ISO/IEC 27037 (identificarea, colectarea și păstrarea probelor digitale)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Row="1" IsReadOnly="True" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource CodeTextBrush}" BorderBrush="{StaticResource BorderBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11.5" Padding="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding CollectionLogs, FallbackValue='Colectarea nu a fost pornită. Alegeți ce se colectează și rulați triajul.'}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>