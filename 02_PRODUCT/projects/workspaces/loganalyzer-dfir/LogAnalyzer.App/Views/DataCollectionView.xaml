<UserControl x:Class="LogAnalyzer.UI.Views.DataCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Colectare date" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Triaj în timp real al stației țintă, furnizori ETW, telemetrie din memoria volatilă și împachetare cu lanț de custodie" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- lab 2026-11-07: under the title and wrapping, so at 1024 px no button is cut off -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="🛡️ Sanitizare Mediu &amp; Certificat PDF" Command="{Binding SanitizeMediaAndGenerateCertPdfCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="⚡ Execută Live Triage" Command="{Binding StartCollectionCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,8" Margin="0,0,8,0"/>
                <Button Content="🔒 Sigilează Pachet Caz" Command="{Binding SealDfirCaseBundleCommand}" Padding="14,8"/>
            </WrapPanel>
        </DockPanel>

        <!-- Status Cards -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Ținta colectării" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding LiveRemoteTargetHost, FallbackValue='Nespecificată'}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Triaj fără agent (ETW / RPC)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Clasificare" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="NESETATĂ" Foreground="{StaticResource TextSecondaryBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Aplicația nu a primit o clasificare pentru acest caz" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 2-Pane Intake Workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Triage Checklists & Artifact Sources -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Ce se colectează" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <CheckBox Content="EVTX Security (ID-uri de eveniment 4624, 4625, 4672, 4688, 4720, 4732)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="EVTX System și Application (instalări de servicii 7045, erori)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Sysmon / Microsoft-Windows-Sysmon/Operational (Process Guid, rețea)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="PowerShell ScriptBlock Logging (EID 4104) și istoricul comenzilor" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Fișiere de registru offline (SYSTEM, SOFTWARE, SAM, NTUSER.DAT)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Conexiuni de rețea volatile (conexiuni TCP/UDP active și porturi în ascultare)" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Cache-ul DNS și tabela de rutare" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Drivere de kernel încărcate și semnături de cod lipsă" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Conturi locale, grupuri și privilegii" IsChecked="True" Margin="0,4"/>
                            <CheckBox Content="Protecția în timp real Windows Defender și căile excluse" IsChecked="True" Margin="0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" Margin="6,0"/>

            <!-- Right: Real-Time Acquisition Log -->
            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Rezultatul colectării și sumele de control" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="ISO/IEC 27037" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <TextBox Grid.Row="1" IsReadOnly="True" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource CodeTextBrush}" BorderBrush="{StaticResource BorderBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11.5" Padding="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Text="{Binding CollectionLogs, FallbackValue='Colectarea nu a fost pornită. Alegeți ce se colectează și rulați triajul.'}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>