<UserControl x:Class="LogAnalyzer.UI.Views.PolicyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmx="clr-namespace:LogAnalyzer.UI.ViewModels"
             xmlns:ctrl="clr-namespace:LogAnalyzer.UI.Views.Controls"
             xmlns:local="clr-namespace:LogAnalyzer.UI.Views"
             xmlns:services="clr-namespace:LogAnalyzer.UI.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <local:PolicySettingOneLineConverter x:Key="SettingOneLine"/>
        <!-- the operator and the two file/folder buttons: one definition, shown in the toolbar (Expert) or under "Avansat" (Simplu); each use gets its own copy -->
        <WrapPanel x:Key="PolicyOpenTools" x:Shared="False" VerticalAlignment="Center">
            <TextBlock Text="Operator:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Operator}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Deschide fișier…" Command="{Binding OpenFileCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
            <Button Content="Deschide folder GPO…" Command="{Binding OpenFolderCommand}" Style="{StaticResource OutlineButtonStyle}"/>
        </WrapPanel>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Politici" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Importați, aprobați și aplicați politici de securitate Windows, cu verificare după aplicare."/>
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Stări: CIORNĂ (DRAFT) → VALIDATĂ (VALIDATED) → TESTATĂ (TESTED) → APROBATĂ (APPROVED) → APLICATĂ (DEPLOYED) → VERIFICATĂ (VERIFIED). Aprobarea se face din alt cont Windows (fără auto-aprobare); aplicarea doar după confirmarea planului exact; fiecare modificare este re-citită și jurnalizată.">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpert, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <StackPanel Visibility="{Binding NothingOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ctrl:EmptyStateCard What="{x:Static vmx:EmptyStates.PolicyWhat}" Why="{x:Static vmx:EmptyStates.PolicyWhy}" Step="{x:Static vmx:EmptyStates.PolicyStep}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,8">
            <StackPanel>
                
                <ContentControl Content="{StaticResource PolicyOpenTools}" local:SimpleLevel.HideInSimple="True" IsTabStop="False"/>
                <TextBlock Text="{Binding PolicyInfo}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <Expander Header="Avansat" IsExpanded="False" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" AutomationProperties.Name="Avansat: depozitul de politici">
                    <StackPanel>
                    <ContentControl Content="{StaticResource PolicyOpenTools}" local:SimpleLevel.OnlyInSimple="True" IsTabStop="False" Margin="0,6,0,0"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Depozit politici:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Depozit politici" Text="{Binding StoreRoot, UpdateSourceTrigger=LostFocus}" Width="360"/>
                    </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
            <StackPanel>
            <!-- the next step, in words, with one button (owner 2026-10-11) -->
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="{Binding NextStep.Button}" Command="{Binding DoNextStepCommand}" Style="{StaticResource AccentButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding NextStep.CanAct, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Fă pasul următor"/>
                <TextBlock Text="{Binding NextStep.Text}" TextWrapping="Wrap" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <Expander Header="Toți pașii, manual (pentru cine cunoaște ciclul politicii)" local:SimpleLevel.HideInSimple="True" Foreground="{StaticResource TextSecondaryBrush}">
            <WrapPanel VerticalAlignment="Center" Margin="0,6,0,0">
                <Button Content="1. Înregistrează" Command="{Binding RegisterCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="2. Validează" Command="{Binding ValidateCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="3. Rulare de probă" Command="{Binding DryRunCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,0"/>
                <Button Content="4. Aprobă" Command="{Binding ApproveCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,0"/>
                <Button Content="Calculează planul" Command="{Binding ComputePlanCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Aplică planul…" Command="{Binding ApplyPlanCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Rollback ultima execuție…" Command="{Binding RollbackLastCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Folder probe" Command="{Binding OpenEvidenceFolderCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,0"/>
                <Button Content="Conformitate față de politică" Command="{Binding AssessAgainstPolicyCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Conformitate față de benchmark…" Command="{Binding AssessAgainstBenchmarkCommand}" Style="{StaticResource OutlineButtonStyle}"/>
            </WrapPanel>
            </Expander>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="Justificare aprobare:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding ApprovalReason, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Justificare aprobare"/>
            </DockPanel>
            </StackPanel>
        </Border>

        <TabControl x:Name="PolicyTabs" Grid.Row="3" ctrl:PageFill.MinHeight="360" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="Plan (curent / dorit / diferență)" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PlanSummary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <!-- owner 2026-10-12: „ce face fiecare politică în parte": list + explanation panel, as on Control stație -->
                    <Border DockPanel.Dock="Right" Width="420" Margin="8,0,0,0" Padding="12" Background="{StaticResource CanvasBrush}" CornerRadius="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Dați clic pe un rând ca să vedeți, pe înțeles, ce face setarea." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           Visibility="{Binding HasSelectedSetting, Converter={StaticResource InverseBoolToVis}}"/>
                                <StackPanel DataContext="{Binding SelectedSettingExplanation}" Visibility="{Binding DataContext.HasSelectedSetting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                            AutomationProperties.Name="Explicația setării alese">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBox Text="{Binding Setting, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" AutomationProperties.Name="Setarea tehnică"/>
                                    <TextBlock Text="Ce face" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding What}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="De ce contează pe o stație izolată" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Why}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Valoarea recomandată" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Recommended}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Required}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Ce înseamnă valoarea de acum" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding CurrentMeaning}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Unde se setează" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBox Text="{Binding Where, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.Name="Unde se setează"/>
                                    <TextBlock Text="Pentru IT" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBox Text="{Binding ForIt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.Name="Detalii pentru IT"/>
                                    <Button Content="Copiază explicația (pentru procesul-verbal)" Command="{Binding DataContext.CopyExplanationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" Style="{StaticResource OutlineButtonStyle}" AutomationProperties.Name="Copiază explicația"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <DataGrid ItemsSource="{Binding PlanRows}" SelectedItem="{Binding SelectedPlanRow}" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Setting, Converter={StaticResource SettingOneLine}}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="90"/>
                            <DataGridTextColumn Header="Titlu" Binding="{Binding Title}" Width="2*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Setare" Binding="{Binding Setting.Display}" Width="2*"/>
                            <DataGridTextColumn Header="Curent" Binding="{Binding Current.Display}" Width="1.3*"/>
                            <DataGridTextColumn Header="Dorit" Binding="{Binding Desired}" Width="1.3*"/>
                            <DataGridTextColumn Header="Stare" Binding="{Binding State}" Width="105"/>
                            <DataGridTextColumn Header="Acțiune" Binding="{Binding Action}" Width="75"/>
                            <DataGridTextColumn Header="Motiv / impact" Binding="{Binding Reason}" Width="3*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Rezultatul execuției" Style="{StaticResource InspectorTabItemStyle}">
                <DataGrid Margin="8" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Control" Binding="{Binding ControlId}" Width="90"/>
                        <DataGridTextColumn Header="Setare" Binding="{Binding Setting}" Width="3*"/>
                        <DataGridTextColumn Header="Rezultat" Binding="{Binding Outcome}" Width="110"/>
                        <DataGridTextColumn Header="Înainte" Binding="{Binding Before.Display}" Width="1.3*"/>
                        <DataGridTextColumn Header="Acțiune" Binding="{Binding Action}" Width="1.2*"/>
                        <DataGridTextColumn Header="După" Binding="{Binding After.Display}" Width="1.3*"/>
                        <DataGridTextColumn Header="Detalii" Binding="{Binding Detail}" Width="3*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Conformitate" local:SimpleLevel.HideInSimple="True" Style="{StaticResource InspectorTabItemStyle}">
                <DataGrid Margin="8" ItemsSource="{Binding Compliance}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Control benchmark" Binding="{Binding BenchmarkControl}" Width="130"/>
                        <DataGridTextColumn Header="Titlu" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="Rezultat" Binding="{Binding Result}" Width="110"/>
                        <DataGridTextColumn Header="Controale de politică" Binding="{Binding Observations.Count}" Width="80"/>
                        <DataGridTextColumn Header="Motiv" Binding="{Binding Reason}" Width="4*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Neacceptate la import" local:SimpleLevel.HideInSimple="True" Style="{StaticResource InspectorTabItemStyle}">
                <ListBox Margin="8" ItemsSource="{Binding Unsupported}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"/>
            </TabItem>
            <TabItem Header="Istoric ciclu de viață" local:SimpleLevel.HideInSimple="True" Style="{StaticResource InspectorTabItemStyle}">
                <DataGrid Margin="8" ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ora (UTC)" Binding="{Binding AtUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140"/>
                        <DataGridTextColumn Header="Din" Binding="{Binding From}" Width="90"/>
                        <DataGridTextColumn Header="În" Binding="{Binding To}" Width="90"/>
                        <DataGridTextColumn Header="Cine" Binding="{Binding Operator}" Width="1.5*"/>
                        <DataGridTextColumn Header="Motiv" Binding="{Binding Reason}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <ProgressBar DockPanel.Dock="Left" Width="120" Height="6" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
