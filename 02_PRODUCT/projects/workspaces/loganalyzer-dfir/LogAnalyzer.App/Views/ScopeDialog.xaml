<Window x:Class="LogAnalyzer.UI.Views.ScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scopul cazului LIVE" Width="640" SizeToContent="Height" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface1Brush}">
    <StackPanel Margin="20">
        <TextBlock Text="Scopul cazului stației" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Înainte de prima utilizare a funcțiilor LIVE, completați scopul: de ce, pentru ce perioadă, pe ce sisteme, cine aprobă. Până la confirmare, rapoartele și exporturile poartă mențiunea „scop provizoriu, neconfirmat”."/>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Scop:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PurposeBox" Margin="0,4"/>
            <TextBlock Grid.Row="1" Text="Aprobator:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ApproverBox" Margin="0,4"/>
            <TextBlock Grid.Row="2" Text="Sisteme în scop:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="SystemsBox" Margin="0,4" ToolTip="Separate prin virgulă sau punct și virgulă"/>
            <TextBlock Grid.Row="3" Text="Perioada de la:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <DatePicker Grid.Row="3" Grid.Column="1" x:Name="FromPicker" Margin="0,4" HorizontalAlignment="Left" Width="160"/>
            <TextBlock Grid.Row="4" Text="până la:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <DatePicker Grid.Row="4" Grid.Column="1" x:Name="ToPicker" Margin="0,4" HorizontalAlignment="Left" Width="160"/>
            <TextBlock Grid.Row="5" Text="Temei:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="LegalBox" Margin="0,4" HorizontalAlignment="Left" Width="160"/>
            <TextBlock Grid.Row="6" Text="Categoria sistemului:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="NetworkBox" Margin="0,4" HorizontalAlignment="Left" Width="200"/>
            <TextBlock Grid.Row="7" Text="Clasificare:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="ClassBox" Margin="0,4" HorizontalAlignment="Left" Width="200"/>
            <TextBlock Grid.Row="8" Text="Observații:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="NotesBox" Margin="0,4"/>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="#fca5a5" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Confirmă scopul" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0" Click="Confirm_Click" IsDefault="True"/>
            <Button Content="Mai târziu" Style="{StaticResource OutlineButtonStyle}" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
