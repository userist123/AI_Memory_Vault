<UserControl x:Class="LogAnalyzer.UI.Views.ChainOfCustodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 2026-11-05: the page shows the custody chain of the open case (Logs/chain_of_custody.jsonl, read with its chain verdict);
         the in-memory analysis ledger of this session stays below, labelled as not part of the case. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Istoricul probelor"/>
                <TextBlock Style="{StaticResource PageLeadStyle}" Text="Lanțul de custodie al cazului deschis: cine a avut fiecare probă, când și ce s-a făcut cu ea"/>
            </StackPanel>
            <!-- lab 2026-11-07: under the title and wrapping, so at 1024 px no button is cut off -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Reîncarcă" Command="{Binding Investigation.RefreshCustodyCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8" Margin="0,0,8,0"
                        AutomationProperties.Name="Reîncarcă lanțul de custodie al cazului"/>
                <Button Content="Deschide dosarul cazului" Command="{Binding Investigation.OpenCaseCommand}" Padding="16,8"/>
            </WrapPanel>
        </DockPanel>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <!-- Case custody chain -->
        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Investigation.CustodyLine}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"
                           AutomationProperties.Name="Starea lanțului de custodie">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource EvidenceAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Investigation.CustodyProblem}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DataGrid Grid.Row="1" AutomationProperties.Name="Lanțul de custodie al cazului" ItemsSource="{Binding Investigation.CustodyRows}"
                          AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SeqText}" Width="55"/>
                        <DataGridTextColumn Header="Ora (locală)" Binding="{Binding LocalText}" Width="140"/>
                        <DataGridTextColumn Header="Cine" Binding="{Binding Who}" Width="140"/>
                        <DataGridTextColumn Header="Ce s-a făcut" Binding="{Binding ActionText}" Width="160"/>
                        <DataGridTextColumn Header="Proba" Binding="{Binding EvidenceId}" Width="110"/>
                        <DataGridTextColumn Header="De unde → unde" Binding="{Binding FromTo}" Width="220"/>
                        <DataGridTextColumn Header="Amprentă SHA-256" Binding="{Binding ShaShort}" FontFamily="{StaticResource CodeFontFamily}" Width="110"/>
                        <DataGridTextColumn Header="Instrument" Binding="{Binding Tool}" Width="140"/>
                        <DataGridTextColumn Header="Detalii" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Sha256, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Margin="8,2"
                                     FontFamily="{StaticResource CodeFontFamily}" AutomationProperties.Name="Amprenta SHA-256 completă"/>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Session analysis ledger (in memory, not part of the case) -->
        <Expander Grid.Row="2" Margin="0,12,0,0" Header="Jurnalul analizei din această sesiune (în memorie; nu face parte din caz și nu se păstrează la închidere)">
            <DataGrid ItemsSource="{Binding ProvenanceEntries}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" MaxHeight="220"
                      AutomationProperties.Name="Jurnalul analizei din această sesiune">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="45"/>
                    <DataGridTextColumn Header="Marcaj de timp (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
                    <DataGridTextColumn Header="Acțiune / etapă" Binding="{Binding ActionType}" Width="150"/>
                    <DataGridTextColumn Header="Fișier / referință" Binding="{Binding EvidenceReference}" Width="200"/>
                    <DataGridTextColumn Header="Sumă de control SHA-256" Binding="{Binding SourceSha256}" FontFamily="{StaticResource CodeFontFamily}" Width="240"/>
                    <DataGridTextColumn Header="Detalii" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Expander>
    </Grid>
</UserControl>
