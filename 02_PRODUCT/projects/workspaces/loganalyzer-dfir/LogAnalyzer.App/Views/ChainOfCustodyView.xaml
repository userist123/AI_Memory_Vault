<UserControl x:Class="LogAnalyzer.UI.Views.ChainOfCustodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Istoricul probelor" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Registrul probelor, integritate prin SHA-256 și raportarea incidentelor NIS2 / DNSC" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Exportă pachetul de probe" Command="{Binding ExportCsvCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8"/>
        </DockPanel>

        <!-- Main Evidence Ledger DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="Registrul de preluare a probelor" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource EvidenceAccentBrush}"/>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ProvenanceEntries}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding SequenceNumber}" Width="45"/>
                        <DataGridTextColumn Header="Marcaj de timp (UTC)" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
                        <DataGridTextColumn Header="Acțiune / etapă" Binding="{Binding ActionType}" Width="150"/>
                        <DataGridTextColumn Header="Fișier probă / referință" Binding="{Binding EvidenceReference}" Width="200"/>
                        <DataGridTextColumn Header="Sumă de control SHA-256" Binding="{Binding SourceSha256}" FontFamily="{StaticResource CodeFontFamily}" Width="240"/>
                        <DataGridTextColumn Header="Detalii de audit" Binding="{Binding Details}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>