<UserControl x:Class="LogAnalyzer.UI.Views.Controls.EmptyStateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Rows 16-17 of the 2026-10-22 beginner walkthrough: an empty page says what it is, why it matters for the control and the first step, with the button for it (Action). -->
    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
        <StackPanel>
            <TextBlock Text="Ce este" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding What, ElementName=Root}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"/>
            <TextBlock Text="De ce contează pentru control" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Why, ElementName=Root}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"/>
            <TextBlock Text="{Binding Step, ElementName=Root}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
            <ContentPresenter Content="{Binding Action, ElementName=Root}" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>
