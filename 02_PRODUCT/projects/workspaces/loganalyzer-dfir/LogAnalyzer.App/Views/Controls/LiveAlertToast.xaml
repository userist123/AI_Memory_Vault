<UserControl x:Class="LogAnalyzer.UI.Views.Controls.LiveAlertToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsLiveToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,44">
    <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1.5" CornerRadius="8" Width="380" Padding="14" Effect="{StaticResource ModalShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Row: Badge & Dismiss -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Border Background="#2D1217" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="{Binding CurrentLiveToastAlert.Severity, FallbackValue='CRITICAL'}" Foreground="{StaticResource CriticalBrush}" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding CurrentLiveToastAlert.MitreTechniqueId, FallbackValue='T1055'}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissLiveToastCommand}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" FontWeight="Bold" Width="20" Height="20" Cursor="Hand"/>
            </DockPanel>

            <!-- Content Row -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock Text="{Binding CurrentLiveToastAlert.Title, FallbackValue='Live EDR Threat Detected'}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding CurrentLiveToastAlert.Explanation, FallbackValue='Process injection and C2 beaconing activity identified.'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Action Row -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Inspect Playbook" Command="{Binding OpenAlertModalCommand}" CommandParameter="{Binding CurrentLiveToastAlert}" Style="{StaticResource DangerButtonStyle}" Padding="12,4" FontSize="11"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>