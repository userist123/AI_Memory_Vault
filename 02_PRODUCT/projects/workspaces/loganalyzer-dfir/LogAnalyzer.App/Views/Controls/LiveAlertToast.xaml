<UserControl x:Class="LogAnalyzer.UI.Views.Controls.LiveAlertToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LogAnalyzer.UI.Views"
             Visibility="{Binding IsLiveToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,44">
    <!--
        Design step 9 (2026-11-10): a white record card with a severity rail on the left, instead of a beige box with a red outline (every alert looked
        critical, a Low one included). Narrower (340 px) and capped in height, so it covers less of the page; the long explanation stays in
        „Vezi procedura”. The severity is written in Romanian (it showed "Low" / "Medium").
    -->
    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Width="340"
            Effect="{StaticResource ModalShadow}" AutomationProperties.Name="Alertă în timp real">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="6,0,0,6" Background="{Binding CurrentLiveToastAlert.Severity, Converter={x:Static views:SeverityBrushConverter.Instance}}"/>
            <Grid Grid.Column="1" Margin="12,10,10,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- severity in words, technique code, close -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding CurrentLiveToastAlert.Severity, Converter={x:Static views:SeverityBrushConverter.Instance}}"
                               Text="{Binding CurrentLiveToastAlert.Severity, Converter={x:Static views:SeverityTextConverter.Instance}, FallbackValue=''}"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentLiveToastAlert.MitreTechniqueId, FallbackValue=''}" FontSize="11.5" FontFamily="{StaticResource CodeFontFamily}"
                               Foreground="{StaticResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Button AutomationProperties.Name="Închide" ToolTip="Închide" DockPanel.Dock="Right" Command="{Binding DismissLiveToastCommand}"
                            Style="{StaticResource ActionButtonStyle}" Padding="6,4" MinWidth="0" MinHeight="0">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="10"/>
                    </Button>
                </DockPanel>

                <!-- what happened, in plain words; the detail is capped and complete in the tooltip -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="{Binding CurrentLiveToastAlert.Plain, FallbackValue=''}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}" MaxHeight="88" TextTrimming="WordEllipsis"
                               ToolTip="{Binding CurrentLiveToastAlert.Plain}"/>
                    <TextBlock Text="{Binding CurrentLiveToastAlert.Explanation, FallbackValue=''}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Margin="0,4,0,0" MaxHeight="64" TextTrimming="WordEllipsis" ToolTip="{Binding CurrentLiveToastAlert.Explanation}"/>
                </StackPanel>

                <Button Grid.Row="2" HorizontalAlignment="Left" Content="Vezi procedura" Command="{Binding OpenAlertModalCommand}" CommandParameter="{Binding CurrentLiveToastAlert}"
                        Padding="12,4"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
