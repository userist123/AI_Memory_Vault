<UserControl x:Class="LogAnalyzer.UI.Views.Controls.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Backdrop" Background="{StaticResource ModalBackdropBrush}" Visibility="{Binding IsCommandPaletteVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" CornerRadius="10" Width="600" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,100,0,0" Effect="{StaticResource ModalShadow}">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="Salt rapid la o pagină (Ctrl+K)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseCommandPaletteCommand}" AutomationProperties.Name="Închide saltul rapid" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" FontWeight="Bold" Width="24" Height="24" Cursor="Hand"><TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFontFamily}" FontSize="12"/></Button>
                </DockPanel>

                <!-- its own text (not the event search); Enter opens the first page, Esc closes -->
                <TextBox x:Name="PaletteSearchInput" Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" Margin="0,0,0,12"
                         AutomationProperties.Name="Caută o pagină" ToolTip="Scrieți o parte din numele paginii; Enter deschide prima potrivire.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding PaletteOpenFirstCommand}"/>
                        <KeyBinding Key="Escape" Command="{Binding CloseCommandPaletteCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <TextBlock Text="Pagini:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding PaletteMatches}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                                    Command="{Binding DataContext.PaletteOpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Tab}"
                                    Style="{StaticResource ActionButtonStyle}" HorizontalContentAlignment="Left" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nicio pagină cu acest nume în această ediție." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PaletteMatches.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
