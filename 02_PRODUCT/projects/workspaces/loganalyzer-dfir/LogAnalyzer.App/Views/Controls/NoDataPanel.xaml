<UserControl x:Class="LogAnalyzer.UI.Views.Controls.NoDataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:LogAnalyzer.UI.Services"
             x:Name="Root">
    <!-- G3: shown on every page that has nothing to show yet; the button runs the same „Colectează tot” as the top bar.
         Visible only while there is no analysis result (IsEmpty) and the page holds nothing of its own (HasPageData). -->
    <Border DataContext="{x:Static services:CollectAllState.Instance}"
            Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsEmpty}" Value="True"/>
                            <Condition Binding="{Binding HasPageData, ElementName=Root}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Colectează acum" Command="{x:Static services:CollectAllState.Command}" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Colectează acum (colectare și analiză completă pentru rolul stației)" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="{x:Static services:CollectAllState.EmptyTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,12,0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
