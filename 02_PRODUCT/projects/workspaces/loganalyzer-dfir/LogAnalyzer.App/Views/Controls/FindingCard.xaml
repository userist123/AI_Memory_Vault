<UserControl x:Class="LogAnalyzer.UI.Views.Controls.FindingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:LogAnalyzer.UI.Views.Controls"
             xmlns:views="clr-namespace:LogAnalyzer.UI.Views"
             AutomationProperties.Name="Fișa constatării selectate">
    <!-- WP6a / U4. DataContext: LogAnalyzer.UI.ViewModels.FindingCardViewModel. Severity, state and verification are TEXT (plus an icon shape for severity), never colour alone. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Border Style="{StaticResource ObsidianCardStyle}">
        <StackPanel>
            <DockPanel>
                <ctrl:SeverityBadge DockPanel.Dock="Right" Severity="{Binding Card.SeveritySpec}" VerticalAlignment="Top" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding Card.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
            </DockPanel>
            <TextBlock Text="{Binding Card.HumanSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>

            <WrapPanel Margin="0,8,0,0">
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0">
                    <Run Text="Severitate:" FontWeight="SemiBold"/> <Run Text="{Binding Card.SeverityIcon, Mode=OneWay}"/> <Run Text="{Binding Card.SeverityText, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" ToolTip="{Binding Card.StateMeaning}">
                    <Run Text="Stare:" FontWeight="SemiBold"/> <Run Text="{Binding Card.StateLabel, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextPrimaryBrush}" ToolTip="{Binding Card.VerificationText}">
                    <Run Text="Verificare:" FontWeight="SemiBold"/> <Run Text="{Binding Card.VerificationLabel, Mode=OneWay}"/>
                </TextBlock>
            </WrapPanel>

            <WrapPanel Margin="0,10,0,0">
                <Button Content="_De ce?" AutomationProperties.Name="De ce?" AutomationProperties.HelpText="Arată observația, dovezile, raționamentul, limitele și verificarea acestei constatări." Command="{Binding ShowWhyCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,4"/>
                <Button Content="_Arată dovezile" AutomationProperties.Name="Arată dovezile" AutomationProperties.HelpText="Arată dovezile constatării: rezumat, listă și detalii tehnice (SHA-256, parser, locator)." Command="{Binding ShowEvidenceCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,4"/>
                <Button Content="_Verifică" AutomationProperties.Name="Verifică" AutomationProperties.HelpText="Arată verdictul verificării automate pentru această constatare și controalele pe care se sprijină." Command="{Binding ShowVerifyCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,4"/>
                <Button Content="_Ce trebuie să fac" AutomationProperties.Name="Ce trebuie să fac" AutomationProperties.HelpText="Arată pașii recomandați pentru această constatare." Command="{Binding ShowTodoCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,4"/>
            </WrapPanel>

            <!-- De ce? (U5) -->
            <StackPanel Visibility="{Binding IsWhyOpen, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock Text="De ce?" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBox Text="{Binding WhyText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                         Padding="8" AutomationProperties.Name="Explicația constatării: ce am observat, dovezi, raționament, limite, verificare"/>
            </StackPanel>

            <!-- Dovezile, în trei niveluri (U6) -->
            <StackPanel Visibility="{Binding IsEvidenceOpen, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock Text="{Binding Card.Evidence.Summary}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                <DataGrid ItemsSource="{Binding Card.Evidence.List}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220" Margin="0,6,0,0"
                          AutomationProperties.Name="Lista dovezilor: sursă, oră, descriere">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sursă" Binding="{Binding Source}" Width="*"/>
                        <DataGridTextColumn Header="Ora" Binding="{Binding TimeText}" Width="*"/>
                        <DataGridTextColumn Header="Descriere" Binding="{Binding Description}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Expander Header="Detalii tehnice (id probă, SHA-256, cale, parser, locator)" AutomationProperties.Name="Detalii tehnice ale dovezilor" Margin="0,6,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                    <StackPanel>
                        <TextBlock Text="{views:Term provenance}" ToolTip="{views:Term provenance, Tooltip=True}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                        <DataGrid ItemsSource="{Binding Card.Evidence.Technical}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="260"
                                  AutomationProperties.Name="Detalii tehnice ale dovezilor">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id probă" Binding="{Binding EvidenceId}" Width="90"/>
                                <DataGridTextColumn Header="SHA-256" Binding="{Binding Sha256}" Width="2*"/>
                                <DataGridTextColumn Header="Cale sursă" Binding="{Binding SourcePath}" Width="2*"/>
                                <DataGridTextColumn Header="Parser" Binding="{Binding Parser}" Width="*"/>
                                <DataGridTextColumn Header="Versiune" Binding="{Binding ParserVersion}" Width="80"/>
                                <DataGridTextColumn Header="Marcaj de timp" Binding="{Binding Timestamp}" Width="*"/>
                                <DataGridTextColumn Header="Locator" Binding="{Binding Locator}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- Verifică -->
            <StackPanel Visibility="{Binding IsVerifyOpen, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock Text="{views:Term verification}" ToolTip="{views:Term verification, Tooltip=True}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Card.VerificationLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Card.VerificationText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ItemsControl ItemsSource="{Binding Card.Why.VerificationChecks}" AutomationProperties.Name="Controalele verificării" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Ce trebuie să fac -->
            <StackPanel Visibility="{Binding IsTodoOpen, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                <TextBlock Text="Ce trebuie să fac" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                <ItemsControl ItemsSource="{Binding Card.NextSteps}" AutomationProperties.Name="Pașii recomandați">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <ctrl:KnowThinkDontKnowPanel DataContext="{Binding Card.Know}"/>
        </StackPanel>
    </Border>
</UserControl>
