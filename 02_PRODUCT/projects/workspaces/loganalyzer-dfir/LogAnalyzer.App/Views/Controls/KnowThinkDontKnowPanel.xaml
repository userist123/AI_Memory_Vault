<UserControl x:Class="LogAnalyzer.UI.Views.Controls.KnowThinkDontKnowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Ce știm, ce suspectăm și ce nu putem demonstra">
    <!-- WP6a / U8. DataContext: LogAnalyzer.Dfir.Presentation.KnowThinkDontKnow. Each column has a text heading AND a symbol (✓ ⚠ ?), so no column is told apart by colour alone. -->
    <UserControl.Resources>
        <DataTemplate x:Key="StatementTemplate">
            <StackPanel Margin="0,0,0,6">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                    <Run Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="{Binding Text, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Basis}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="18,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <UniformGrid Columns="3" Margin="0,8,0,0">
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="CE ȘTIM" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Know}" ItemTemplate="{StaticResource StatementTemplate}" Tag="✓" AutomationProperties.Name="Ce știm"/>
        </StackPanel>
        <StackPanel Margin="0,0,8,0">
            <TextBlock Text="CE SUSPECTĂM" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding Think}" ItemTemplate="{StaticResource StatementTemplate}" Tag="⚠" AutomationProperties.Name="Ce suspectăm"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="CE NU PUTEM DEMONSTRA" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <ItemsControl ItemsSource="{Binding DontKnow}" ItemTemplate="{StaticResource StatementTemplate}" Tag="?" AutomationProperties.Name="Ce nu putem demonstra"/>
        </StackPanel>
    </UniformGrid>
</UserControl>
