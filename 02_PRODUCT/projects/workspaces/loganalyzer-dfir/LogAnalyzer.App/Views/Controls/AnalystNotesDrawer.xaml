<UserControl x:Class="LogAnalyzer.UI.Views.Controls.AnalystNotesDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsAnalystDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
             HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="380">
    <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18" Effect="{StaticResource ModalShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="ANALYST CASE SCRATCHPAD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="Forensic hypothesis &amp; investigation log" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseAnalystDrawerCommand}" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" FontWeight="Bold" Width="24" Height="24" Cursor="Hand"/>
            </DockPanel>

            <!-- Case Status Selector -->
            <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="INCIDENT TRIAGE STATUS:" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding AnalystCaseStatus}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource HighBrush}"/>
                </StackPanel>
            </Border>

            <!-- Notes Editor -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="INVESTIGATION NOTES (ISO/IEC 27042):" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox Grid.Row="1" Text="{Binding AnalystCaseNotes, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11.5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource CodeTextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10"/>
            </Grid>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3">
                <Button Content="Append to PDF Case Report" Command="{Binding ExportPdfReportCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,2"/>
                <Button Content="Close Drawer" Command="{Binding CloseAnalystDrawerCommand}" Margin="0,2"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>