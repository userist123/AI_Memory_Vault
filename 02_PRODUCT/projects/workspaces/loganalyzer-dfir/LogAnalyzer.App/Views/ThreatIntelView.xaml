<UserControl x:Class="LogAnalyzer.UI.Views.ThreatIntelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Informații despre amenințări" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Suprapunerea tehnicilor observate cu profile publice de actori. NU este atribuire: aceleași tehnici sunt folosite de mulți actori, iar atribuirea cere dovezi separate (infrastructură, malware, context)." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <!-- lab 2026-11-07: under the title and wrapping, so at 1024 px no button is cut off -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Exportă STIX 2.1" Command="{Binding ExportStixJsonCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Exportă MISP JSON" Command="{Binding ExportMispJsonCommand}" Style="{StaticResource ActionButtonStyle}"/>
            </WrapPanel>
        </DockPanel>

        <!-- Main 2-Pane Split: Left APT Profiles, Right Extracted IOC Knowledge Base -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: technique overlap with known actor profiles (not attribution) -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Profile de actori cu tehnici comune (nu este atribuire)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding AptAttributionProfiles.Count, StringFormat='{}{0} profile'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AptAttributionProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding ActorName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                <Border DockPanel.Dock="Right" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Origin}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource HighBrush}"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding TargetSectors, StringFormat='Ținte: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding KnownTools, StringFormat='Instrumente: {0}'}" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6"/>
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Aliases, StringFormat='Alte nume: {0}'}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock DockPanel.Dock="Right" ToolTip="{Binding MatchLevel}" Text="{Binding MatchScore, StringFormat='Suprapunere tehnici: {0:F0}% (nu este atribuire)'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" Margin="6,0"/>

            <!-- Right: Extracted IOCs & Pivoting -->
            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                        <TextBlock DockPanel.Dock="Left" Text="Indicatori de compromitere (IOC) extrași" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentIocs.Count, StringFormat='{}{0} IOCs'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentIocs}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
                                <MenuItem Header="Copiază valoarea IOC" Command="{Binding CopyIocValueCommand}" CommandParameter="{Binding SelectedItem.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <MenuItem Header="Caută în explorator de evenimente" Command="{Binding PivotIocCommand}" CommandParameter="{Binding SelectedItem.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="90"/>
                            <DataGridTextColumn Header="Valoare indicator (IP / hash / domeniu)" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>