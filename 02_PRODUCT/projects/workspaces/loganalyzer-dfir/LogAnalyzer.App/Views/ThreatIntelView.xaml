<UserControl x:Class="LogAnalyzer.UI.Views.ThreatIntelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Informații despre amenințări"/>
                <TextBlock Style="{StaticResource PageLeadStyle}" Text="Suprapunerea tehnicilor observate cu profile publice de actori. NU este atribuire: aceleași tehnici sunt folosite de mulți actori, iar atribuirea cere dovezi separate (infrastructură, malware, context)."/>
            </StackPanel>
            <!-- lab 2026-11-07: under the title and wrapping, so at 1024 px no button is cut off -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Exportă STIX 2.1" Command="{Binding ExportStixJsonCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Exportă MISP JSON" Command="{Binding ExportMispJsonCommand}" Style="{StaticResource ActionButtonStyle}"/>
            </WrapPanel>
        </DockPanel>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <!-- Main 2-Pane Split: Left APT Profiles, Right Extracted IOC Knowledge Base -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: technique overlap with known actor profiles (not attribution) -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Profile de actori cu tehnici comune (nu este atribuire)" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding AptAttributionProfiles.Count, StringFormat='{}{0} profile'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AptAttributionProfiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                        <!-- 2026-11-11: no DockPanel (its left and right children collided at 1024 px: "UNC2452Suprapunere", badge cut off). Text column wraps; the
                                             overlap figure has its own Auto column, so nothing is drawn over a title. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding ActorName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                <Border HorizontalAlignment="Left" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Origin}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource HighBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Aliases, StringFormat='Alte nume: {0}'}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding TargetSectors, StringFormat='Ținte: {0}'}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding KnownTools, StringFormat='Instrumente: {0}'}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                                                <TextBlock Text="Suprapunerea nu este atribuire." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0" ToolTip="{Binding MatchLevel}">
                                                <TextBlock Text="{Binding MatchScore, StringFormat='{}{0:F0}%'}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource CyanAccentBrush}"/>
                                                <TextBlock Text="suprapunere tehnici" FontSize="11" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" Margin="6,0"/>

            <!-- Right: Extracted IOCs & Pivoting -->
            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Indicatori de compromitere (IOC) extrași" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryAccentBrush}"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding CurrentIocs.Count, StringFormat='{}{0} IOC-uri'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentIocs}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
                                <MenuItem Header="Copiază valoarea IOC" Command="{Binding CopyIocValueCommand}" CommandParameter="{Binding SelectedItem.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <MenuItem Header="Caută în explorator de evenimente" Command="{Binding PivotIocCommand}" CommandParameter="{Binding SelectedItem.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tip" Binding="{Binding Type}" Width="90" MinWidth="90"/>
                            <DataGridTextColumn Header="Valoare indicator (IP / hash / domeniu)" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>