<UserControl x:Class="LogAnalyzer.UI.Views.AttackStorylineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
        <DockPanel LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Exportă raportul de incident (PDF)" Command="{Binding ExportPdfReportCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Firul atacului"/>
                <Border Margin="14,0,0,0" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentStoryline}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StorylineNodes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding CurrentStoryline.RiskLevel, StringFormat='Gravitate: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                </Border>
            </StackPanel>
        </DockPanel>
            <TextBlock Style="{StaticResource PageLeadStyle}" Text="Etapele atacului reconstituite din constatări, în ordinea în care s-au petrecut."/>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <!-- Summary (the former fixed stage rail was removed: it showed sample techniques not computed from data) -->
        <Border Grid.Row="1" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding CurrentStoryline.IncidentTitle, FallbackValue='Nicio poveste de atac construită'}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="Corelare automată, nevalidată" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding CurrentStoryline.OverallSummary, FallbackValue='Nu există încă un rezumat: rulați analiza pentru a construi povestea atacului.'}" FontSize="12" LineHeight="18" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
        </Border>

        <!-- Kill Chain Stages List -->
        <Border Grid.Row="2" Style="{StaticResource ObsidianCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Text="Etapele atacului identificate, în ordine cronologică" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="Apăsați pe un rând pentru a vedea evenimentele brute" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding StorylineNodes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{Binding SeverityColor, FallbackValue={StaticResource BorderBrush}}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Padding="14" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.PivotStorylineStageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                <TextBlock Text="{Binding TechniqueId}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource CodeFontFamily}" Foreground="{StaticResource CyanAccentBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>