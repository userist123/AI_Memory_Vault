<Window x:Class="LogAnalyzer.UI.Views.GenericDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalii" Height="760" Width="1000" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Surface1Brush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Kind}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TimeText}" FontSize="11.5" FontFamily="{StaticResource CodeFontFamily}" Foreground="{StaticResource CyanAccentBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="14,12" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="Toate câmpurile" Style="{StaticResource InspectorTabItemStyle}">
                <DataGrid x:Name="FieldsGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          CanUserSortColumns="True" SelectionUnit="FullRow" ClipboardCopyMode="IncludeHeader">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Secțiune" Binding="{Binding Section}" Width="130"/>
                        <DataGridTextColumn Header="Câmp" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="Valoare" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Ce înseamnă" Style="{StaticResource InspectorTabItemStyle}">
                <TextBox x:Name="MeaningBox" Margin="8" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="12" FontSize="12.5"/>
            </TabItem>

            <TabItem x:Name="RelatedTab" Header="Corelate" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="Elemente din sesiune legate de acesta (aceeași sesiune de logon, același proces, IP sau cont, în ±10 minute). Dublu-click deschide fișa lor."/>
                    <DataGrid x:Name="RelatedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MouseDoubleClick="Related_DoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ora" Binding="{Binding TimeUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="Tip" Binding="{Binding Kind}" Width="90"/>
                            <DataGridTextColumn Header="Legătură" Binding="{Binding Link}" Width="200"/>
                            <DataGridTextColumn Header="Rezumat" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="XML / brut" Style="{StaticResource InspectorTabItemStyle}">
                <TextBox x:Name="RawBox" Margin="8" VerticalContentAlignment="Top" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource CanvasBrush}" Foreground="{StaticResource CodeTextBrush}" BorderThickness="0"
                         FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Padding="12"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Închide" Click="Close_Click" Style="{StaticResource AccentButtonStyle}" IsCancel="True"/>
                <Button x:Name="EscalateButton" DockPanel.Dock="Right" Content="Escaladează ca alertă" Click="Escalate_Click" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="Export PDF" Click="ExportPdf_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" Content="Copiază tot" Click="Copy_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
