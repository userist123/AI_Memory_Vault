<Window x:Class="LogAnalyzer.UI.Views.FirstRunGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fit="clr-namespace:LogAnalyzer.UI.Views.Controls"
        Title="Ghid de început" fit:WindowFit.ToWorkArea="True" Width="620" Height="440" MinWidth="460" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WorkspaceBrush}" FontSize="14">
    <!-- 2026-10-22: three screens, once after the first sign-in; modeless (never blocks the window behind) and Esc closes it -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Nu mai arăta" Command="{Binding DontShowAgainCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="12,0,0,0"
                    AutomationProperties.Name="Nu mai arăta ghidul la pornire" ToolTip="Închide ghidul. Nu se mai deschide singur; îl puteți deschide din „Ce înseamnă?” sau de pe Acasă."/>
            <Button DockPanel.Dock="Left" Content="Înapoi" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,0"/>
            <Button DockPanel.Dock="Left" Content="{Binding NextText}" Command="{Binding NextCommand}" Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    AutomationProperties.Name="Înainte sau Am înțeles"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Progress}" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,12"/>
        <ItemsControl ItemsSource="{Binding Lines}" AutomationProperties.Name="Textul ghidului">
            <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/></DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
