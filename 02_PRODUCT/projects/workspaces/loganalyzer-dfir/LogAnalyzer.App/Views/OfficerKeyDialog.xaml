<Window x:Class="LogAnalyzer.UI.Views.OfficerKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fit="clr-namespace:LogAnalyzer.UI.Views.Controls"
        Title="Cheia ofițerului de securitate" fit:WindowFit.ToWorkArea="True" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface1Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>
        <StackPanel x:Name="NamePanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="Numele ofițerului de securitate:" Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBox x:Name="NameBox" AutomationProperties.Name="Numele ofițerului de securitate" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Text="Parola cheii (nu se afișează și nu se păstrează):" Foreground="{StaticResource TextSecondaryBrush}"/>
        <PasswordBox x:Name="Pass" AutomationProperties.Name="Parola cheii ofițerului de securitate" Margin="0,4,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Continuă" IsDefault="True" Click="Ok_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Renunță" IsCancel="True" Click="Cancel_Click" Style="{StaticResource OutlineButtonStyle}"/>
        </WrapPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
