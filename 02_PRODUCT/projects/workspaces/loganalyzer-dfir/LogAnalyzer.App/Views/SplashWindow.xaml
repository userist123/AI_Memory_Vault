<Window x:Class="LogAnalyzer.UI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Initializing DFIR Threat Operations..." Height="320" Width="520"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True">
    <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" CornerRadius="10" Padding="28" Effect="{StaticResource ModalShadow}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Vector Logo & Brand -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Border Width="32" Height="32" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                    <Path Data="M 12 2 L 2 7 L 2 13 C 2 19 6.5 24.5 12 26 C 17.5 24.5 22 19 22 13 L 22 7 Z"
                          Fill="{StaticResource PrimaryAccentBrush}" Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="LOGANALYZER" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Border Margin="10,0,0,0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="v2.5 PRO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                </Border>
            </StackPanel>
            
            <TextBlock Text="Enterprise Threat Triage &amp; Incident Response Command Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,26"/>
            
            <ProgressBar x:Name="ProgBar" Width="360" Height="6" IsIndeterminate="True" Foreground="{StaticResource PrimaryAccentBrush}" Background="{StaticResource CanvasBrush}" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Initializing forensic analysis engine and SQLCipher database..." FontSize="11" Foreground="{StaticResource CyanAccentBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </Border>
</Window>