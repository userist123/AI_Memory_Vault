<UserControl x:Class="LogAnalyzer.UI.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:LogAnalyzer.UI.Services"
             xmlns:ctrl="clr-namespace:LogAnalyzer.UI.Views.Controls"
             xmlns:vmx="clr-namespace:LogAnalyzer.UI.ViewModels"
             xmlns:views="clr-namespace:LogAnalyzer.UI.Views">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding Notice}" Margin="0,4,0,0" TextWrapping="Wrap">
                <!-- 2026-10-23: in Simplu the permissions line is a small secondary line under the one explanation -->
                <TextBlock.Style><Style TargetType="TextBlock">
                    <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="True">
                        <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    </DataTrigger></Style.Triggers>
                </Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding AccessNotice}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Lista persoanelor care lucrează pe stație. Apăsați „Preia de pe stație”; o completați apoi cu autorizările.">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"/>
                        <Condition Binding="{Binding IsEmpty}" Value="False"/>
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Rândurile se preiau de pe stație („Preia de pe stație”); persoana completează doar ce stația nu poate ști. Se pot și lipi din tabel sau importa (JSON / CSV). Analiza le compară cu ce s-a observat; nimic nu se aplică pe Windows. Un registru fără rânduri este „registru nedefinit”, niciodată „conform”. Fiecare modificare salvată intră într-un jurnal de audit înlănțuit prin hash.">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpert, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ctrl:EmptyStateCard What="{x:Static vmx:EmptyStates.UsersWhat}" Why="{x:Static vmx:EmptyStates.UsersWhy}" Step="{x:Static vmx:EmptyStates.UsersStep}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,8">
            <StackPanel>
                
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Preia de pe stație" Command="{Binding DiscoverCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"
                            AutomationProperties.HelpText="Citește de pe această stație conturile sau mediile existente și adaugă rândurile care lipsesc. Nu modifică nimic pe Windows și nu schimbă rândurile deja existente."/>
                    <!-- 2026-10-23: one accent button in Simplu ("Preia de pe stație"); "Salvează" is the accent one in Expert as before -->
                    <Button Content="Salvează" views:SimpleLevel.HideInSimple="True" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Salvează" views:SimpleLevel.OnlyInSimple="True" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Reîncarcă" views:SimpleLevel.HideInSimple="True" Command="{Binding ReloadCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Deschide…" views:SimpleLevel.HideInSimple="True" Command="{Binding OpenFileCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Validează" views:SimpleLevel.HideInSimple="True" Command="{Binding ValidateCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,0"/>
                    <Button Content="Importă JSON…" views:SimpleLevel.HideInSimple="True" Command="{Binding ImportJsonCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Importă CSV…" views:SimpleLevel.HideInSimple="True" Command="{Binding ImportCsvCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Lipește în tabel" views:SimpleLevel.HideInSimple="True" Command="{Binding PasteCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,0"/>
                    <CheckBox Content="înlocuiește conținutul la import/lipire" views:SimpleLevel.HideInSimple="True" IsChecked="{Binding ReplaceOnImport}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </WrapPanel>
                <TextBlock Text="{Binding Definition, StringFormat='Registru: {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <Expander Header="Avansat" IsExpanded="False" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" AutomationProperties.Name="Avansat: fișierul registrului">
                    <StackPanel>
                    <WrapPanel Margin="0,6,0,0" views:SimpleLevel.OnlyInSimple="True">
                        <Button Content="Reîncarcă" Command="{Binding ReloadCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,4"/>
                        <Button Content="Deschide…" Command="{Binding OpenFileCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,4"/>
                        <Button Content="Validează" Command="{Binding ValidateCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,4"/>
                        <Button Content="Importă JSON…" Command="{Binding ImportJsonCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,4"/>
                        <Button Content="Importă CSV…" Command="{Binding ImportCsvCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,4"/>
                        <Button Content="Lipește în tabel" Command="{Binding PasteCommand}" IsEnabled="{Binding CanEdit}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,10,4"/>
                        <CheckBox Content="înlocuiește conținutul la import/lipire" IsChecked="{Binding ReplaceOnImport}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Fișier:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Fișierul registrului" Text="{Binding RegisterPath, Mode=OneWay}" IsReadOnly="True" Width="420"/>
                    </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ObsidianCardStyle}">
            <DockPanel Margin="8">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Columns}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Hint}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <DataGrid ItemsSource="{Binding View}" AutoGenerateColumns="True" AutoGeneratingColumn="Grid_AutoGeneratingColumn" CanUserAddRows="True" CanUserDeleteRows="True"
                          HeadersVisibility="Column" SelectionUnit="CellOrRowHeader" ClipboardCopyMode="IncludeHeader"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource ObsidianCardStyle}" Margin="0,8,0,0" MaxHeight="150">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Erori și avertismente (pe linii)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Issues}" Background="Transparent" BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
