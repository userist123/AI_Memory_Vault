<Window x:Class="LogAnalyzer.UI.Views.DeviceHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fit="clr-namespace:LogAnalyzer.UI.Views.Controls"
        Title="Istoricul dispozitivului" fit:WindowFit.ToWorkArea="True" Width="900" Height="520" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface1Brush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="din jurnalul sigilat" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Închide" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="16,4" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        <DataGrid x:Name="HistoryGrid" AutomationProperties.Name="Istoricul dispozitivului din jurnalul sigilat" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Data și ora" Binding="{Binding TimeText, Mode=OneWay}" Width="150"/>
                <DataGridTextColumn Header="Eveniment" Binding="{Binding Kind, Mode=OneWay}" Width="1.3*"/>
                <DataGridTextColumn Header="Utilizator" Binding="{Binding User, Mode=OneWay}" Width="1.1*"/>
                <DataGridTextColumn Header="Detalii" Binding="{Binding Details, Mode=OneWay}" Width="2*">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
