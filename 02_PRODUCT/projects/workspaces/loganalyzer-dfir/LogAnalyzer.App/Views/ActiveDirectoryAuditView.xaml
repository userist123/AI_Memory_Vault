<UserControl x:Class="LogAnalyzer.UI.Views.ActiveDirectoryAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header with Title & Enterprise ADAudit Export Actions -->
        <StackPanel Grid.Row="0">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Active Directory"/>
                    <Border Margin="12,0,0,0" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="Rețea de întreprindere și cloud hibrid" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource PageLeadStyle}" Text="Auditare completă a domeniului: exploatări Kerberos, replicare AD, GPO, atribute înainte și după, Azure AD / Entra ID, server DNS, UBA și NIS2"/>
            </StackPanel>

            <!-- lab 2026-11-07: under the title and wrapping, so at 1024 px no button is cut off -->
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button AutomationProperties.Name="Exportă CSV" Command="{Binding ExportAdAuditReportCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="12,6" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Exportă CSV" VerticalAlignment="Center"/></StackPanel></Button>
                <Button AutomationProperties.Name="Raport executiv PDF" Command="{Binding ExportAdAuditPdfReportCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Raport executiv PDF" VerticalAlignment="Center"/></StackPanel></Button>
                <Button AutomationProperties.Name="Raport executiv HTML" Command="{Binding ExportAdAuditHtmlReportCommand}" Style="{StaticResource OutlineButtonStyle}" Padding="14,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Raport executiv HTML" VerticalAlignment="Center"/></StackPanel></Button>
            </WrapPanel>
        </DockPanel>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <!-- 2. Enterprise AD & Network KPI Ribbon -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
            <!-- Metric 1: Total AD Events -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Evenimente Active Directory" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding AdEventsAnalyzedCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Jurnale DC și securitate domeniu" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 2: Domain Admins Changes -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Grupuri Domain Admins" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                    <TextBlock Text="{Binding AdPrivilegedGroupChangesCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Enterprise / Schema Admins" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 3: Kerberos Exploits -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Atacuri Kerberos / AD" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                    <TextBlock Text="{Binding AdKerberosAttacksCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Kerberoast, DCSync, DCShadow" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 4: GPO & AD Objects Policy Tampering -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Modificări GPO și politici" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                    <TextBlock Text="{Binding AdGpoPolicyChangesCount, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="EID 4739 / 5136 / 5137" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 5: Azure AD / Cloud Identity -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,6,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="Evenimente cloud Entra" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}"/>
                    <TextBlock Text="{Binding AzureAdFindings.Count, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource CyanAccentBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Roluri PIM, deplasare imposibilă" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Metric 6: UBA Behavioral Anomalies -->
            <Border Style="{StaticResource ObsidianCardStyle}" Padding="10">
                <StackPanel>
                    <TextBlock Text="Anomalii de comportament UBA" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource HighBrush}"/>
                    <TextBlock Text="{Binding UbaAnomalies.Count, FallbackValue=0}" FontSize="18" FontWeight="Black" Foreground="{StaticResource HighBrush}" Margin="0,3,0,1"/>
                    <TextBlock Text="Sesiuni concurente și în afara programului" FontSize="8.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. Enterprise AD 360 Workspace TabControl -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: Active Directory Domain & Kerberos Exploits -->
            <TabItem Header="Active Directory și Kerberos" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Anomalii de autentificare în domeniu, modificări GPO, DCShadow și exploatări ale replicării AD" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding KerberosFindings.Count, StringFormat='{}{0} Detecții AD'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding KerberosFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="140"/>
                                <DataGridTextColumn Header="Tip atac / eveniment" Binding="{Binding AttackType}" Width="180"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Cont țintă" Binding="{Binding TargetAccount}" Width="140"/>
                                <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="85"/>
                                <DataGridTextColumn Header="Sursă / IP" Binding="{Binding ClientIp}" Width="100"/>
                                <DataGridTextColumn Header="Sumar analiză și recomandare răspuns" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 2: Before / After Attribute Deltas -->
            <TabItem Header="Valori atribute înainte și după" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Audit granular al valorilor atributelor obiectelor Active Directory (valori înainte / după — EID 5136 / 4738)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding AdAttributeDeltas.Count, StringFormat='{}{0} Modificări Atribute'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AdAttributeDeltas}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Clasă obiect" Binding="{Binding ObjectClass}" Width="100"/>
                                <DataGridTextColumn Header="DN obiect modificat" Binding="{Binding ObjectDn}" Width="220"/>
                                <DataGridTextColumn Header="Nume atribut LDAP" Binding="{Binding AttributeName}" Width="160"/>
                                <DataGridTextColumn Header="Valoare anterioară" Binding="{Binding OldValue}" Width="130"/>
                                <DataGridTextColumn Header="Valoare nouă" Binding="{Binding NewValue}" Width="140"/>
                                <DataGridTextColumn Header="Operațiune" Binding="{Binding Operation}" Width="110"/>
                                <DataGridTextColumn Header="Impact securitate" Binding="{Binding SecurityImpact}" Width="*"/>
                                <DataGridTextColumn Header="Modificat De" Binding="{Binding ModifiedBy}" Width="110"/>
                                <DataGridTextColumn Header="Marcaj de timp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: Azure AD & Cloud Identity -->
            <TabItem Header="Azure AD / Entra ID" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Auditare de securitate hibridă Azure AD și Entra ID (autentificări riscante, roluri PIM, acces condiționat)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding AzureAdFindings.Count, StringFormat='{}{0} Evenimente Cloud'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AzureAdFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tip activitate cloud" Binding="{Binding ActivityType}" Width="200"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="85"/>
                                <DataGridTextColumn Header="Cont UPN" Binding="{Binding UserPrincipalName}" Width="170"/>
                                <DataGridTextColumn Header="Locație / sursă" Binding="{Binding SourceLocationOrIp}" Width="140"/>
                                <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="80"/>
                                <DataGridTextColumn Header="Descriere și impact" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Măsură răspuns" Binding="{Binding RemediationActionRo}" Width="240"/>
                                <DataGridTextColumn Header="Marcaj de timp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: File Server & NAS Auditing -->
            <TabItem Header="Server de fișiere și NAS" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Auditare partajări de fișiere Windows și NAS (detecție ransomware, acces la dosare confidențiale)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding FileServerFindings.Count, StringFormat='{}{0} Evenimente Fișiere'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding FileServerFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tip activitate fișier" Binding="{Binding ActivityType}" Width="190"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="85"/>
                                <DataGridTextColumn Header="Cale partajare / fișier" Binding="{Binding SharePathOrFileName}" Width="200"/>
                                <DataGridTextColumn Header="Server" Binding="{Binding ServerHost}" Width="110"/>
                                <DataGridTextColumn Header="Utilizator" Binding="{Binding AccessedBy}" Width="130"/>
                                <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="80"/>
                                <DataGridTextColumn Header="Descriere și diagnostic" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Recomandare răspuns" Binding="{Binding RemediationActionRo}" Width="240"/>
                                <DataGridTextColumn Header="Marcaj de timp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="135"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 5: DNS Server & Zone Auditing -->
            <TabItem Header="Server DNS" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Auditare modificări ale înregistrărilor și zonelor DNS (otrăvire DNS și redirecționare)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding DnsFindings.Count, StringFormat='{}{0} Evenimente DNS'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding DnsFindings}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tip detecție" Binding="{Binding FindingType}" Width="180"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Nume înregistrare" Binding="{Binding RecordName}" Width="160"/>
                                <DataGridTextColumn Header="Zonă DNS" Binding="{Binding ZoneName}" Width="150"/>
                                <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechniqueId}" Width="85"/>
                                <DataGridTextColumn Header="Descriere și impact" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Acțiune recomandată" Binding="{Binding RemediationActionRo}" Width="250"/>
                                <DataGridTextColumn Header="Marcaj de timp" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 6: User Behavior Analytics (UBA) -->
            <TabItem Header="UBA (comportamentul utilizatorilor)" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Analiza comportamentului utilizatorilor (UBA): sesiuni concurente pe mai multe stații și autentificări în afara orelor de lucru" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource EvidenceAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding UbaAnomalies.Count, StringFormat='{}{0} Anomalii Comportament'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding UbaAnomalies}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Utilizator domeniu" Binding="{Binding Username}" Width="150"/>
                                <DataGridTextColumn Header="Tip anomalie UBA" Binding="{Binding AnomalyType}" Width="210"/>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity}" Width="90"/>
                                <DataGridTextColumn Header="Punctaj risc" Binding="{Binding RiskWeight, StringFormat='{}{0}/100'}" Width="85"/>
                                <DataGridTextColumn Header="Descriere și diagnostic comportamental" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 7: Automated Compliance Checks Matrix -->
            <TabItem Header="Conformitate la nivel de întreprindere" Style="{StaticResource InspectorTabItemStyle}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,10,0,0">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Matrice automată de evaluare a conformității la nivel de întreprindere (NIS2, HG 585/2002, GDPR, PCI-DSS)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding ComplianceResults.Count, StringFormat='{}{0} controale (NEEVALUAT = fără verdict)'}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </Border>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ComplianceResults}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Standard / cadru" Binding="{Binding Framework}" Width="170"/>
                                <DataGridTextColumn Header="Articol / control" Binding="{Binding ArticleOrControl}" Width="140"/>
                                <DataGridTextColumn Header="Titlu control" Binding="{Binding ControlTitle}" Width="200"/>
                                <DataGridTextColumn Header="Stare" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Evidență forensică corelată" Binding="{Binding EvidenceSummary}" Width="*"/>
                                <DataGridTextColumn Header="Măsură corectivă impusă" Binding="{Binding RequiredAction}" Width="260"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
