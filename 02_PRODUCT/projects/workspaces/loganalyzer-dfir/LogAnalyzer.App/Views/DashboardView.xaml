<UserControl xmlns:sevc="clr-namespace:LogAnalyzer.UI.Views" x:Class="LogAnalyzer.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogAnalyzer.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page Title & Operational Context -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Panou general" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Situația analizei: evenimente, alerte și artefacte încărcate" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <!-- Real result of the last custody-chain verification in this session, or the neutral "not verified" default. -->
                        <TextBlock Text="{Binding ProvenanceStatusMessage}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Metric KPI Cards (Air-Gapped Mode) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16" Visibility="{Binding IsAirGappedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Card 1: Events -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Evenimente încărcate" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalEventsCount, FallbackValue=0}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Total înregistrări din cazul curent" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Alerts -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Alerte corelate" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalAlertsCount, FallbackValue=0}" Foreground="{StaticResource CriticalBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Alerte generate din evenimentele încărcate" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Registry Artifacts -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Artefacte de registru" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalRegistryCount, FallbackValue=0}" Foreground="{StaticResource SuccessBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Chei de registru încărcate" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Identified Hosts -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Stații în analiză" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalHostsCount, FallbackValue=0}" Foreground="{StaticResource HighBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Stații distincte din evenimentele încărcate" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Metric KPI Cards (Network SOC Mode) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16" Visibility="{Binding IsNetworkMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Card 1: Live Events -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Evenimente primite" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalLiveEventsCaptured, FallbackValue=0}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Primite în sesiunea curentă" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Active Detections -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Detecții active" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding LiveAlerts.Count, FallbackValue=0}" Foreground="{StaticResource CriticalBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Alerte din fluxul în timp real" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Shield State -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Izolare automată" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="24" FontWeight="Bold" Margin="0,2,0,2">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="OPRITĂ"/>
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasContainment}" Value="False">
                                        <Setter Property="Text" Value="INDISPONIBILĂ"/>
                                    </DataTrigger>
                                        <DataTrigger Binding="{Binding Containment.AutoContainEnabled}" Value="True">
                                            <Setter Property="Text" Value="PORNITĂ"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Izolarea automată este oprită (implicit). Izolarea se face manual, din pagina de izolare a proceselor."/>
                                    <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasContainment}" Value="False">
                                        <Setter Property="Text" Value="Izolarea proceselor nu este disponibilă în ediția Standalone."/>
                                    </DataTrigger>
                                        <DataTrigger Binding="{Binding Containment.AutoContainEnabled}" Value="True">
                                            <Setter Property="Text" Value="Izolare automată pornită: procesele cu încredere mare sunt izolate de rețea (nu sunt suspendate)."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Card 4: Target Sensor -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="Gazdă monitorizată" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding LiveRemoteTargetHost}" Foreground="{StaticResource HighBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
                        <TextBlock Text="Gazda țintă a monitorizării (nu confirmă un senzor activ)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Threat Spectrum & Forensic Risk Distribution Gauge -->
            <Border Grid.Row="2" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="Gravitatea alertelor încărcate" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Margin="10,0,0,0" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="Numărători; alertele de test sunt excluse" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource CriticalBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CriticalAlertsCount, StringFormat='Critice ({0})', FallbackValue='Critice (0)'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource HighBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HighAlertsCount, StringFormat='Ridicate ({0})', FallbackValue='Ridicate (0)'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource MediumBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding MediumAlertsCount, StringFormat='Medii ({0})', FallbackValue='Medii (0)'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource LowBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LowAlertsCount, StringFormat='Informative / scăzute ({0})', FallbackValue='Informative / scăzute (0)'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <!-- The former proportional bar used fixed sample widths (42/28/18/12) and was removed; the counts above are real. -->
                </Grid>
            </Border>

            <!-- 2-Column Split: Active Alerts & MITRE Heatmap -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Alerts Table Panel (Air-Gapped Mode) -->
                <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,12,0" Visibility="{Binding IsAirGappedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Coada de amenințări" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding IssuesView.Count, StringFormat='{}{0} alerte'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding Severity, Converter={x:Static sevc:SeverityTextConverter.Instance}}" Width="85"/>
                                <DataGridTextColumn Header="Ce s-a întâmplat" Binding="{Binding Plain}" Width="420" MinWidth="300"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                                <DataGridTextColumn Header="Procedură și acțiune" Binding="{Binding Explanation}" Width="*"/>
                                <DataGridTextColumn Header="Tehnic: tipul alertei" Binding="{Binding Title}" Width="160"/>
                                <DataGridTextColumn Header="Tehnic: tehnică" Binding="{Binding MitreTechniqueId}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Operational Posture / MITRE Tactic Heatmap -->
                <Border Grid.Column="1" Style="{StaticResource ObsidianCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Tehnici ATT&amp;CK din alertele încărcate" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </DockPanel>
                        
                        <Grid Grid.Row="1">
                            <!-- Only techniques present in the loaded (non-test) alerts; nothing is shown when there are none. -->
                            <ItemsControl ItemsSource="{Binding LoadedAlertTechniques}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TechId}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                                                <TextBlock Text="{Binding Count, StringFormat=' × {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nicio alertă încărcată nu are o tehnică ATT&amp;CK asociată." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LoadedAlertTechniques.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>