<UserControl x:Class="LogAnalyzer.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LogAnalyzer.UI.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page Title & Operational Context -->
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,20">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Command Center" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Operational posture, prioritized telemetry &amp; live threat triage" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="EVIDENCE VAULT SECURED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
            </DockPanel>

            <!-- Metric KPI Cards (Air-Gapped Mode) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16" Visibility="{Binding IsAirGappedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Card 1: Events -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="INGESTED EVENTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="SQLITE" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalEventsCount, FallbackValue=0}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Total immutable forensic records" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Alerts -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="CORRELATED ALERTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="TRIAGE" Foreground="{StaticResource CriticalBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalAlertsCount, FallbackValue=0}" Foreground="{StaticResource CriticalBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Multi-stage threats detected" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Registry Artifacts -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="REGISTRY ARTIFACTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="HIVE" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalRegistryCount, FallbackValue=0}" Foreground="{StaticResource SuccessBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Persistence &amp; autorun keys analyzed" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Identified Hosts -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="HOSTS IN SCOPE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="NODES" Foreground="{StaticResource HighBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalHostsCount, FallbackValue=0}" Foreground="{StaticResource HighBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Unique diagnosed endpoints" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Metric KPI Cards (Network SOC Mode) -->
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16" Visibility="{Binding IsNetworkMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Card 1: Live Events -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="STREAMED EVENTS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="LIVE" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding TotalLiveEventsCaptured, FallbackValue=0}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Continuous in-memory interception" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Active Detections -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="ACTIVE DETECTIONS" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="CRITICAL" Foreground="{StaticResource CriticalBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding LiveAlerts.Count, FallbackValue=0}" Foreground="{StaticResource CriticalBrush}" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Attacks &amp; anomaly triggers" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Shield State -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="EDR CONTAINMENT" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="&lt; 10MS" Foreground="{StaticResource CyanAccentBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="ACTIVE" Foreground="{StaticResource SuccessBrush}" FontSize="24" FontWeight="Bold" Margin="0,2,0,2"/>
                        <TextBlock Text="Auto-isolation &amp; kill process armed" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Target Sensor -->
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="TARGET SENSOR" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="HOST" Foreground="{StaticResource HighBrush}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="{Binding LiveRemoteTargetHost}" Foreground="{StaticResource HighBrush}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
                        <TextBlock Text="Live ETW / Sysmon sensor attached" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Threat Spectrum & Forensic Risk Distribution Gauge -->
            <Border Grid.Row="2" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <TextBlock Text="OPERATIONAL THREAT SPECTRUM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Margin="10,0,0,0" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="REAL-TIME SEVERITY DISTRIBUTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource CriticalBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Critical (42%)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource HighBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="High (28%)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource MediumBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Medium (18%)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource LowBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Info / Low (12%)" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <!-- Proportional Multi-Segment Spectrum Bar -->
                    <Border Grid.Row="1" Height="8" CornerRadius="4" Background="{StaticResource Surface1Brush}" ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4.2*"/>
                                <ColumnDefinition Width="2.8*"/>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="{StaticResource CriticalBrush}" Margin="0,0,1,0"/>
                            <Rectangle Grid.Column="1" Fill="{StaticResource HighBrush}" Margin="0,0,1,0"/>
                            <Rectangle Grid.Column="2" Fill="{StaticResource MediumBrush}" Margin="0,0,1,0"/>
                            <Rectangle Grid.Column="3" Fill="{StaticResource LowBrush}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2-Column Split: Active Alerts & MITRE Heatmap -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Alerts Table Panel (Air-Gapped Mode) -->
                <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,12,0" Visibility="{Binding IsAirGappedMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Prioritized Threat Queue" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding IssuesView.Count, StringFormat='{}{0} signals'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/>
                                <DataGridTextColumn Header="Technique" Binding="{Binding MitreTechniqueId}" Width="85"/>
                                <DataGridTextColumn Header="Alert Title" Binding="{Binding Title}" Width="180"/>
                                <DataGridTextColumn Header="Forensic Description" Binding="{Binding Explanation}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Live Streaming Alerts (Network Mode) -->
                <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,12,0" Visibility="{Binding IsNetworkMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="Real-Time Detection Feed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LiveAlerts.Count, StringFormat='{}{0} active'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </DockPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding LiveAlerts}" SelectedItem="{Binding SelectedLiveAlert}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/>
                                <DataGridTextColumn Header="Technique" Binding="{Binding MitreTechniqueId}" Width="85"/>
                                <DataGridTextColumn Header="Alert Type" Binding="{Binding Title}" Width="180"/>
                                <DataGridTextColumn Header="Playbook &amp; Action" Binding="{Binding Explanation}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Operational Posture / MITRE Tactic Heatmap -->
                <Border Grid.Column="1" Style="{StaticResource ObsidianCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="ATT&amp;CK Tactic Distribution" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource Surface3Brush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="MITRE MATRIX" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}"/>
                            </Border>
                        </DockPanel>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Access -->
                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                                <StackPanel>
                                    <TextBlock Text="ACCESS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding MitreInitialAccessTechniques}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding TechId}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Execution -->
                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                                <StackPanel>
                                    <TextBlock Text="EXECUTION" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding MitreExecutionTechniques}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding TechId}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Persistence -->
                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Margin="2,0">
                                <StackPanel>
                                    <TextBlock Text="PERSISTENCE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding MitrePersistenceTechniques}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding TechId}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Impact -->
                            <Border Grid.Column="3" Margin="2,0">
                                <StackPanel>
                                    <TextBlock Text="IMPACT" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding MitreImpactTechniques}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding TechId}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>