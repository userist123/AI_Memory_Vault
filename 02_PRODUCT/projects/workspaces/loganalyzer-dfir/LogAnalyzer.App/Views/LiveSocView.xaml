<UserControl x:Class="LogAnalyzer.UI.Views.LiveSocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Command Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,16" Padding="14">
            <DockPanel LastChildFill="False">
                <!-- start/stop/error/edition messages were set but never shown (audit 2026-10-11) -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding LiveMonitoringStatusText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                <!-- lab 2026-11-07: the counters dock right first and the buttons wrap, so at 1024 px nothing is cut off -->
                <Border DockPanel.Dock="Right" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Primite: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalLiveEventsCaptured, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="4,0,10,0"/>
                        <TextBlock Text="Alerte: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LiveAlerts.Count, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
                <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Gazdă monitorizată:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding LiveRemoteTargetHost, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    
                    <Button Content="▶ Pornește fluxul" Command="{Binding StartLiveMonitoringCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="12,5" Margin="0,0,8,0"/>
                    <Button Content="⏹ Oprește" Command="{Binding StopLiveMonitoringCommand}" Style="{StaticResource DangerButtonStyle}" Padding="12,5" Margin="0,0,8,0"/>

                    <!-- Attack Simulation Dropdown -->

                    <!-- Remediation Action Dropdown -->
                    <Button Content="Restaurare rețea ▾" Click="SimulateMenuButton_Click" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource SuccessBrush}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Padding="12,5" Margin="0,0,8,0">
                        <Button.ContextMenu>
                            <ContextMenu Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
                                <MenuItem Header="Ridică izolarea întregii stații (regula LogAnalyzer din firewall)" Command="{Binding ExecuteRestoreNetworkCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="Golește fluxul" Command="{Binding ClearLiveFeedCommand}" Padding="10,5"/>
                </WrapPanel>

            </DockPanel>
        </Border>

        <!-- Main Live Event Stream Grid -->
        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="Flux de telemetrie în timp real" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding LiveStreamingEvents}" SelectedItem="{Binding SelectedLiveStreamingEvent}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Marcaj de timp" Binding="{Binding TimeCreated, StringFormat={}{0:HH:mm:ss.fff}}" Width="110"/>
                        <DataGridTextColumn Header="EID" Binding="{Binding EventId}" Width="60"/>
                        <DataGridTextColumn Header="Nivel" Binding="{Binding Level}" Width="80"/>
                        <DataGridTextColumn Header="Sursă" Binding="{Binding ProviderName}" Width="140"/>
                        <DataGridTextColumn Header="Gazdă" Binding="{Binding MachineName}" Width="110"/>
                        <DataGridTextColumn Header="Conținut" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>