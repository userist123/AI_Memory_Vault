<UserControl x:Class="LogAnalyzer.UI.Views.MitreMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title & Coverage Stats -->
        <StackPanel Grid.Row="0">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Tehnici de atac (MITRE ATT&amp;CK)" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <!-- 7-column matrix; design pass 2026-11-10: ONE vertical scroll for the whole matrix (each column had its own scrollbar, which took the width and broke words) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: Initial Access -->
            <Border Grid.Column="0" Background="{StaticResource Surface1Brush}" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" Padding="4,6,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,2,4,6" Margin="0,0,0,6" MinHeight="40">
                        <TextBlock Text="Acces inițial" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MitreInitialAccessTechniques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,4" ToolTip="{Binding}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TechId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="{StaticResource CodeFontFamily}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </Border>

            <!-- Column 2: Execution -->
            <Border Grid.Column="1" Background="{StaticResource Surface1Brush}" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" Padding="4,6,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,2,4,6" Margin="0,0,0,6" MinHeight="40">
                        <TextBlock Text="Execuție" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MitreExecutionTechniques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,4" ToolTip="{Binding}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TechId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="{StaticResource CodeFontFamily}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </Border>

            <!-- Column 3: Persistence -->
            <Border Grid.Column="2" Background="{StaticResource Surface1Brush}" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" Padding="4,6,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,2,4,6" Margin="0,0,0,6" MinHeight="40">
                        <TextBlock Text="Persistență" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MitrePersistenceTechniques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,4" ToolTip="{Binding}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TechId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="{StaticResource CodeFontFamily}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </Border>

            <!-- Column 4: Privilege Escalation -->
            <Border Grid.Column="3" Background="{StaticResource Surface1Brush}" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" Padding="4,6,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,2,4,6" Margin="0,0,0,6" MinHeight="40">
                        <TextBlock Text="Escaladarea privilegiilor" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MitrePrivEscTechniques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,4" ToolTip="{Binding}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TechId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="{StaticResource CodeFontFamily}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </Border>

            <!-- Column 5: Defense Evasion -->
            <Border Grid.Column="4" Background="{StaticResource Surface1Brush}" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" Padding="4,6,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,2,4,6" Margin="0,0,0,6" MinHeight="40">
                        <TextBlock Text="Evitarea apărării" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MitreDefenseEvasionTechniques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,4" ToolTip="{Binding}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TechId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="{StaticResource CodeFontFamily}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </Border>

            <!-- Column 6: Credential Access -->
            <Border Grid.Column="5" Background="{StaticResource Surface1Brush}" BorderThickness="0" CornerRadius="4" Margin="0,0,4,0" Padding="4,6,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,2,4,6" Margin="0,0,0,6" MinHeight="40">
                        <TextBlock Text="Accesul la credențiale" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MitreCredentialAccessTechniques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,4" ToolTip="{Binding}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TechId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="{StaticResource CodeFontFamily}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </Border>

            <!-- Column 7: Impact -->
            <Border Grid.Column="6" Background="{StaticResource Surface1Brush}" BorderThickness="0" CornerRadius="4" Padding="4,6,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="0,0,0,2" Padding="4,2,4,6" Margin="0,0,0,6" MinHeight="40">
                        <TextBlock Text="Impact" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding MitreImpactTechniques}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,5" Margin="0,0,0,4" ToolTip="{Binding}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TechId}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" FontFamily="{StaticResource CodeFontFamily}"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <Ellipse Width="7" Height="7" Fill="{Binding DotColor}" Visibility="{Binding HasDot, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>