<Window x:Class="LogAnalyzer.UI.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fit="clr-namespace:LogAnalyzer.UI.Views.Controls"
        Title="LogAnalyzer DFIR - activarea licenței" fit:WindowFit.ToWorkArea="True" Height="640" Width="1020" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Topmost="True"
        Background="{StaticResource Surface1Brush}" Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Plan 2026-11-04 (R2/R3): the same identity column as the sign-in window; the licence decides the module, so the module is named here -->
        <Border Grid.Column="0" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="32,36">
            <StackPanel>
                <TextBlock Text="LogAnalyzer DFIR" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock x:Name="ModuleText" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{StaticResource PrimaryAccentBrush}"/>
                <TextBlock x:Name="ModulePurposeText" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24,0,16"/>
                <TextBlock Text="Cum se activează" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="1. Salvați cererea de licență pe un suport înregistrat și duceți-o celui care emite licențele (stația nu trimite nimic în rețea)."/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="2. Importați fișierul de licență primit sau lipiți licența, apoi apăsați „Verifică și activează”."/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Licența este legată de această stație și de acest modul; una emisă pentru alt modul este refuzată."/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="40,36">
            <DockPanel MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="Activarea licenței" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Programul pornește numai cu o licență semnată pentru această stație." FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Verifică și activează" Click="Activate_Click" Style="{StaticResource AccentButtonStyle}" Padding="18,7" Margin="0,0,8,0"/>
                        <Button Content="Ieșire" Click="Exit_Click" Style="{StaticResource OutlineButtonStyle}" Padding="18,7"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Pasul 1 — Cererea de licență" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Identificatorul acestei stații (Hardware ID)" FontSize="12" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Copiază" Click="CopyHwid_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,6" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtHardwareId" IsReadOnly="True" Padding="8,6" FontFamily="{StaticResource CodeFontFamily}" FontSize="13" AutomationProperties.Name="Hardware ID"/>
                            </DockPanel>
                            <Button Content="Salvează cererea de licență…" Click="SaveRequest_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    ToolTip="Scrie un fișier cu Hardware ID-ul, modulul programului și data cererii; îl duceți celui care emite licența. Nu conține nimic altceva."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Pasul 2 — Licența primită" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Licența (începe cu „LA2.” sau, pentru licențele vechi, „LA1.”; se lipește întreagă)" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox x:Name="TxtLicenseKey" Height="72" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="False" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" AutomationProperties.Name="Licența"/>
                            <Button Content="Importă fișierul de licență…" Click="ImportLicense_Click" Style="{StaticResource OutlineButtonStyle}" Padding="12,6" Margin="0,10,0,0" HorizontalAlignment="Left"
                                    ToolTip="Citește un fișier .lic sau .txt primit și îl verifică la fel ca licența lipită."/>
                            <TextBlock x:Name="TxtLegacyNotice" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       Text="Cheile din schema veche (20 de caractere, „|” și o dată) nu mai sunt valabile. Pentru o licență nouă, salvați cererea de licență (sau trimiteți Hardware ID-ul de mai sus) celui care emite licențele; veți primi o licență semnată pentru acest modul, care începe cu „LA2.”."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
