<UserControl x:Class="LogAnalyzer.UI.Views.ProcessContainmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogAnalyzer.UI.Views"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Izolare procese suspecte" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Taie accesul la rețea doar programului suspect (nu întregului PC), îl scanează și păstrează totul în incident, cu export PDF."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Izolare automată (încredere mare)" IsChecked="{Binding AutoContainEnabled}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"
                          ToolTip="La fiecare minut: programele nesemnate, din locații în care orice utilizator poate scrie și cu conexiuni în Internet sunt izolate de rețea automat (nu sunt suspendate)."/>
                <Button Content="Caută procese suspecte" Command="{Binding ScanSuspectsCommand}" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Warnings: admin rights, audit of blocked connections -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Background="{StaticResource BadgeCriticalBgBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding HasAdminWarning, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding AdminWarning}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"/>
            </Border>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Activează auditul conexiunilor blocate" Command="{Binding EnableBlockedAuditCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0"/>
                <TextBlock Text="{Binding AuditStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Suspects -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Procese de verificat" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Suspects.Count, StringFormat='  ({0})'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                        <CheckBox DockPanel.Dock="Left" Content="Suspendă și procesul" IsChecked="{Binding SuspendOnContain}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Izolează și scanează" Command="{Binding ContainSelectedCommand}" Style="{StaticResource DangerButtonStyle}"/>
                        <Button DockPanel.Dock="Right" Content="E de încredere" Command="{Binding TrustSelectedCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"
                                ToolTip="Programul (după SHA-256) nu va mai fi izolat automat"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Suspects}" SelectedItem="{Binding SelectedSuspect}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Încredere mare" Binding="{Binding HighConfidence}" Width="Auto"/>
                            <DataGridCheckBoxColumn Header="Aprobat" Binding="{Binding Trusted}" Width="Auto"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="Auto"/>
                            <DataGridTextColumn Header="Proces" Binding="{Binding Name}" Width="Auto"/>
                            <DataGridTextColumn Header="Motive" Binding="{Binding Reasons, Converter={x:Static local:JoinConverter.Instance}}" Width="2*"/>
                            <DataGridTextColumn Header="Conexiuni Internet" Binding="{Binding RemoteEndpoints, Converter={x:Static local:JoinConverter.Instance}}" Width="1.5*"/>
                            <DataGridTextColumn Header="Cale" Binding="{Binding Path}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Manual containment + incidents -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Incidente" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Incidents.Count, StringFormat='  ({0})'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Izolează program…" Command="{Binding ContainManualCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding ManualProgramPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Calea unui program de izolat (sau lăsați gol și alegeți fișierul)"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Incident" Binding="{Binding IncidentId}" Width="Auto"/>
                            <DataGridTextColumn Header="Stare" Binding="{Binding State}" Width="Auto"/>
                            <DataGridTextColumn Header="Creat (UTC)" Binding="{Binding CreatedUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="Auto"/>
                            <DataGridTextColumn Header="Program" Binding="{Binding ProgramPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Incident detail -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="Detalii incident" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="Export PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource AccentButtonStyle}" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Ridică izolarea" Command="{Binding ReleaseCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Reîmprospătează încercările blocate" Command="{Binding RefreshBlockedCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Folder" Command="{Binding OpenIncidentFolderCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                    </DockPanel>
                    <TextBox Text="{Binding IncidentDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"
                             Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar DockPanel.Dock="Left" Width="120" Height="6" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CaseRoot, StringFormat='Caz: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</UserControl>
