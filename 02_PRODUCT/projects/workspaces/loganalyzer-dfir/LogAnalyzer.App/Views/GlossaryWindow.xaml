<Window x:Class="LogAnalyzer.UI.Views.GlossaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fit="clr-namespace:LogAnalyzer.UI.Views.Controls"
        Title="Ce înseamnă? — glosarul aplicației" fit:WindowFit.ToWorkArea="True" Width="760" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WorkspaceBrush}" FontSize="13">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Ce înseamnă?" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,10"
                   Text="Fiecare termen tehnic din aplicație, cu numele pe înțelesul tuturor și o explicație scurtă. Numele tehnic rămâne în paranteză și în nivelul Expert."/>
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Content="Ghid de început (3 ecrane)" Click="Guide_Click" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,0,10"
                AutomationProperties.Name="Deschide ghidul de început" ToolTip="Cele trei ecrane de început: ce face aplicația, drumul obișnuit și unde găsiți ajutor."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Caută:" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="Caută în glosar" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
        <DataGrid x:Name="Grid" AutomationProperties.Name="Glosarul termenilor" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" RowHeight="NaN" CanUserResizeRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pe înțelesul tuturor" Binding="{Binding Romanian}" Width="1.4*">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="SemiBold"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Termenul tehnic" Binding="{Binding Technical}" Width="Auto"/>
                <DataGridTextColumn Header="Ce înseamnă" Binding="{Binding Explanation}" Width="3*">
                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
