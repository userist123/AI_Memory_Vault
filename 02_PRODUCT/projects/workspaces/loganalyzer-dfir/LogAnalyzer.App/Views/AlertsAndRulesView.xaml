<UserControl xmlns:sevc="clr-namespace:LogAnalyzer.UI.Views" x:Class="LogAnalyzer.UI.Views.AlertsAndRulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action Controls -->
        <StackPanel Grid.Row="0">
        <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Compilează și evaluează regulile" Command="{Binding CompileAndEvaluateWorkbenchCommand}" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Margin="0,0,8,0"/>
                <Button Content="Convertește în KQL/SPL" Command="{Binding TranspileWorkbenchRuleCommand}" Padding="14,6"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Amenințări și detecții"/>
                <TextBlock Style="{StaticResource PageLeadStyle}" Text="Alerte corelate și compilator interactiv de reguli Sigma / YARA"/>
            </StackPanel>
        </DockPanel>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <!-- 2-Pane Split: Left Alert Queue, Right Sigma Workbench Editor -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Correlated Security Alerts Queue -->
            <Border Grid.Column="0" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left" Text="Alerte de incident active" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding IssuesView.Count, StringFormat='{}{0} detecții'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding IssuesView}" SelectedItem="{Binding SelectedIssue}" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severitate" Binding="{Binding Severity, Converter={x:Static sevc:SeverityTextConverter.Instance}}" Width="100" MinWidth="100" ElementStyle="{StaticResource OneLineCellTextStyle}"/>
                            <DataGridTextColumn Header="Tehnică" Binding="{Binding MitreTechniqueId}" Width="110" MinWidth="110" ElementStyle="{StaticResource OneLineCellTextStyle}"/>
                            <DataGridTextColumn Header="Titlul alertei" Binding="{Binding Title}" Width="160" MinWidth="160" ElementStyle="{StaticResource OneLineCellTextStyle}"/>
                            <DataGridTextColumn Header="Analiză și context" Binding="{Binding Explanation}" Width="*" MinWidth="160"/>
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenAlertModalCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGrid.InputBindings>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}" Margin="6,0"/>

            <!-- Right: Sigma & YARA Rule Workbench -->
            <Border Grid.Column="2" Style="{StaticResource ObsidianCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- design pass 2026-11-11: the title and the rule picker stack (side by side the picker shrank to an empty square at 1024 px) -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Editor de reguli Sigma / YARA" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <!-- the rule picker: a label and a hint that shows while no rule is chosen, so the box is never an empty unlabelled field -->
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="Regulă de pornire:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Grid>
                                <ComboBox x:Name="RulePicker" ItemsSource="{Binding SigmaRules}" SelectedItem="{Binding SelectedSigmaRule}" DisplayMemberPath="Title" MinWidth="180"
                                          AutomationProperties.Name="Regulă de pornire" ToolTip="Alegeți o regulă deja încărcată ca punct de plecare; sursa ei apare în caseta de mai jos și o puteți modifica."/>
                                <TextBlock Text="Alegeți o regulă…" Margin="8,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=RulePicker}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Sursa regulii (Sigma în YAML sau YARA); alegeți o regulă de mai sus sau scrieți una nouă aici:" TextWrapping="Wrap" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    
                    <TextBox Grid.Row="2" Text="{Binding WorkbenchRuleContent, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource CodeTextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10"/>

                    <!-- Compile Output Console -->
                    <Border Grid.Row="3" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Starea compilării și potriviri de test:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding WorkbenchStatusMessage, FallbackValue='Regula nu a fost încă compilată sau evaluată.'}" Foreground="{StaticResource SuccessBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>