<UserControl x:Class="LogAnalyzer.UI.Views.TransferRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogAnalyzer.UI.Views"
             AutomationProperties.Name="Registrul de transferuri">
    <!-- Owner 2026-10-11: „registru transferuri este separat de medii de stocare chiar dacă ia date din el”. DataContext: TransferViewModel (shares the media register with MediaCenterViewModel). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:TransferDateConverter x:Key="TransferDate"/>
    </UserControl.Resources>
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Registrul de transferuri" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Transferurile de date pe medii de stocare: un singur formular, aproape totul completat. Mediile conectate și registrul de medii se citesc din pagina „Monitor dispozitive”; aici nu se modifică."
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"><Run Text="Transfer nou · "/><Run Text="{Binding NextNumber, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"/>
        
                    <TextBlock Text="Direcție" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" AutomationProperties.Name="Direcția transferului" Margin="0,2,0,8"/>
        
                    <TextBlock Text="Data transferului (gol = acum)" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <DatePicker SelectedDate="{Binding TransferDate}" AutomationProperties.Name="Data transferului" HorizontalAlignment="Left" Margin="0,2,0,8"/>

                    <TextBlock Text="Mediul de stocare (conectat acum)" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedium}" DisplayMemberPath="Device.DisplayName" AutomationProperties.Name="Mediul folosit" Margin="0,2,0,2"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8">
                        <Run Text="{Binding MediumType, Mode=OneWay}"/><Run Text=" · S/N "/><Run Text="{Binding MediumSerial, Mode=OneWay}"/><Run Text=" · nr. registru "/><Run Text="{Binding MediumRegistration, Mode=OneWay}"/>
                    </TextBlock>
        
                    <TextBlock Text="Fișierele transferate" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                        <Button Content="Alege fișierele…" Command="{Binding ChooseFilesCommand}" Margin="0,0,8,0"/>
                        <Button Content="Tot conținutul mediului" Command="{Binding WholeMediumCommand}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Files}" MaxHeight="140" AutomationProperties.Name="Fișiere și amprente">
                        <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"><Run Text="{Binding Name, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding SizeText, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Text="{Binding Sha256}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
        
                    <TextBlock Text="Clasificarea conținutului" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Classification}" AutomationProperties.Name="Clasificarea conținutului" Margin="0,2,0,8"/>
        
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sursă (structura)" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <ComboBox IsEditable="True" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding KnownDestinations}" AutomationProperties.Name="Sursa"/>
                            <TextBlock Text="Stația sursă" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding SourceStation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stația sursă"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Destinație (structura) *" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <ComboBox IsEditable="True" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding KnownDestinations}" AutomationProperties.Name="Destinația"/>
                            <TextBlock Text="Stația destinație" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding DestinationStation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Stația destinație"/>
                        </StackPanel>
                    </Grid>
        
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Persoana care face transferul" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding Person, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Persoana"/>
                            <TextBlock Text="Funcția" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding PersonFunction, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Funcția persoanei"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Martor (regula celor patru ochi) *" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            <ComboBox IsEditable="True" Text="{Binding Witness, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding KnownWitnesses}" AutomationProperties.Name="Martorul"/>
                            <TextBlock Text="Aprobat de (opțional)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding Approver, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Aprobat de"/>
                            <TextBlock Text="Număr de copii (gol = 1)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Numărul de copii transferate"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Observații" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Observații la transfer"/>
                    <Button Content="Înregistrează transferul" Command="{Binding RegisterCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Raport din" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding ReportFrom}" AutomationProperties.Name="Raport de la data" Margin="0,0,6,0"/>
                    <TextBlock Text="până la" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding ReportTo}" AutomationProperties.Name="Raport până la data" Margin="0,0,10,0"/>
                    <Button Content="Raportul registrului (PDF)" Command="{Binding ReportCommand}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Conectări fără transfer înregistrat" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding UnregisteredSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                    <ItemsControl ItemsSource="{Binding UnregisteredConnections}" MaxHeight="240" AutomationProperties.Name="Conectări de medii de stocare fără transfer înregistrat">
                        <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="Înregistrează transferul" Margin="8,0,0,0"
                                            Command="{Binding DataContext.RegisterTransferForCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            AutomationProperties.Name="Înregistrează transferul pentru această conectare"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource CriticalBrush}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="Verifică transferul după conținut" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Alegeți un transfer din listă (sau niciunul = toate) și un folder sau mediul conectat. Se compară amprentele SHA-256; suportul nu este modificat." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Content="Verifică un folder…" Command="{Binding VerifyFolderCommand}" Margin="0,0,8,0" AutomationProperties.Name="Verifică transferul după conținut într-un folder"/>
                        <Button Content="Verifică mediul conectat" Command="{Binding VerifyMediumCommand}" Margin="0,0,8,0" AutomationProperties.Name="Verifică transferul după conținut pe mediul ales"/>
                        <Button Content="Oprește" Command="{Binding CancelVerifyCommand}" Margin="0,0,12,0" AutomationProperties.Name="Oprește verificarea"/>
                        <CheckBox Content="arată și fișierele de pe suport care nu sunt în niciun transfer" IsChecked="{Binding ReportUnlisted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Visibility="{Binding IsVerifying, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding VerifyProgress}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding VerifySummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                    <ItemsControl ItemsSource="{Binding VerifyResults}" MaxHeight="150" AutomationProperties.Name="Rezultatul verificării după conținut">
                        <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,2" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding VerifyUnlisted}" MaxHeight="100" AutomationProperties.Name="Fișiere de pe suport care nu apar în niciun transfer">
                        <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarningBrush}"><Run Text="Nedeclarat: "/><Run Text="{Binding RelativePath, Mode=OneWay}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Problems}" AutomationProperties.Name="Probleme găsite în registrul de transferuri" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource CriticalBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <DataGrid ItemsSource="{Binding Transfers}" SelectedItem="{Binding SelectedTransfer, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AutomationProperties.Name="Transferurile înregistrate"
                          HorizontalScrollBarVisibility="Auto" FrozenColumnCount="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nr." Binding="{Binding RegistrationNumber}" Width="120" MinWidth="120"/>
                        <DataGridTextColumn Header="Data" Binding="{Binding DateTime, Converter={StaticResource TransferDate}}" Width="140" MinWidth="140"/>
                        <DataGridTextColumn Header="Direcție" Binding="{Binding Direction}" Width="100" MinWidth="100"/>
                        <DataGridTextColumn Header="Clasificare" Binding="{Binding Classification}" Width="*" MinWidth="130"/>
                        <DataGridTextColumn Header="Destinație" Binding="{Binding Destination}" Width="1.3*" MinWidth="170"/>
                        <DataGridTextColumn Header="Mediu" Binding="{Binding MediumSerial}" Width="*" MinWidth="140"/>
                        <DataGridTextColumn Header="Conținut" Binding="{Binding Content}" Width="1.6*" MinWidth="200"/>
                        <DataGridTextColumn Header="Martor" Binding="{Binding Witness}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="Copii" Binding="{Binding Copies}" Width="0.5*" MinWidth="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
