<Window x:Class="LogAnalyzer.UI.Views.CertificatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fit="clr-namespace:LogAnalyzer.UI.Views.Controls"
        Title="Alegeți certificatul de semnătură" fit:WindowFit.ToWorkArea="True" Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface1Brush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Pe card sunt mai multe certificate de semnătură calificată. Alegeți-l pe cel cu care semnați; codul PIN îl cere apoi Windows, nu aplicația."
                   TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{StaticResource TextSecondaryBrush}"/>
        <ListBox x:Name="List" AutomationProperties.Name="Certificatele de semnătură de pe card" MinHeight="120" MaxHeight="320"/>
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Alege" IsDefault="True" Click="Ok_Click" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Renunță" IsCancel="True" Click="Cancel_Click" Style="{StaticResource OutlineButtonStyle}"/>
        </WrapPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
