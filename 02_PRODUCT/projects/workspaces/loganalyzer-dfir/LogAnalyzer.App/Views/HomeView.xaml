<UserControl x:Class="LogAnalyzer.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:LogAnalyzer.UI.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- WP18 redesign (docs/dfir/RESEARCH_2026-10-11_UI_SI_POLITICI.md): one question, one list of actions, no card grid -->
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <ctrl:NoDataPanel/>
                <TextBlock Text="{Binding StationHeading}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="Ce doriți să faceți?" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,16"/>

                <ItemsControl ItemsSource="{Binding PrimaryIntents}" AutomationProperties.Name="Acțiuni">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ActionRowStyle}" Command="{Binding DataContext.RunIntentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    IsEnabled="{Binding Enabled}" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Tooltip}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding ReasonLine}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="Alte acțiuni" Margin="0,12,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                    <ItemsControl ItemsSource="{Binding MoreIntents}" Margin="0,8,0,0" AutomationProperties.Name="Alte acțiuni">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActionRowStyle}" Padding="16,9" Command="{Binding DataContext.RunIntentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding Enabled}" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True"
                                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Tooltip}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ReasonLine}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <TextBlock Text="{Binding OpenStatus}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- The open case: shown only when there is one (no four boxes saying "no case") -->
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,28,0,0">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCase}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="{Binding CaseTitle}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding AttentionLabel}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Attention}" Value="Critical"><Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Attention}" Value="High"><Setter Property="Foreground" Value="{StaticResource HighBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Attention}" Value="Medium"><Setter Property="Foreground" Value="{StaticResource MediumBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Attention}" Value="Undetermined"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ReadOnlyNotice}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding StartupNotice}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding StartupNotice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ClockWarning}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ClockWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding ClockWarning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBox AutomationProperties.Name="Motiv corectare ceas" Text="{Binding ClockAckReason, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,6,0" ToolTip="Motivul: cum a fost corectat ceasul"/>
                    <Button Content="Confirm că ceasul a fost corectat" Command="{Binding ConfirmClockCorrectedCommand}"/>
                </StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Există o problemă?" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Cât de grav?" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Seriousness}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Sunt probele de încredere?" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Trust}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Ce s-a găsit?" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Found}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4"/>
                </Grid>
                <TextBlock Text="Ce urmează" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                <ItemsControl ItemsSource="{Binding NextSteps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Coverage matrix (U21): only with a case open -->
            <Border Margin="0,16,0,10" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCase}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <TextBlock Text="Acoperirea surselor" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CoverageLine}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                    <DataGrid AutomationProperties.Name="Acoperirea surselor pe familii de artefacte" ItemsSource="{Binding CoverageRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Familie de artefacte" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding HumanFamily}" ToolTip="{Binding FamilyTooltip}" TextWrapping="Wrap"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stare" Binding="{Binding StateName}" Width="130"/>
                            <DataGridTextColumn Header="Motiv" Binding="{Binding Reason}" Width="3*"/>
                            <DataGridTextColumn Header="Parser" Binding="{Binding ParserStatus}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Recent cases -->
            <Border Style="{StaticResource ObsidianCardStyle}" MaxWidth="760" HorizontalAlignment="Left" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Cazuri recente" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding RecentList}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Elimină din listă" AutomationProperties.Name="{Binding Entry.Title, StringFormat='Elimină din listă cazul {0}'}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ForgetRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button DockPanel.Dock="Right" Content="Deschide" AutomationProperties.Name="{Binding Entry.Title, StringFormat='Deschide cazul {0}'}" Style="{StaticResource OutlineButtonStyle}"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Entry.Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding StateText, Mode=OneWay}"/>
                                        <Run Text="{Binding Entry.LastOpenedUtc, Mode=OneWay, StringFormat='deschis ultima dată {0:yyyy-MM-dd HH:mm} UTC'}"/>
                                        <Run Text="{Binding Entry.Path, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nicio intrare: cazurile deschise de aici apar în această listă." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentList.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
