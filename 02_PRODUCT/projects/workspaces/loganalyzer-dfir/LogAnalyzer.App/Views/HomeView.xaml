<UserControl x:Class="LogAnalyzer.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Acasă" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap"
                       Text="Răspunsuri calculate din cazul deschis: probleme, gravitate, încrederea în probe, ce s-a găsit și ce urmează. Nimic de aici nu este tastat de mână, iar „nimic detectat” nu înseamnă „sistem curat”."/>

            <!-- First-run intent chooser (U22): shown while no case is open. The question chooser comes with the goal navigation (WP7). -->
            <Border Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ObsidianCardStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCase}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="{Binding RoleTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding RoleIntro}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="Ce doriți să faceți?" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                    <!-- WP18 S2: at most five big buttons from the role profile; unavailable ones stay visible, disabled, with the reason under them -->
                    <ItemsControl ItemsSource="{Binding PrimaryIntents}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.RunIntentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding Enabled}" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True"
                                        AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Tooltip}"
                                        Style="{StaticResource AccentButtonStyle}" Padding="16,10" Margin="0,0,10,8" Width="300" HorizontalContentAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" TextWrapping="Wrap" Opacity="0.85" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding ReasonLine}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Expander Header="Mai multe" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" AutomationProperties.Name="Mai multe acțiuni">
                        <ItemsControl ItemsSource="{Binding MoreIntents}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}" Command="{Binding DataContext.RunIntentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                            IsEnabled="{Binding Enabled}" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Tooltip}"
                                            Style="{StaticResource OutlineButtonStyle}" Padding="12,8" Margin="0,0,8,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Attention -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding CaseTitle}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AttentionLabel}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Attention}" Value="Critical"><Setter Property="Foreground" Value="{StaticResource CriticalBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Attention}" Value="High"><Setter Property="Foreground" Value="{StaticResource HighBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Attention}" Value="Medium"><Setter Property="Foreground" Value="{StaticResource MediumBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Attention}" Value="Undetermined"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ReadOnlyNotice}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- The five answers -->
            <UniformGrid Columns="2" Margin="0,0,0,10">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,5,5">
                    <StackPanel>
                        <TextBlock Text="Există o problemă?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="5,0,0,5">
                    <StackPanel>
                        <TextBlock Text="Cât de grav?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Seriousness}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,5,5,0">
                    <StackPanel>
                        <TextBlock Text="Sunt probele de încredere?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Trust}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="5,5,0,0">
                    <StackPanel>
                        <TextBlock Text="Ce s-a găsit?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Found}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Ce urmează?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <ItemsControl ItemsSource="{Binding NextSteps}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding PrimaryIntents}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Command="{Binding DataContext.RunIntentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        IsEnabled="{Binding Enabled}" ToolTip="{Binding Tooltip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Title}"
                                        Style="{StaticResource OutlineButtonStyle}" Margin="0,0,8,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding OpenStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Coverage matrix (U21) -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Acoperirea surselor" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding CoverageLine}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8"/>
                    <DataGrid AutomationProperties.Name="Acoperirea surselor pe familii de artefacte" ItemsSource="{Binding CoverageRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="420">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Familie de artefacte" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding HumanFamily}" ToolTip="{Binding FamilyTooltip}" TextWrapping="Wrap"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Stare" Binding="{Binding StateName}" Width="130"/>
                            <DataGridTextColumn Header="Motiv" Binding="{Binding Reason}" Width="3*"/>
                            <DataGridTextColumn Header="Parser" Binding="{Binding ParserStatus}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Recent cases -->
            <Border Style="{StaticResource ObsidianCardStyle}">
                <StackPanel>
                    <TextBlock Text="Cazuri recente" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding RecentList}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Content="Elimină din listă" AutomationProperties.Name="{Binding Entry.Title, StringFormat='Elimină din listă cazul {0}'}" Style="{StaticResource OutlineButtonStyle}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.ForgetRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button DockPanel.Dock="Right" Content="Deschide" AutomationProperties.Name="{Binding Entry.Title, StringFormat='Deschide cazul {0}'}" Style="{StaticResource OutlineButtonStyle}"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Entry.Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding StateText, Mode=OneWay}"/>
                                        <Run Text="{Binding Entry.LastOpenedUtc, Mode=OneWay, StringFormat='deschis ultima dată {0:yyyy-MM-dd HH:mm} UTC'}"/>
                                        <Run Text="{Binding Entry.Path, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nicio intrare: cazurile deschise de aici apar în această listă." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentList.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
