<UserControl xmlns:loc="clr-namespace:LogAnalyzer.UI.Views" x:Class="LogAnalyzer.UI.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{loc:T shell.autentificare_si_conturi}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{loc:F auth.session, Path=CurrentUser}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{loc:T auth.utilizatorii_se_autentifica_cu_cardul}"/>
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Own card -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:T auth.cardurile_mele}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{loc:T auth.detectati_cardul_din_slot_alegeti}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="{loc:T auth.detecteaza_cardul}" Command="{Binding DetectCardsCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="{loc:T auth.inroleaza_cardul_ales_pentru_contul}" Command="{Binding EnrollForMeCommand}" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Detected}" SelectedItem="{Binding SelectedDetected}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T auth.certificat}" Binding="{Binding Subject}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:T auth.cititor}" Binding="{Binding Reader}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T auth.serie}" Binding="{Binding Serial}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Primary admin password -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10" Visibility="{Binding IsPrimaryAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{loc:T auth.parola_administratorului_principal}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{loc:T auth.schimbarea_cere_parola_curenta_cel}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <WrapPanel>
                        <PasswordBox x:Name="CurrentPw" Width="200" Margin="0,0,6,0" ToolTip="{loc:T auth.parola_curenta}"/>
                        <PasswordBox x:Name="NewPw" Width="200" Margin="0,0,6,0" ToolTip="{loc:T auth.parola_noua}"/>
                        <PasswordBox x:Name="ConfirmPw" Width="200" Margin="0,0,6,0" ToolTip="{loc:T auth.confirmare}"/>
                        <Button Content="{loc:T auth.schimba_parola}" Click="ChangePassword_Click" Style="{StaticResource OutlineButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Administration -->
            <StackPanel Visibility="{Binding IsAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:T auth.utilizatori_si_carduri_administrator_global}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding RegisterGap}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T signin.cont}" Binding="{Binding Account}" Width="*"/>
                                <DataGridTextColumn Header="{loc:T auth.persoana}" Binding="{Binding Person}" Width="*"/>
                                <DataGridTextColumn Header="{loc:T auth.rol}" Binding="{Binding Role}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:T home.stare}" Binding="{Binding State}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:T auth.carduri}" Binding="{Binding Cards}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:T signin.autentificare}" Binding="{Binding Mode}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,6">
                            <Button Content="{loc:T auth.schimba_rolul}" Command="{Binding ToggleRoleCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{loc:T auth.dezactiveaza_reactiveaza_contul}" Command="{Binding ToggleAccountDisabledCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{loc:T auth.inroleaza_cardul_ales_sectiunea_de}" Command="{Binding EnrollForSelectedCommand}" Style="{StaticResource AccentButtonStyle}"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="130">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T auth.amprenta_sha_256}" Binding="{Binding ShortThumbprint}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:T auth.subiect}" Binding="{Binding Subject}" Width="2*"/>
                                <DataGridTextColumn Header="{loc:T auth.serie}" Binding="{Binding Serial}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:T home.stare}" Binding="{Binding State}" Width="Auto"/>
                                <DataGridTextColumn Header="{loc:T auth.inrolat_de}" Binding="{Binding EnrolledBy}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="{loc:T auth.dezactiveaza_reactiveaza_cardul_ales}" Command="{Binding ToggleCardDisabledCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,8"/>
                        <TextBlock Text="{loc:T auth.cont_nou_se_autentifica_numai}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBox Text="{Binding NewAccount, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,6,0" ToolTip="{loc:T auth.domeniu_utilizator_sau_utilizator}"/>
                            <TextBox Text="{Binding NewPerson, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,6,0" ToolTip="{loc:T signin.nume_si_prenume}"/>
                            <CheckBox Content="{loc:T auth.administrator_global}" IsChecked="{Binding NewIsAdministrator}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="{loc:T auth.creeaza_contul}" Command="{Binding CreateAccountCommand}" Style="{StaticResource AccentButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:T auth.incredere_offline_certificate_ca_si}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{loc:T auth.un_certificat_de_card_este}"/>
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="{loc:T auth.importa_certificat_ca}" Command="{Binding ImportCaCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="{loc:T auth.importa_crl}" Command="{Binding ImportCrlCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding TrustAnchors}" MaxHeight="90" Background="Transparent" BorderThickness="0"/>
                        <ListBox ItemsSource="{Binding Crls}" MaxHeight="90" Background="Transparent" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:T auth.parametri}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <CheckBox Content="{loc:T auth.refuza_autentificarea_cand_nu_exista}" IsChecked="{Binding MissingCrlRefuse}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                        <WrapPanel>
                            <TextBlock Text="{loc:T auth.blocare_dupa_inactivitate_min}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding IdleLockMinutes}" Width="50" Margin="0,0,16,0"/>
                            <TextBlock Text="{loc:T auth.incercari_gresite_de_parola_pana}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding LockoutThreshold}" Width="50" Margin="0,0,16,0"/>
                            <Button Content="{loc:T auth.salveaza_parametrii}" Command="{Binding SavePolicyCommand}" Style="{StaticResource AccentButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{loc:T auth.audit_si_integritate}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding AuditSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Integrity}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        <Button Content="{loc:T auth.accepta_starea_curenta_a_conturilor}" Command="{Binding AcceptIntegrityCommand}" Style="{StaticResource OutlineButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding IntegrityBroken, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{loc:F auth.directory, Path=AuthDirectory}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Content="{loc:T auth.incheie_sesiunea_si_inchide_aplicatia}" Command="{Binding SignOutCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
