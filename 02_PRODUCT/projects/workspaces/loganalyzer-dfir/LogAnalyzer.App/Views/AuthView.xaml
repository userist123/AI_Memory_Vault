<UserControl x:Class="LogAnalyzer.UI.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Autentificare și conturi" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{Binding CurrentUser, StringFormat='Sesiune: {0}'}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            <TextBlock FontSize="12" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Utilizatorii se autentifică cu cardul (smart card cu contacte, în slotul tastaturii) și PIN-ul, gestionate de SafeNet Authentication Client. Aplicația nu vede PIN-ul. Administratorul principal se poate autentifica oricând și cu cont + parolă. Fiecare acțiune de aici intră în auditul înlănțuit prin hash al autentificării."/>
            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <!-- Own card -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Cardurile mele" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Detectați cardul din slot, alegeți certificatul și înrolați-l (card de rezervă sau de înlocuire). Cardul semnează o provocare; PIN-ul se introduce în fereastra Windows / SafeNet."
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Detectează cardul" Command="{Binding DetectCardsCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="Înrolează cardul ales pentru contul meu" Command="{Binding EnrollForMeCommand}" Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Detected}" SelectedItem="{Binding SelectedDetected}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Certificat" Binding="{Binding Subject}" Width="2*"/>
                            <DataGridTextColumn Header="Cititor" Binding="{Binding Reader}" Width="*"/>
                            <DataGridTextColumn Header="Serie" Binding="{Binding Serial}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Primary admin password -->
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10" Visibility="{Binding IsPrimaryAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Parola administratorului principal" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Schimbarea cere parola curentă. Cel puțin 14 caractere, diferită de nume, nu o parolă obișnuită. Parola rămâne valabilă chiar dacă aveți card înrolat."
                               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <WrapPanel>
                        <PasswordBox x:Name="CurrentPw" Width="200" Margin="0,0,6,0" ToolTip="Parola curentă"/>
                        <PasswordBox x:Name="NewPw" Width="200" Margin="0,0,6,0" ToolTip="Parola nouă"/>
                        <PasswordBox x:Name="ConfirmPw" Width="200" Margin="0,0,6,0" ToolTip="Confirmare"/>
                        <Button Content="Schimbă parola" Click="ChangePassword_Click" Style="{StaticResource OutlineButtonStyle}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Administration -->
            <StackPanel Visibility="{Binding IsAdministrator, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Utilizatori și carduri (administrator global)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding RegisterGap}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cont" Binding="{Binding Account}" Width="*"/>
                                <DataGridTextColumn Header="Persoană" Binding="{Binding Person}" Width="*"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="Auto"/>
                                <DataGridTextColumn Header="Stare" Binding="{Binding State}" Width="Auto"/>
                                <DataGridTextColumn Header="Carduri" Binding="{Binding Cards}" Width="Auto"/>
                                <DataGridTextColumn Header="Autentificare" Binding="{Binding Mode}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,6,0,6">
                            <Button Content="Schimbă rolul" Command="{Binding ToggleRoleCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Dezactivează / reactivează contul" Command="{Binding ToggleAccountDisabledCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Înrolează cardul ales (secțiunea de sus) pentru contul selectat" Command="{Binding EnrollForSelectedCommand}" Style="{StaticResource AccentButtonStyle}"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="130">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Amprentă SHA-256" Binding="{Binding ShortThumbprint}" Width="Auto"/>
                                <DataGridTextColumn Header="Subiect" Binding="{Binding Subject}" Width="2*"/>
                                <DataGridTextColumn Header="Serie" Binding="{Binding Serial}" Width="Auto"/>
                                <DataGridTextColumn Header="Stare" Binding="{Binding State}" Width="Auto"/>
                                <DataGridTextColumn Header="Înrolat de" Binding="{Binding EnrolledBy}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Dezactivează / reactivează cardul ales" Command="{Binding ToggleCardDisabledCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left" Margin="0,6,0,8"/>
                        <TextBlock Text="Cont nou (se autentifică numai cu card + PIN)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <WrapPanel Margin="0,4,0,0">
                            <TextBox Text="{Binding NewAccount, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,6,0" ToolTip="DOMENIU\utilizator sau utilizator"/>
                            <TextBox Text="{Binding NewPerson, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,0,6,0" ToolTip="Nume și prenume"/>
                            <CheckBox Content="administrator global" IsChecked="{Binding NewIsAdministrator}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Content="Creează contul" Command="{Binding CreateAccountCommand}" Style="{StaticResource AccentButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Încredere (offline): certificate CA și CRL" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Un certificat de card este acceptat numai dacă are lanț până la un CA importat aici. Revocarea se citește numai din CRL-urile importate (obținute offline); aplicația nu descarcă nimic."/>
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Importă certificat CA…" Command="{Binding ImportCaCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                            <Button Content="Importă CRL…" Command="{Binding ImportCrlCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding TrustAnchors}" MaxHeight="90" Background="Transparent" BorderThickness="0"/>
                        <ListBox ItemsSource="{Binding Crls}" MaxHeight="90" Background="Transparent" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Parametri" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <CheckBox Content="Refuză autentificarea când nu există un CRL curent (implicit: ediția clasificată refuză, cea neclasificată avertizează)" IsChecked="{Binding MissingCrlRefuse}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,4"/>
                        <WrapPanel>
                            <TextBlock Text="Blocare după inactivitate (min):" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding IdleLockMinutes}" Width="50" Margin="0,0,16,0"/>
                            <TextBlock Text="Încercări greșite de parolă până la blocare temporară:" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding LockoutThreshold}" Width="50" Margin="0,0,16,0"/>
                            <Button Content="Salvează parametrii" Command="{Binding SavePolicyCommand}" Style="{StaticResource AccentButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Audit și integritate" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding AuditSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Integrity}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                        <Button Content="Acceptă starea curentă a conturilor (administrator principal)" Command="{Binding AcceptIntegrityCommand}" Style="{StaticResource OutlineButtonStyle}"
                                HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="{Binding IntegrityBroken, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding AuthDirectory, StringFormat='Director: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Button Content="Încheie sesiunea și închide aplicația" Command="{Binding SignOutCommand}" Style="{StaticResource OutlineButtonStyle}" HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
