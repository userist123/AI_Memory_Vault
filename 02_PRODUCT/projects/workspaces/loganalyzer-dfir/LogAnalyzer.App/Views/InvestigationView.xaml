<UserControl xmlns:loc="clr-namespace:LogAnalyzer.UI.Views" x:Class="LogAnalyzer.UI.Views.InvestigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogAnalyzer.UI.Views"
             xmlns:ctrl="clr-namespace:LogAnalyzer.UI.Views.Controls"
             xmlns:views="clr-namespace:LogAnalyzer.UI.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{loc:T inv.folder_caz}" Command="{Binding OpenCaseCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="{loc:T inv.inchidere_caz}" Command="{Binding CloseCaseCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"
                        ToolTip="{loc:T inv.afiseaza_capetele_lanturilor_de_custodie}"/>
                <Button Content="{loc:T inv.raport_pdf}" Command="{Binding ExportPdfCommand}" Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:T inv.investigatie_completa}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{loc:T inv.colecteaza_sau_importa_probele_le}"
                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T inv.nume_caz}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.nume_caz_2}" Text="{Binding CaseName, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,10,0"/>
                        <TextBlock Text="{loc:T inv.profil}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="{loc:T inv.profil_de_colectare}" ItemsSource="{Binding Profiles}" SelectedIndex="{Binding ProfileIndex}" Width="230"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:T inv.scopul_cazului_obligatoriu_de_ce}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T inv.scop}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.scopul_cazului}" Text="{Binding ScopePurpose, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,10,0"/>
                        <TextBlock Text="{loc:T inv.aprobator}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.aprobator_2}" Text="{Binding ScopeApprover, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,10,0"/>
                        <TextBlock Text="{loc:T inv.sisteme_in_scop}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.sisteme_in_scop_2}" Text="{Binding ScopeSystems, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,10,0"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T inv.perioada_de_la}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker AutomationProperties.Name="{loc:T inv.perioada_de_la_2}" SelectedDate="{Binding ScopeFrom}" Width="130" Margin="0,0,10,0"/>
                        <TextBlock Text="{loc:T inv.pana_la}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker AutomationProperties.Name="{loc:T inv.perioada_pana_la}" SelectedDate="{Binding ScopeTo}" Width="130" Margin="0,0,10,0"/>
                        <TextBlock Text="{loc:T inv.temei}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="{loc:T inv.temei_legal}" ItemsSource="{Binding LegalBases}" SelectedIndex="{Binding LegalBasisIndex}" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="{loc:T inv.sistem}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="{loc:T inv.categoria_sistemului}" ItemsSource="{Binding NetworkCategories}" SelectedIndex="{Binding NetworkIndex}" Width="140" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="{loc:T inv.nivel_de_clasificare}" ItemsSource="{Binding ClassificationLevels}" SelectedIndex="{Binding ClassificationIndex}" Width="110"/>
                    </WrapPanel>
                    <CheckBox Content="{loc:T inv.colecteaza_de_pe_aceasta_statie}" IsChecked="{Binding CollectFromThisStation}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="{loc:T inv.adauga_fisiere_de_proba}" Command="{Binding AddFilesCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="{loc:T inv.adauga_folder_de_probe}" Command="{Binding AddFolderCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="{loc:T inv.goleste_lista}" Command="{Binding ClearFilesCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,0"/>
                        <Button Content="{loc:T inv.porneste_investigatia}" Command="{Binding RunCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="{loc:T inv.opreste}" Command="{Binding CancelCommand}" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <TextBlock Text="{loc:F inv.files_to_import, Path=ImportFiles.Count}" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBox AutomationProperties.Name="{loc:T inv.jurnalul_investigatiei}" Grid.Column="2" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="Consolas" FontSize="12" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="8"/>
            </Grid>
        </Border>

        <TabControl AutomationProperties.Name="{loc:T inv.rezultatele_investigatiei}" Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="{loc:T inv.lantul_incidentului}" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding IntegrityLine}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding VerificationLine}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox AutomationProperties.Name="{loc:T inv.text_de_inchidere_a_cazului}" DockPanel.Dock="Top" Text="{Binding ClosureText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource CodeFontFamily}" Margin="0,0,0,8">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClosureText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox AutomationProperties.Name="{loc:T inv.lanturile_incidentului}" Text="{Binding Chains, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="12" FontSize="12.5"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="{loc:T inv.constatari}" Style="{StaticResource InspectorTabItemStyle}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="120"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="3*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <!-- The grid stays; the card below is the panel of the selected finding (WP6a, U4). -->
                    <DataGrid AutomationProperties.Name="{loc:T inv.constatari}" Grid.Row="0" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T inv.severitate}" Binding="{Binding Severity, Converter={x:Static local:SeverityTextConverter.Instance}}" Width="110"/>
                            <DataGridTextColumn Header="{loc:T inv.clasificare}" Binding="{Binding Classification, Converter={x:Static local:ClassificationWordingConverter.Instance}}" Width="100"/>
                            <DataGridTextColumn Header="{loc:T home.stare}" Binding="{Binding Status, Converter={x:Static local:StandardStateLabelConverter.Instance}}" Width="130"/>
                            <DataGridTextColumn Header="{loc:T inv.verificare}" Binding="{Binding Verification.State, Converter={x:Static local:StandardStateLabelConverter.Instance}}" Width="120"/>
                            <DataGridTextColumn Header="{loc:T inv.prima_utc}" Binding="{Binding FirstSeenUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="120"/>
                            <DataGridTextColumn Header="{loc:T inv.regula}" Binding="{Binding RuleId}" Width="170"/>
                            <DataGridTextColumn Header="{loc:T inv.constatare}" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:T inv.detalii}" Binding="{Binding Description}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:T inv.separator_intre_lista_de_constatari}" Focusable="False"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{loc:T inv.alegeti_o_constatare_din_lista}"
                                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCard}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ctrl:FindingCard DataContext="{Binding SelectedCard}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:T inv.integritate_air_gap}" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{loc:T inv.zona_sistemului_analizat_pentru_compararea}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.zona_sistemului_analizat}" Text="{Binding SystemZone, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding AirGapSummary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RegisterLine}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DataGrid AutomationProperties.Name="{loc:T inv.constatari_de_integritate_air_gap}" ItemsSource="{Binding AirGapFindings}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T inv.severitate}" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="{loc:T inv.subcategorie}" Binding="{Binding AirGap.Subcategory}" Width="110"/>
                            <DataGridTextColumn Header="{loc:T inv.regula}" Binding="{Binding RuleId}" Width="170"/>
                            <DataGridTextColumn Header="{loc:T inv.canal}" Binding="{Binding AirGap.Channel}" Width="150"/>
                            <DataGridTextColumn Header="{loc:T inv.autorizat}" Binding="{Binding AirGap.Authorized}" Width="95"/>
                            <DataGridTextColumn Header="{loc:T inv.cand_utc}" Binding="{Binding AirGap.WhenUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="115"/>
                            <DataGridTextColumn Header="{loc:T inv.cine}" Binding="{Binding AirGap.Who}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.obiect}" Binding="{Binding AirGap.ObjectName}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.clasificare_caz_registru}" Binding="{Binding AirGap.CaseClassification}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.registru}" Binding="{Binding AirGap.RegisterClassification}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.directie}" Binding="{Binding AirGap.TransferDirection}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.destinatie}" Binding="{Binding AirGap.Destination}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.constatare}" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="{loc:T inv.detalii}" Binding="{Binding Description}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{loc:T inv.secvente}" Style="{StaticResource InspectorTabItemStyle}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding SequenceSummary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DataGrid AutomationProperties.Name="{loc:T inv.constatari_de_tip_secventa}" Grid.Row="1" ItemsSource="{Binding SequenceFindings}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T inv.severitate}" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="{loc:T inv.regula}" Binding="{Binding RuleId}" Width="200"/>
                            <DataGridTextColumn Header="{loc:T inv.prima_utc}" Binding="{Binding FirstSeenUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="120"/>
                            <DataGridTextColumn Header="{loc:T inv.cine_din_dovezi}" Binding="{Binding User}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.constatare}" Binding="{Binding Title}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox AutomationProperties.Name="{loc:T inv.pasii_secventelor}" Grid.Row="2" Text="{Binding SequenceSteps, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="12" FontSize="12.5"/>
                </Grid>
            </TabItem>
            <TabItem Header="{loc:T inv.cronologie}" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="{loc:T inv.filtru_text_proces_cale_utilizator}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.filtru_cronologie}" Text="{Binding TimelineFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                    </DockPanel>
                    <DataGrid AutomationProperties.Name="{loc:T inv.cronologie}" ItemsSource="{Binding Timeline}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:T inv.ora_utc}" Binding="{Binding Time.Utc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140"/>
                            <DataGridTextColumn Header="{loc:T inv.sursa}" Binding="{Binding Source}" Width="1.3*"/>
                            <DataGridTextColumn Header="{loc:T inv.id}" Binding="{Binding EventId}" Width="55"/>
                            <DataGridTextColumn Header="{loc:T inv.proces}" Binding="{Binding Process}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.utilizator}" Binding="{Binding User}" Width="*"/>
                            <DataGridTextColumn Header="{loc:T inv.rezumat}" Binding="{Binding Summary}" Width="4*"/>
                            <DataGridTextColumn Header="{loc:T inv.proba}" Binding="{Binding EvidenceId}" Width="85"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{views:Term evidence_graph}" ToolTip="{views:Term evidence_graph, Tooltip=True}" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{loc:T inv.cauta_entitate}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.cauta_entitate_2}" Text="{Binding GraphSearch, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="220" Margin="0,0,16,0"/>
                        <TextBlock Text="{loc:T inv.drum_de_la}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.drum_de_la_2}" Text="{Binding PathFrom, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:T inv.la}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.drum_pana_la}" Text="{Binding PathTo, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,6,0"/>
                        <Button Content="{loc:T inv.arata_drumul}" Command="{Binding FindPathCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding GraphStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
                        <DataGrid AutomationProperties.Name="{loc:T inv.entitati_din_graf}" Grid.Column="0" ItemsSource="{Binding GraphEntities}" SelectedItem="{Binding SelectedEntity}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T inv.tip}" Binding="{Binding Type}" Width="90"/>
                                <DataGridTextColumn Header="{loc:T inv.entitate}" Binding="{Binding Label}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid AutomationProperties.Name="{loc:T inv.legaturile_entitatii_alese}" Grid.Column="2" ItemsSource="{Binding GraphEdges}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:T inv.sens}" Binding="{Binding Direction}" Width="50"/>
                                <DataGridTextColumn Header="{loc:T inv.relatie}" Binding="{Binding Relation}" Width="110"/>
                                <DataGridTextColumn Header="{loc:T inv.cu}" Binding="{Binding OtherLabel}" Width="2*"/>
                                <DataGridTextColumn Header="{loc:T inv.ora_utc}" Binding="{Binding TimeUtc}" Width="150"/>
                                <DataGridTextColumn Header="{loc:T inv.clasificare}" Binding="{Binding Classification}" Width="100"/>
                                <DataGridTextColumn Header="{loc:T inv.incredere}" Binding="{Binding Confidence}" Width="75"/>
                                <DataGridTextColumn Header="{loc:T inv.proba_derivare}" Binding="{Binding Support}" Width="2*"/>
                                <DataGridTextColumn Header="{loc:T home.motiv}" Binding="{Binding Reason}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{loc:T inv.anti_forensics}" Style="{StaticResource InspectorTabItemStyle}">
                <DataGrid AutomationProperties.Name="{loc:T inv.verificari_anti_forensics}" Margin="8" ItemsSource="{Binding AntiForensics}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:T inv.id_2}" Binding="{Binding Id}" Width="55"/>
                        <DataGridTextColumn Header="{loc:T inv.tehnica}" Binding="{Binding Technique}" Width="1.6*"/>
                        <DataGridTextColumn Header="{loc:T inv.att_ck}" Binding="{Binding Attack}" Width="80"/>
                        <DataGridTextColumn Header="{loc:T inv.rezultat}" Binding="{Binding ResultText}" Width="115"/>
                        <DataGridTextColumn Header="{loc:T inv.probe}" Binding="{Binding Evidence.Count}" Width="55"/>
                        <DataGridTextColumn Header="{loc:T home.motiv}" Binding="{Binding Reason}" Width="4*">
                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="{loc:T inv.cronologie_politici}" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PolicyTimelineSummary}" TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ListBox AutomationProperties.Name="{loc:T inv.cronologia_politicilor}" ItemsSource="{Binding PolicyTimelineLines}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Consolas"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="{loc:T inv.analiza_ai_locala}" Style="{StaticResource InspectorTabItemStyle}">
                <ctrl:FeaturePlaceholder FeatureKey="AiAnalysis" Title="{loc:T inv.analiza_ai}" ViewModel="{Binding AiAnalysis}"/>
            </TabItem>
            <TabItem Header="{loc:T inv.colectare_la_distanta}" Style="{StaticResource InspectorTabItemStyle}">
                <StackPanel Margin="12">
                    <WrapPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:T inv.statia_tinta_nume_calculator}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.statia_tinta}" Text="{Binding RemoteHost, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,10,0"/>
                        <TextBlock Text="{loc:T inv.justificare}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="{loc:T inv.justificare_2}" Text="{Binding RemoteJustification, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="{loc:T inv.autorizeaza_si_genereaza_pachetul}" Command="{Binding GenerateRemotePackageCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="{loc:T inv.verifica_si_importa_pachetul}" Command="{Binding ImportRemotePackageCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding RemoteStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="{loc:T inv.goluri_de_proba}" Style="{StaticResource InspectorTabItemStyle}">
                <TextBox AutomationProperties.Name="{loc:T inv.goluri_de_proba}" Margin="8" Text="{Binding GapsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="12"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
