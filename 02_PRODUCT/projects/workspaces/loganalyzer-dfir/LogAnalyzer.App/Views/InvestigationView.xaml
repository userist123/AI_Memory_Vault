<UserControl x:Class="LogAnalyzer.UI.Views.InvestigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogAnalyzer.UI.Views"
             xmlns:ctrl="clr-namespace:LogAnalyzer.UI.Views.Controls"
             xmlns:views="clr-namespace:LogAnalyzer.UI.Views"
             xmlns:services="clr-namespace:LogAnalyzer.UI.Services">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
        <DockPanel>
            <!-- lab 2026-11-07: a WrapPanel under the title, so at 1024 px the report button wraps instead of being cut off -->
            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                <!-- round 4 2026-10-23: in Simplu the case buttons wait for a case (a result); Expert unchanged -->
                <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"/>
                                    <Condition Binding="{Binding HasResult}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Style>
                <Button Content="Folder caz" Command="{Binding OpenCaseCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,6"/>
                <Button Content="Închidere caz" Command="{Binding CloseCaseCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,6"
                        ToolTip="Afișează capetele lanțurilor de custodie și de audit, de înscris în registrul de custodie cu semnătură și dată"/>
                <TextBlock Text="Pentru cine este raportul?" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                <ComboBox AutomationProperties.Name="Pentru cine este raportul" ItemsSource="{Binding ReportAudienceLabels}" SelectedIndex="{Binding ReportAudienceIndex}" ToolTip="{Binding ReportAudienceDescription}" Width="230" Margin="0,0,6,6"/>
                <Button Content="Raport de incident (PDF)" Command="{Binding ExportPdfCommand}" ToolTip="{Binding ReportAudienceDescription}" Margin="0,0,0,6"/>
            </WrapPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Investigație completă (caz)"/>
                <TextBlock Style="{StaticResource PageLeadStyle}" Text="Colectează (sau importă) probele, le parsează, construiește cronologia, corelează și reconstituie lanțul incidentului. Totul se păstrează într-un caz cu amprente de integritate (SHA-256) și cu istoricul fiecărei probe (lanț de custodie)."
/>
            </StackPanel>
        </DockPanel>
            <Border Style="{StaticResource PageRuleStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
        <ctrl:NoDataPanel HideInSimpleLevel="True"/>
        <!-- WP18 S4: "Primește probe de la o stație" in three steps; the full form stays below -->
        <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding IntakeProgress}" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding IntakeStepTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding IntakeQuestion}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IntakeStepIndex}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <!-- 2026-10-22 (row owner decision): where do the samples come from? „This station” is the same collection the Expert form's check box switches on -->
                    <RadioButton GroupName="IntakeSource" Content="Această stație (colectez acum de aici)" IsChecked="{Binding IntakeFromThisStation}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"
                                 AutomationProperties.Name="Probele se colectează de pe această stație"/>
                    <RadioButton GroupName="IntakeSource" Content="Un folder adus de la stația afectată" IsChecked="{Binding IntakeFromFolder}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"
                                 AutomationProperties.Name="Probele vin dintr-un folder adus de la stația afectată"/>
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IntakeFromFolder}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <WrapPanel>
                            <TextBox AutomationProperties.Name="Folderul cu probele aduse" Text="{Binding IntakeFolder, UpdateSourceTrigger=PropertyChanged}" Width="420" Margin="0,0,6,0"/>
                            <Button Content="Alege folderul…" Command="{Binding IntakePickFolderCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IntakeStepIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding IntakeScan.Summary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding IntakeFamilies}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IntakeStepIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <!-- Expert: the full form is below the wizard -->
                    <TextBlock Text="Completați scopul cazului în formularul de mai jos, apoi apăsați „Pornește analiza”." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsExpert, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <!-- Simplu (owner decision 2026-10-22): the wizard is the only form, so the scope of the case is asked here; same fields and rules as the full form -->
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Completați scopul cazului, apoi apăsați „Pornește analiza”. Toate câmpurile sunt obligatorii în afară de numele cazului." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Nume caz (opțional):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox AutomationProperties.Name="Nume caz" Text="{Binding CaseName, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="De ce (scop):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox AutomationProperties.Name="Scopul cazului" Text="{Binding ScopePurpose, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,10,0"/>
                            <TextBlock Text="Cine aprobă:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox AutomationProperties.Name="Aprobator" Text="{Binding ScopeApprover, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="Pe ce sisteme:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox AutomationProperties.Name="Sisteme în scop" Text="{Binding ScopeSystems, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,10,0"/>
                            <TextBlock Text="Perioada de la:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker AutomationProperties.Name="Perioada de la" SelectedDate="{Binding ScopeFrom}" Width="130" Margin="0,0,10,0"/>
                            <TextBlock Text="până la:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker AutomationProperties.Name="Perioada până la" SelectedDate="{Binding ScopeTo}" Width="130"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Temei:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox AutomationProperties.Name="Temei legal" ItemsSource="{Binding LegalBases}" SelectedIndex="{Binding LegalBasisIndex}" Width="100" Margin="0,0,10,0"/>
                            <TextBlock Text="Sistemul este:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox AutomationProperties.Name="Categoria sistemului" ItemsSource="{Binding NetworkCategories}" SelectedIndex="{Binding NetworkIndex}" Width="140" Margin="0,0,6,0"/>
                            <ComboBox AutomationProperties.Name="Nivel de clasificare" ItemsSource="{Binding ClassificationLevels}" SelectedIndex="{Binding ClassificationIndex}" Width="110"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding IntakeError}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Înapoi" Command="{Binding IntakeBackCommand}" IsEnabled="{Binding IntakeCanGoBack}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{Binding IntakeNextText}" AutomationProperties.Name="Înainte sau Pornește analiza" Command="{Binding IntakeNextCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Oprește" Command="{Binding IntakeStopCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="De la început" Command="{Binding IntakeRestartCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Oprește analiza" Command="{Binding CancelCommand}" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                            ToolTip="Oprește analiza care rulează acum; ce s-a colectat până aici rămâne în caz."/>
                </WrapPanel>
                <!-- Simplu: the progress of the run, only when there is something to say (the form's own log box is hidden with the form) -->
                <TextBox AutomationProperties.Name="Jurnalul investigației (progres)" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="110" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="Consolas" FontSize="12" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="8" Margin="0,8,0,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Log}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                <DataTrigger Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>
        </Border>

        <!-- Expert: the full form. Simplu (owner decision 2026-10-22): only the wizard above; the form is hidden, so there are not two parallel forms -->
        <Border Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ObsidianCardStyle}">
                    <Style.Triggers><DataTrigger Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <!-- Evaluation 2026-11-05: wizard and form side by side read as two different flows; they edit the same case -->
                    <TextBlock Text="Formularul complet (aceleași câmpuri ca asistentul de mai sus, plus sursele istorice și copiile de umbră); oricare dintre ele pornește aceeași analiză"
                               TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="Nume caz:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Nume caz" Text="{Binding CaseName, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,10,0"/>
                        <TextBlock Text="Profil:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="Profil de colectare" ItemsSource="{Binding Profiles}" SelectedIndex="{Binding ProfileIndex}" Width="230"/>
                    </WrapPanel>
                    <TextBlock Text="Scopul cazului (obligatoriu): de ce, pentru ce perioadă, pe ce sisteme, cine aprobă" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="Scop:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Scopul cazului" Text="{Binding ScopePurpose, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0,0,10,0"/>
                        <TextBlock Text="Aprobator:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Aprobator" Text="{Binding ScopeApprover, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,10,0"/>
                        <TextBlock Text="Sisteme în scop:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Sisteme în scop" Text="{Binding ScopeSystems, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,10,0"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="Perioada de la:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker AutomationProperties.Name="Perioada de la" SelectedDate="{Binding ScopeFrom}" Width="130" Margin="0,0,10,0"/>
                        <TextBlock Text="până la:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker AutomationProperties.Name="Perioada până la" SelectedDate="{Binding ScopeTo}" Width="130" Margin="0,0,10,0"/>
                        <TextBlock Text="Temei:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="Temei legal" ItemsSource="{Binding LegalBases}" SelectedIndex="{Binding LegalBasisIndex}" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="Sistem:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="Categoria sistemului" ItemsSource="{Binding NetworkCategories}" SelectedIndex="{Binding NetworkIndex}" Width="140" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="Nivel de clasificare" ItemsSource="{Binding ClassificationLevels}" SelectedIndex="{Binding ClassificationIndex}" Width="110"/>
                    </WrapPanel>
                    <CheckBox Content="Colectează de pe această stație (jurnale, Prefetch, SRUM, stare live)" IsChecked="{Binding CollectFromThisStation}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <WrapPanel>
                        <Button Content="Adaugă fișiere de probă…" Command="{Binding AddFilesCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="Adaugă folder de probe…" Command="{Binding AddFolderCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="Golește lista" Command="{Binding ClearFilesCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,16,0"/>
                        <Button Content="Pornește investigația" Command="{Binding RunCommand}" Margin="0,0,6,0"/>
                        <Button Content="Oprește" Command="{Binding CancelCommand}" Style="{StaticResource DangerButtonStyle}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                    <!-- E1 / E10: historical sources and shadow copies as the target of the analysis -->
                    <WrapPanel Margin="0,6,0,0">
                        <Button Content="Adaugă surse istorice (jurnale arhivate, Windows.old)…" Command="{Binding AddHistoricalFolderCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="Listează copiile de umbră (VSS)" Command="{Binding ListShadowCopiesCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                        <ComboBox AutomationProperties.Name="Copia de umbră aleasă" ItemsSource="{Binding ShadowCopyList}" SelectedItem="{Binding SelectedShadowCopy}" DisplayMemberPath="Label" Width="260" Margin="0,0,6,0"/>
                        <Button Content="Analizează copia aleasă" Command="{Binding ImportFromShadowCopyCommand}" Style="{StaticResource OutlineButtonStyle}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ShadowStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ImportFiles.Count, StringFormat='{}{0} fișiere de importat'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <TextBox AutomationProperties.Name="Jurnalul investigației" Grid.Column="2" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="120" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         FontFamily="Consolas" FontSize="12" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="8"/>
            </Grid>
        </Border>
        </StackPanel>

        <!-- Simplu, before the first result: one sentence instead of empty tabs -->
        <TextBlock Grid.Row="2" Text="Rezultatele apar aici după ce porniți investigația." Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="4,8,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"/>
                                <Condition Binding="{Binding HasResult}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TabControl AutomationProperties.Name="Rezultatele investigației" Grid.Row="2" ctrl:PageFill.MinHeight="560" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSimple, Source={x:Static services:LanguageLevelState.Instance}}" Value="True"/>
                                <Condition Binding="{Binding HasResult}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem Header="Lanțul incidentului" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding IntegrityLine}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding VerificationLine}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox AutomationProperties.Name="Text de închidere a cazului" DockPanel.Dock="Top" Text="{Binding ClosureText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource CodeFontFamily}" Margin="0,0,0,8">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClosureText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBox AutomationProperties.Name="Lanțurile incidentului" Text="{Binding Chains, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="12" FontSize="12.5"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Cine ce a făcut" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Cine ce a făcut: constatările pe persoane, în ordinea timpului">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PeopleIntro}" TextWrapping="Wrap" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PeopleStories}" AutomationProperties.Name="Persoanele și ce arată jurnalele pentru fiecare">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Sentence, StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,1"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding OmittedLine}" FontStyle="Italic" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OmittedLine}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Colectări" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Colectări: fișele colectării din caz">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding AcquisitionRunsLine}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DataGrid AutomationProperties.Name="Fișele colectării" ItemsSource="{Binding AcquisitionRuns}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Începută" Binding="{Binding StartLocalText}" Width="120"/>
                            <DataGridTextColumn Header="Încheiată" Binding="{Binding EndLocalText}" Width="120"/>
                            <DataGridTextColumn Header="Stare" Binding="{Binding StateText}" Width="90"/>
                            <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="1.2*"/>
                            <DataGridTextColumn Header="Stație" Binding="{Binding Station}" Width="1.2*"/>
                            <DataGridTextColumn Header="Versiune" Binding="{Binding ApplicationVersion}" Width="90"/>
                            <DataGridTextColumn Header="Colectori" Binding="{Binding CollectorCount}" Width="75"/>
                            <DataGridTextColumn Header="Fișiere" Binding="{Binding ItemCount}" Width="70"/>
                            <DataGridTextColumn Header="Verificare" Binding="{Binding VerificationText}" Width="3*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <DataGrid AutomationProperties.Name="Colectorii colectării" ItemsSource="{Binding Collectors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="24,4,4,8" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Colector" Binding="{Binding Name}" Width="1.5*"/>
                                        <DataGridTextColumn Header="Versiune" Binding="{Binding Version}" Width="80"/>
                                        <DataGridTextColumn Header="Stare" Binding="{Binding StatusText}" Width="90"/>
                                        <DataGridTextColumn Header="Fișiere" Binding="{Binding ItemCount}" Width="70"/>
                                        <DataGridTextColumn Header="Amprentă manifest" Binding="{Binding ManifestShort}" Width="130"/>
                                        <DataGridTextColumn Header="Eroare" Binding="{Binding FirstError}" Width="3*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Constatări" Style="{StaticResource InspectorTabItemStyle}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="120"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="3*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <!-- The grid stays; the card below is the panel of the selected finding (WP6a, U4). -->
                    <DataGrid AutomationProperties.Name="Constatări" Grid.Row="0" ItemsSource="{Binding Findings}" SelectedItem="{Binding SelectedFinding}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severitate" Binding="{Binding Severity, Converter={x:Static local:SeverityTextConverter.Instance}}" Width="110"/>
                            <DataGridTextColumn Header="Ce s-a întâmplat" Binding="{Binding Converter={x:Static local:PlainStoryConverter.Instance}}" Width="460" MinWidth="320"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            <DataGridTextColumn Header="Clasificare" Binding="{Binding Classification, Converter={x:Static local:ClassificationWordingConverter.Instance}}" Width="100"/>
                            <DataGridTextColumn Header="Stare" Binding="{Binding Status, Converter={x:Static local:StandardStateLabelConverter.Instance}}" Width="130"/>
                            <DataGridTextColumn Header="Verificare" Binding="{Binding Verification.State, Converter={x:Static local:StandardStateLabelConverter.Instance}}" Width="120"/>
                            <DataGridTextColumn Header="Prima (UTC)" Binding="{Binding FirstSeenUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="120"/>
                            <DataGridTextColumn Header="Tehnic: regulă" Binding="{Binding RuleId}" Width="170"/>
                            <DataGridTextColumn Header="Tehnic: titlu" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Tehnic: detalii" Binding="{Binding Description}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" AutomationProperties.Name="Separator între lista de constatări și fișa constatării" Focusable="False"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Alegeți o constatare din listă: fișa ei arată de ce a apărut, dovezile, verificarea și ce trebuie făcut. Selectarea nu modifică nimic în caz."
                                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCard}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ctrl:FindingCard DataContext="{Binding SelectedCard}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <!-- Master plan 6.1: the case workflow (stage, people and roles, tasks, decisions on important findings, closure checklist).
                 Every button goes to CaseWorkflow, which checks the role and writes Logs/workflow.jsonl; the status line shows its answer. -->
            <TabItem Header="Flux de lucru" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Flux de lucru: etapa cazului, roluri, sarcini, revizuire și închidere">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="8">
                        <TextBlock Text="{Binding WorkflowStageText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Etapa cazului">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WorkflowProblem}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding WorkflowMe}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"/>
                        <TextBlock Text="Motiv, justificare sau notă (cerut la returnare, redeschidere, anulare și la orice decizie)" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding WorkflowReason, UpdateSourceTrigger=PropertyChanged}" MinHeight="44" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,2,0,8"
                                 AutomationProperties.Name="Motiv sau notă"/>

                        <WrapPanel Margin="0,0,0,12">
                            <TextBlock Text="Etapa următoare:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <ComboBox ItemsSource="{Binding WorkflowNextStages}" SelectedItem="{Binding SelectedNextStage}" MinWidth="140" Margin="0,0,8,0" AutomationProperties.Name="Etapa următoare"/>
                            <Button Content="Mută cazul" Command="{Binding WorkflowMoveCommand}" Padding="14,6" Margin="0,0,8,0" AutomationProperties.Name="Mută cazul în etapa aleasă"/>
                            <Button Content="Închide cazul" Command="{Binding WorkflowCloseCommand}" Padding="14,6" Margin="0,0,8,0" AutomationProperties.Name="Închide cazul după lista de închidere"/>
                            <Button Content="Adaugă nota" Command="{Binding WorkflowAddNoteCommand}" Padding="14,6" Margin="0,0,8,0"/>
                            <Button Content="Reîncarcă" Command="{Binding WorkflowRefreshCommand}" Padding="14,6" AutomationProperties.Name="Reîncarcă fluxul de lucru"/>
                        </WrapPanel>
                        <!-- the answer sits right under the buttons (lab 2026-11-07: above the reason box it scrolled out of view at 1024 px) -->
                        <TextBlock Text="{Binding WorkflowStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource EvidenceAccentBrush}" Margin="0,-4,0,12"
                                   AutomationProperties.Name="Răspunsul fluxului de lucru" AutomationProperties.LiveSetting="Polite"/>

                        <TextBlock Text="Lista de închidere" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding WorkflowChecklistLine}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,4"/>
                        <DataGrid AutomationProperties.Name="Lista de închidere" ItemsSource="{Binding WorkflowChecklist}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="260" Margin="0,0,0,12">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Fail"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rezultat" Binding="{Binding Status, Converter={x:Static local:ChecklistStatusTextConverter.Instance}}" Width="90"/>
                                <DataGridTextColumn Header="Condiție" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Detalii" Binding="{Binding Detail}" Width="3*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Constatări importante: decizia revizorului" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <WrapPanel Margin="0,4,0,4">
                            <ComboBox ItemsSource="{Binding WorkflowDecisionNames}" SelectedIndex="{Binding SelectedDecision}" MinWidth="200" Margin="0,0,8,0" AutomationProperties.Name="Decizia pentru constatare"/>
                            <Button Content="Înregistrează decizia" Command="{Binding WorkflowReviewCommand}" Padding="14,6" AutomationProperties.Name="Înregistrează decizia pentru constatarea aleasă"/>
                        </WrapPanel>
                        <DataGrid AutomationProperties.Name="Constatări de revizuit" ItemsSource="{Binding WorkflowReviews}" SelectedItem="{Binding SelectedWorkflowReview}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" SelectionMode="Single" MaxHeight="260" Margin="0,0,0,12">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Pending}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Severitate" Binding="{Binding SeverityText}" Width="90"/>
                                <DataGridTextColumn Header="Constatare" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Decizie" Binding="{Binding DecisionText}" Width="2*"/>
                                <DataGridTextColumn Header="Revizor" Binding="{Binding Reviewer}" Width="110"/>
                                <DataGridTextColumn Header="Cod" Binding="{Binding FindingId}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Participanți și roluri" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding WorkflowParticipants}" Margin="0,4,0,6" AutomationProperties.Name="Participanții cazului">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Cont (gol = contul dumneavoastră)" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding NewParticipantAccount, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,4" AutomationProperties.Name="Contul participantului"/>
                                <WrapPanel>
                                    <ComboBox ItemsSource="{Binding WorkflowRoleNames}" SelectedIndex="{Binding NewParticipantRole}" MinWidth="120" Margin="0,0,8,0" AutomationProperties.Name="Rolul participantului"/>
                                    <Button Content="Adaugă participant" Command="{Binding WorkflowAddParticipantCommand}" Padding="12,6"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sarcini" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <DataGrid AutomationProperties.Name="Sarcinile cazului" ItemsSource="{Binding WorkflowTasks}" SelectedItem="{Binding SelectedWorkflowTask}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" SelectionMode="Single" MaxHeight="200" Margin="0,4,0,4">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Cod" Binding="{Binding TaskId}" Width="55"/>
                                        <DataGridTextColumn Header="Sarcina" Binding="{Binding Title}" Width="3*"/>
                                        <DataGridTextColumn Header="Atribuită" Binding="{Binding Assignee}" Width="*"/>
                                        <DataGridTextColumn Header="Stare" Binding="{Binding Status, Converter={x:Static local:TaskStatusTextConverter.Instance}}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Titlul sarcinii noi"/>
                                    <TextBox Grid.Column="2" Text="{Binding NewTaskAssignee, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cui se atribuie sarcina"/>
                                </Grid>
                                <WrapPanel Margin="0,4,0,0">
                                    <Button Content="Adaugă sarcina" Command="{Binding WorkflowAddTaskCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Content="Sarcină făcută" Command="{Binding WorkflowTaskDoneCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Content="Anulează sarcina" Command="{Binding WorkflowTaskCancelCommand}" Padding="12,6"/>
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Istoricul fluxului (din jurnalul înlănțuit, cel mai nou primul)" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <DataGrid AutomationProperties.Name="Istoricul fluxului de lucru" ItemsSource="{Binding WorkflowHistory}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="240" Margin="0,4,0,0">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding What}"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Când" Binding="{Binding WhenLocal}" Width="120"/>
                                <DataGridTextColumn Header="Cine" Binding="{Binding Actor}" Width="110"/>
                                <DataGridTextColumn Header="Ce" Binding="{Binding What}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Master plan 6.4: coverage in time: one row per source, one cell per day; silent stretches inside activity are candidate gaps -->
            <TabItem Header="Acoperire în timp" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Acoperire în timp: ce sursă a scris în ce zi">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CoverageLine}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,2"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CoverageAxis}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding CoverageGapLines}" MaxHeight="120" Margin="0,6,0,0" AutomationProperties.Name="Lacune posibile în acoperire">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CoverageRows}" AutomationProperties.Name="Harta acoperirii pe surse și zile">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1" AutomationProperties.Name="{Binding Source}">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Source}" Width="190" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" ToolTip="{Binding Source}"/>
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Totals}" Width="70" TextAlignment="Right" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="9" Height="16" Margin="0,0,1,0" ToolTip="{Binding Tooltip}"
                                                            Background="{Binding Level, Converter={x:Static local:CoverageLevelBrushConverter.Instance}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsGap}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/><Setter Property="BorderThickness" Value="1.5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <!-- Master plan 6.8: rule lab: test a rule on this case as the engine would load it, compare with a reference version, add to the case's rules -->
            <TabItem Header="Laborator de reguli" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Laborator de reguli: testează o regulă pe acest caz">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <ComboBox ItemsSource="{Binding RuleKinds}" SelectedIndex="{Binding RuleKindIndex}" MinWidth="140" Margin="0,0,6,0" AutomationProperties.Name="Tipul regulii"/>
                        <TextBlock Text="Nume:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,8,0" AutomationProperties.Name="Numele regulii"/>
                        <Button Content="Testează pe acest caz" Command="{Binding TestRuleCommand}" Padding="12,4" Margin="0,0,6,0" AutomationProperties.Name="Testează regula pe acest caz"/>
                        <Button Content="Păstrează ca referință" Command="{Binding SaveRuleBaselineCommand}" Padding="12,4" Margin="0,0,6,0"/>
                        <Button Content="Compară cu referința" Command="{Binding CompareRuleWithBaselineCommand}" Padding="12,4" Margin="0,0,6,0"/>
                        <Button Content="Adaugă în regulile cazului" Command="{Binding AddRuleToCaseCommand}" Padding="12,4" AutomationProperties.Name="Adaugă regula în regulile cazului"/>
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding RuleLabSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource EvidenceAccentBrush}"/>
                                <Style.Triggers><DataTrigger Binding="{Binding RuleLabProblem}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding RuleText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="200" AutomationProperties.Name="Textul regulii"/>
                        <ListBox Grid.Column="2" ItemsSource="{Binding RuleLabLines}" AutomationProperties.Name="Rezultatul testului regulii"/>
                    </Grid>
                </DockPanel>
            </TabItem>
            <!-- Master plan 6.7: the evidence files that are Windows programs, read statically, with the station's signature check -->
            <TabItem Header="Executabile" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Executabile: programele dintre probe, citite fără să fie rulate">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PeLine}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding PeRows}" SelectedItem="{Binding SelectedPe}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                              MaxHeight="160" Margin="0,0,0,6" AutomationProperties.Name="Executabilele dintre probe">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="AutomationProperties.Name" Value="{Binding OriginalName}"/></Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fișier" Binding="{Binding OriginalName}" Width="2*"/>
                            <DataGridTextColumn Header="Arhitectură" Binding="{Binding Report.Machine}" Width="80"/>
                            <DataGridTextColumn Header="Semnătură" Binding="{Binding SignatureStatus}" Width="2*"/>
                            <DataGridTextColumn Header="Indicatori" Binding="{Binding Report.Indicators.Count}" Width="75"/>
                            <DataGridTextColumn Header="Probă" Binding="{Binding EvidenceId}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <ListBox ItemsSource="{Binding PeDetail}" AutomationProperties.Name="Fișa executabilului ales" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <!-- Master plan 6.10: identities keyed by SID, host-scoped sessions, directory and GPO changes, and what the logs cannot show. -->
            <TabItem Header="Identități" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Identități: conturile după SID, sesiunile lor, modificările de director și lacunele">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding IdentityLine}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" AutomationProperties.Name="Starea identităților"/>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding IdentityGaps}" Margin="0,0,0,4" AutomationProperties.Name="Lacunele reconstituirii identităților">
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox DockPanel.Dock="Top" Content="Doar conturile privilegiate" IsChecked="{Binding IdentityPrivilegedOnly}" Margin="0,0,0,4" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Expander DockPanel.Dock="Bottom" Header="Modificări de director și de politici de grup (GPO)" Margin="0,6,0,0" AutomationProperties.Name="Modificări de director și de politici de grup (GPO)">
                        <ListBox ItemsSource="{Binding IdentityDirectory}" MaxHeight="140" AutomationProperties.Name="Lista modificărilor de director" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0" Margin="0,0,8,0">
                            <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding IdentityRows}" SelectedItem="{Binding SelectedIdentity}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                  MaxHeight="170" Margin="0,0,0,6" AutomationProperties.Name="Identitățile din caz">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/></Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cont" Binding="{Binding DisplayName}" Width="2*"/>
                                <DataGridTextColumn Header="Nume în timp" Binding="{Binding NameHistory}" Width="2*"/>
                                <DataGridTextColumn Header="SID" Binding="{Binding Sid}" Width="3*"/>
                                <DataGridCheckBoxColumn Header="Privilegiat" Binding="{Binding Privileged}" Width="75"/>
                                <DataGridTextColumn Header="Reușite" Binding="{Binding Logons}" Width="60"/>
                                <DataGridTextColumn Header="Eșuate" Binding="{Binding FailedLogons}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ListBox ItemsSource="{Binding IdentityDetail}" AutomationProperties.Name="Fișa identității alese: nume, sesiuni și activitate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        </DockPanel>
                        <DockPanel Grid.Column="1" AutomationProperties.Name="Calea contului ales: stație, sesiune, proces, resursă">
                            <TextBlock DockPanel.Dock="Top" Text="Calea contului: stație → sesiune → proces → resursă" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding IdentityPathLine}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4" AutomationProperties.Name="Cum se fac legăturile căii"/>
                            <TreeView ItemsSource="{Binding IdentityPathRoots}" FontFamily="{StaticResource UiFontFamily}" FontSize="{StaticResource FontSizeDense}" AutomationProperties.Name="Arborele căii contului">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" ToolTip="{Binding Reason}" AutomationProperties.Name="{Binding Text}">
                                        <Run Text="{Binding Text, Mode=OneWay}"/><Run Text="{Binding Suffix, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
            <!-- Master plan 6.6: the approved Volatility 3 run on a memory image of the case (pinned executable and symbols, offline, outputs as derived evidence). -->
            <TabItem Header="Memorie (Volatility)" Style="{StaticResource InspectorTabItemStyle}" AutomationProperties.Name="Memorie: rulează Volatility aprobat pe o imagine de memorie din caz">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding MemoryToolLine}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" AutomationProperties.Name="Starea uneltei Volatility"/>
