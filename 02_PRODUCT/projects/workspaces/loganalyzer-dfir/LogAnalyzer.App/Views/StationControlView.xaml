<UserControl x:Class="LogAnalyzer.UI.Views.StationControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LogAnalyzer.UI.Views"
             xmlns:ctrl="clr-namespace:LogAnalyzer.UI.Views.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Verifică această stație" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Conturi, politici, autentificări, suporturi USB, rețele și programe instalate. Aplicația doar citește; nu modifică nimic pe stație."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" MaxWidth="900" HorizontalAlignment="Left">
            <ctrl:NoDataPanel/>
        <!-- WP18 S4: the guided control in three steps -->
        <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FlowProgress}" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FlowStepTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding FlowQuestion}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,8"/>

                <!-- step 1: the station -->
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FlowStepIndex}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding StationLine}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding PreviousNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <CheckBox Content="Stația trebuie să fie izolată (fără rețea)" IsChecked="{Binding StationShouldBeIsolated}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <!-- step 2: the period -->
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FlowStepIndex}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <WrapPanel>
                        <ComboBox AutomationProperties.Name="Perioada controlului" ItemsSource="{Binding PeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Choice" SelectedValue="{Binding PeriodChoice}" Width="220" Margin="0,0,10,0"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Zile în urmă:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox AutomationProperties.Name="Zile în urmă" Text="{Binding CustomDays, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding PeriodNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- step 3: the procedures, the inspector, then start -->
                <StackPanel>
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FlowStepIndex}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding ProfileLine}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding ProfileSections}" Margin="0,4,0,6">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,2"/></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <TextBlock Text="Cine controlează:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Cine controlează" Text="{Binding Inspector, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,16,0"/>
                        <TextBlock Text="Observații:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Observații" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="260"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Funcția:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Funcția celui care controlează" Text="{Binding InspectorFunction, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,16,0"/>
                        <TextBlock Text="Număr de înregistrare:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Număr de înregistrare" Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Width="120" Margin="0,0,16,0"/>
                        <TextBlock Text="Marcaj (nivel):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox AutomationProperties.Name="Marcajul raportului, introdus manual" Text="{Binding MarkingLevel, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding MarkingNote}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding FlowError}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Înapoi" Command="{Binding FlowBackCommand}" IsEnabled="{Binding FlowCanGoBack}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="{Binding FlowNextText}" AutomationProperties.Name="Înainte sau Pornește controlul" Command="{Binding FlowNextCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="Oprește" Command="{Binding FlowStopCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                </WrapPanel>
                <DockPanel Margin="0,8,0,0">
                    <ProgressBar DockPanel.Dock="Left" Width="120" Height="4" IsIndeterminate="True" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- WP18 S4: the single result screen (five answers); never SAFE -->
        <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,12" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding Result.Headline}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <StackPanel Margin="0,0,6,6"><TextBlock Text="Există o problemă?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Result.Problem}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel>
                    <StackPanel Margin="6,0,0,6"><TextBlock Text="Cât de grav?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Result.Seriousness}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="Sunt probele de încredere?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Result.Trust}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel>
                    <StackPanel Margin="6,0,0,0"><TextBlock Text="Ce s-a găsit?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding Result.Found}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/></StackPanel>
                </UniformGrid>
                <TextBlock Text="Ce urmează?" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding ResultNextSteps}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Result.CoverageLine}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Raport pentru proces-verbal (PDF)" Command="{Binding SaveReportCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,6"/>
                    <Button Content="Compară cu controlul anterior" Command="{Binding CompareWithPreviousCommand}" Margin="0,0,8,6"/>
                    <Button Content="Deschide folderul rapoartelor" Command="{Binding OpenCaseFolderCommand}" Margin="0,0,8,6"/>
                    <Button Content="Control nou" Command="{Binding FlowRestartCommand}" Margin="0,0,8,6"/>
                </WrapPanel>
                <Border Visibility="{Binding HasSavedReport, Converter={StaticResource BoolToVis}}" Background="{StaticResource CanvasBrush}" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                    <TextBox Text="{Binding SavedReportInfo, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MinHeight="0"
                             Foreground="{StaticResource TextPrimaryBrush}" AutomationProperties.Name="Confirmarea salvării raportului: loc, amprentă și pașii următori"/>
                </Border>
                <Expander Header="Diferențe față de controlul anterior" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0">
                    <DataGrid AutomationProperties.Name="Diferențe față de controlul anterior" ItemsSource="{Binding ComparisonChanges}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ce s-a schimbat" Binding="{Binding Kind}" Width="110"/>
                            <DataGridTextColumn Header="Cod" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Verificare" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Înainte" Binding="{Binding BeforeText}" Width="110"/>
                            <DataGridTextColumn Header="Acum" Binding="{Binding AfterText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
            </StackPanel>
        </Border>

        <!-- Parameters (the raw form stays under "Avansat") -->
        <Expander Header="Avansat (parametrii controlului)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12">
        <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,6,0,0">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Perioada (zile în urmă):" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox AutomationProperties.Name="Perioada în zile" Text="{Binding PeriodDays, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,16,0"/>
                <CheckBox Content="Stația trebuie să fie izolată (fără rețea)" IsChecked="{Binding StationShouldBeIsolated}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Text="Verificator:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox AutomationProperties.Name="Verificator" Text="{Binding Inspector, UpdateSourceTrigger=PropertyChanged}" Width="170" Margin="0,0,16,0"/>
                <TextBlock Text="Observații:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox AutomationProperties.Name="Observații" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,16,0"/>
                <Button Content="Rulează controlul" Command="{Binding RunCommand}" Style="{StaticResource AccentButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Salvează raportul (PDF)" Command="{Binding SaveReportCommand}" Style="{StaticResource OutlineButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Folder rapoarte" Command="{Binding OpenCaseFolderCommand}" Style="{StaticResource OutlineButtonStyle}"/>
            </WrapPanel>
        </Border>
        </Expander>

        <!-- Register of offline updates (control research P5): compared with the installed updates by check S04 -->
        <Expander Header="Registrul actualizărilor offline (actualizările aduse pe stație pe un suport)" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                  AutomationProperties.HelpText="Fiecare actualizare Windows, antivirus sau de aplicație adusă pe stație se trece aici. Controlul stației compară actualizările instalate în perioadă cu acest registru.">
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,6,0,0" Height="460">
                <local:RegisterView DataContext="{Binding UpdateRegister}"/>
            </Border>
        </Expander>
        </StackPanel>

        <TabControl Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TabItem Header="Verificări" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ComboBox AutomationProperties.Name="Filtru după rezultat" DockPanel.Dock="Right" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" Width="160"/>
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
                        <!-- list (owner 2026-10-11: every code explained on screen; list on the left, explanation on the right) -->
                        <DataGrid AutomationProperties.Name="Verificările controlului" ItemsSource="{Binding Checks}" SelectedItem="{Binding SelectedCheck}" SelectionMode="Single"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" ToolTip="Dați clic pe o verificare: în dreapta apare ce înseamnă, pe înțeles.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rezultat" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="Cod" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Verificare" Binding="{Binding Title}" Width="2*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Ce s-a găsit" Binding="{Binding Detail}" Width="3*">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Explicația verificării alese">
                            <StackPanel Margin="8,0,4,0">
                                <TextBlock Text="Dați clic pe o verificare din listă ca să vedeți ce înseamnă." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           Visibility="{Binding HasSelectedCheck, Converter={StaticResource InverseBoolToVis}}"/>
                                <StackPanel DataContext="{Binding SelectedExplanation}" Visibility="{Binding DataContext.HasSelectedCheck, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}">
                                        <Run Text="{Binding Check.Id, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Check.Title, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding StatusMeaning}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>

                                    <TextBlock Text="Ce verificăm" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0"/>
                                    <TextBlock Text="{Binding Guide.What}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="De ce contează" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Guide.Why}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Cum a verificat aplicația" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Guide.How}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Ce s-a găsit" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Check.Detail}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Cum se citește rezultatul" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding Guide.Meaning}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Ce faceți" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding NextStep}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Text="Codurile care apar, pe înțeles" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,2"/>
                                    <ItemsControl ItemsSource="{Binding Codes}" AutomationProperties.Name="Codurile explicate">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"><Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Kind, StringFormat='({0})', Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/></TextBlock>
                                                    <TextBlock Text="{Binding What}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Why, StringFormat='De ce contează: {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding When}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Expander AutomationProperties.Name="Probele verificării" Header="{Binding Check.Evidence.Count}" HeaderStringFormat="Probele ({0} înregistrări)" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Guide.Source, StringFormat='Sursa tehnică: {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Check.Evidence}">
                                                <ItemsControl.ItemTemplate><DataTemplate><TextBox AutomationProperties.Name="O probă" Text="{Binding Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                    <Button Content="Copiază explicația (pentru procesul-verbal)" Command="{Binding DataContext.CopyExplanationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Verificări făcute de dumneavoastră" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Aceste lucruri nu se pot verifica din calculator. Uitați-vă și răspundeți; răspunsurile intră în raportul pentru procesul-verbal. „Nu am putut verifica” este un răspuns valid și apare ca atare în raport."
                                   TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ManualSummary}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ManualItems}" AutomationProperties.Name="Verificări făcute de controlor">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"><Run Text="{Binding Check.Id, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Check.Question, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Text="{Binding Check.Why, StringFormat='De ce contează: {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Check.How, StringFormat='Cum verificați: {0}'}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Check.ComparedWith, StringFormat='Comparați cu: {0}'}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <RadioButton Content="Da" GroupName="{Binding GroupName}" IsChecked="{Binding IsYes}" Margin="0,0,16,0"/>
                                                <RadioButton Content="NU" GroupName="{Binding GroupName}" IsChecked="{Binding IsNo}" Margin="0,0,16,0"/>
                                                <RadioButton Content="Nu am putut verifica" GroupName="{Binding GroupName}" IsChecked="{Binding IsCannot}" Margin="0,0,16,0"/>
                                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="360" AutomationProperties.Name="Observație la această verificare"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <TabItem Header="Utilizatori" Style="{StaticResource InspectorTabItemStyle}">
                <DataGrid AutomationProperties.Name="Activitatea utilizatorilor" Margin="8" ItemsSource="{Binding Users}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Utilizator" Binding="{Binding User}" Width="2*"/>
                        <DataGridTextColumn Header="Autentificări locale" Binding="{Binding InteractiveLogons}" Width="*"/>
                        <DataGridTextColumn Header="Acces de la distanță (RDP)" Binding="{Binding RemoteLogons}" Width="*"/>
                        <DataGridTextColumn Header="Eșuate" Binding="{Binding FailedLogons}" Width="*"/>
                        <DataGridTextColumn Header="Sesiuni privilegiate" Binding="{Binding PrivilegedSessions}" Width="*"/>
                        <DataGridTextColumn Header="Modificări făcute" Binding="{Binding AccountChangesMade}" Width="*"/>
                        <DataGridTextColumn Header="Prima (UTC)" Binding="{Binding FirstLogonUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.3*"/>
                        <DataGridTextColumn Header="Ultima (UTC)" Binding="{Binding LastLogonUtc, StringFormat='yyyy-MM-dd HH:mm'}" Width="1.3*"/>
                        <DataGridTextColumn Header="Surse la distanță" Binding="{Binding RemoteSources, Converter={x:Static local:JoinConverter.Instance}}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Cronologia acțiunilor" Style="{StaticResource InspectorTabItemStyle}">
                <DockPanel Margin="8">
                    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="190" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Dați clic pe un rând ca să vedeți ce înseamnă codul din coloana „Probă”." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding SelectedActionCodes}" AutomationProperties.Name="Explicația probei alese">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"><Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding What, Mode=OneWay}"/> <Run Text="{Binding Why, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/> <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <DataGrid AutomationProperties.Name="Cronologia acțiunilor" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}" SelectionMode="Single" ToolTip="Dați clic pe un rând: dedesubt apare ce înseamnă codul din coloana Probă." AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ora (UTC)" Binding="{Binding TimeUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="140"/>
                        <DataGridTextColumn Header="Cine" Binding="{Binding Who}" Width="1.3*"/>
                        <DataGridTextColumn Header="Ce" Binding="{Binding Action}" Width="1.5*"/>
                        <DataGridTextColumn Header="Detalii" Binding="{Binding Detail}" Width="3*"/>
                        <DataGridTextColumn Header="Probă" Binding="{Binding Source}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding GapsText}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
