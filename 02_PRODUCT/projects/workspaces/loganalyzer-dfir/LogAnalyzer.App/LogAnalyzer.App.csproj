<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LogAnalyzer</AssemblyName>
    <RootNamespace>LogAnalyzer.UI</RootNamespace>
    <!-- UNCLASSIFIED edition (P2/P3): one executable, air-gapped or connected. The mode comes only from a signed policy file
         (Edition/Unclassified/UnclassifiedComposition.cs). The classified edition is LogAnalyzer.App.Classified, which shares
         the UI sources of this project but not the Connectors / Response / Ai assemblies (docs/dfir/EDITIONS.md). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogAnalyzer.Core\LogAnalyzer.Core.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Infrastructure\LogAnalyzer.Infrastructure.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Dfir.Windows\LogAnalyzer.Dfir.Windows.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Connectors\LogAnalyzer.Connectors.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Response\LogAnalyzer.Response.csproj" />
    <ProjectReference Include="..\LogAnalyzer.Ai\LogAnalyzer.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Public key (base64 SPKI, ECDSA P-256) that verifies the edition policy. Absent: no policy can be valid, the app stays air-gapped. -->
    <EmbeddedResource Include="Edition\Unclassified\edition-policy-public-key.b64" LogicalName="edition-policy-public-key.b64"
                      Condition="Exists('Edition\Unclassified\edition-policy-public-key.b64')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="QuestPDF" Version="2026.7.2" />
    <PackageReference Include="DiscUtils.Registry" Version="0.16.13" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.10" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Categories\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
