<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Date fields, "Dosar" theme (2026-11-11). Colours, border and height only: the Fluent template is kept (it has the calendar glyph, the popup and
        PART_Button, which DatePickerNames.Apply names for screen readers), so no behaviour changes. App.xaml adds the Romanian Language on top.
    -->
    <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>

