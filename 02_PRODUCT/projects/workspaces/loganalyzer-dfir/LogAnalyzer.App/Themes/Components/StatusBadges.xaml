<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Outlined / Solid Severity Badges -->
    <Style x:Key="BadgeCriticalStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BadgeCriticalBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CriticalBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="BadgeHighStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BadgeHighBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource HighBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="BadgeMediumStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BadgeMediumBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MediumBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="BadgeSuccessStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BadgeSuccessBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="BadgeEvidenceStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BadgeEvidenceBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource EvidenceAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

</ResourceDictionary>