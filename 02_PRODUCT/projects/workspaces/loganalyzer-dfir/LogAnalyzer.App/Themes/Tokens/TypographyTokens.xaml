<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Fonts -->
    <FontFamily x:Key="UiFontFamily">Segoe UI, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Mono, Consolas, JetBrains Mono, monospace</FontFamily>

    <!-- Font Size Scale -->
    <sys:Double x:Key="FontSizeDisplay">26</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">16</sys:Double>
    <sys:Double x:Key="FontSizePanelTitle">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeDense">13</sys:Double>
    <sys:Double x:Key="FontSizeMetadata">12</sys:Double>
    <sys:Double x:Key="FontSizeBadge">12</sys:Double>

</ResourceDictionary>