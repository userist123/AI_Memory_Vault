<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Fonts -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Display, Segoe UI, Inter, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Mono, Consolas, JetBrains Mono, monospace</FontFamily>

    <!-- Font Size Scale -->
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">16</sys:Double>
    <sys:Double x:Key="FontSizePanelTitle">13</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeDense">12</sys:Double>
    <sys:Double x:Key="FontSizeMetadata">11</sys:Double>
    <sys:Double x:Key="FontSizeBadge">10.5</sys:Double>

</ResourceDictionary>