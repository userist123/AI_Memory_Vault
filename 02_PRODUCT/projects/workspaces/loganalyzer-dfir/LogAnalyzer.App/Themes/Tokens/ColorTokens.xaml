<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        "Registru" theme (WP18, owner request 2026-10-11): a sober administrative look, paper-like surfaces, dark ink text, one ink-blue
        accent, no glow and no neon. Severity colours are deep enough to keep contrast on white and to survive black-and-white printing
        next to their words and icons (status is never colour only). Brush keys are unchanged so every view follows the theme.
    -->

    <!-- Surfaces -->
    <Color x:Key="CanvasColor">#F2F2EE</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource CanvasColor}"/>

    <Color x:Key="WorkspaceColor">#F4F4F1</Color>
    <SolidColorBrush x:Key="WorkspaceBrush" Color="{StaticResource WorkspaceColor}"/>

    <!-- sidebar and header bands -->
    <Color x:Key="Surface1Color">#E9EAE4</Color>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface1Color}"/>

    <!-- cards, inputs, grids -->
    <Color x:Key="Surface2Color">#FFFFFF</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>

    <!-- hover, selected rows, pressed -->
    <Color x:Key="Surface3Color">#E3E6EA</Color>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>

    <Color x:Key="ElevatedPanelColor">#FBFBF9</Color>
    <SolidColorBrush x:Key="ElevatedPanelBrush" Color="{StaticResource ElevatedPanelColor}"/>

    <!-- Borders -->
    <Color x:Key="HairlineBorderColor">#D3D5CE</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource HairlineBorderColor}"/>
    <SolidColorBrush x:Key="HairlineBorderBrush" Color="{StaticResource HairlineBorderColor}"/>

    <Color x:Key="StrongBorderColor">#A9ADA5</Color>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}"/>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#1C2024</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>

    <Color x:Key="TextSecondaryColor">#454B52</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="TextMutedColor">#61676E</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <Color x:Key="TextDisabledColor">#9A9FA4</Color>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <Color x:Key="CodeTextColor">#1C2024</Color>
    <SolidColorBrush x:Key="CodeTextBrush" Color="{StaticResource CodeTextColor}"/>

    <!-- Severity and state (dark enough for text on white) -->
    <Color x:Key="CriticalColor">#A3201C</Color>
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource CriticalColor}"/>

    <Color x:Key="HighColor">#A84B0C</Color>
    <SolidColorBrush x:Key="HighBrush" Color="{StaticResource HighColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource HighColor}"/>

    <Color x:Key="MediumColor">#7A5D00</Color>
    <SolidColorBrush x:Key="MediumBrush" Color="{StaticResource MediumColor}"/>

    <Color x:Key="LowColor">#285F7E</Color>
    <SolidColorBrush x:Key="LowBrush" Color="{StaticResource LowColor}"/>

    <Color x:Key="SuccessColor">#2E6638</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <!-- Accent: one ink blue; the other accent keys map to quiet variants -->
    <Color x:Key="PrimaryAccentColor">#1F4A73</Color>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>

    <Color x:Key="EvidenceAccentColor">#4F4677</Color>
    <SolidColorBrush x:Key="EvidenceAccentBrush" Color="{StaticResource EvidenceAccentColor}"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource EvidenceAccentColor}"/>

    <Color x:Key="CyanAccentColor">#285F7E</Color>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="{StaticResource CyanAccentColor}"/>
    <SolidColorBrush x:Key="CyberBlueBrush" Color="{StaticResource CyanAccentColor}"/>

    <!-- Badge tints and overlays -->
    <SolidColorBrush x:Key="BadgeCriticalBgBrush" Color="#F6E1DF"/>
    <SolidColorBrush x:Key="BadgeHighBgBrush" Color="#F7E7DA"/>
    <SolidColorBrush x:Key="BadgeMediumBgBrush" Color="#F3ECD3"/>
    <SolidColorBrush x:Key="BadgeLowBgBrush" Color="#DFEAF1"/>
    <SolidColorBrush x:Key="BadgeSuccessBgBrush" Color="#DFEEE1"/>
    <SolidColorBrush x:Key="BadgeEvidenceBgBrush" Color="#E7E4F0"/>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#991C2024"/>

</ResourceDictionary>
