<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Subdued, Professional Drop Shadows (x:Shared="False" prevents WPF DependencyProperty.UnsetValue in Style Setters) -->
    <DropShadowEffect x:Key="CardShadow" x:Shared="False" Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.06" BlurRadius="4"/>
    <DropShadowEffect x:Key="ModalShadow" x:Shared="False" Color="#000000" Direction="270" ShadowDepth="4" Opacity="0.06" BlurRadius="4"/>
    <DropShadowEffect x:Key="AccentGlow" x:Shared="False" Color="#000000" Direction="0" ShadowDepth="0" Opacity="0.06" BlurRadius="4"/>
    <DropShadowEffect x:Key="EvidenceGlow" x:Shared="False" Color="#000000" Direction="0" ShadowDepth="0" Opacity="0.06" BlurRadius="4"/>

</ResourceDictionary>