<Window x:Class="RegistruTransferuri.UI.DesignPreview.ControlGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ OBSIDIAN TACTICAL COMMAND — CONTROL GALLERY (SARCINA 2 PREVIEW)"
        Width="1080" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="🎨 Control Gallery &amp; State Validation Preview" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Verifică stările: Default, Hover, Focus, Disabled, Error, PasswordBox PIN și DataGrid" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20" />

            <!-- Buttons Section -->
            <GroupBox Header="1. Butoane Tactice (Primary, Secondary, Danger, Disabled)" Style="{StaticResource TacticalGroupBoxStyle}">
                <WrapPanel Margin="4">
                    <Button Content="Primary Action" Width="140" Margin="0,0,10,10" Style="{StaticResource TacticalPrimaryButtonStyle}" />
                    <Button Content="Secondary Action" Width="140" Margin="0,0,10,10" Style="{StaticResource TacticalSecondaryButtonStyle}" />
                    <Button Content="Danger / Sanitizare" Width="150" Margin="0,0,10,10" Style="{StaticResource TacticalDangerButtonStyle}" />
                    <Button Content="Disabled State" Width="130" Margin="0,0,10,10" IsEnabled="False" Style="{StaticResource TacticalPrimaryButtonStyle}" />
                </WrapPanel>
            </GroupBox>

            <!-- Inputs Section -->
            <GroupBox Header="2. Inputuri Text, PIN &amp; ComboBox Custom" Style="{StaticResource TacticalGroupBoxStyle}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock Text="TextBox Activ (Caret Cyber Blue):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="MAPN-2026-S-0001" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,12">
                        <TextBlock Text="PasswordBox PIN (Centrat 18px):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <PasswordBox Password="123456" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,12">
                        <TextBlock Text="ComboBox Custom (Fără Aero Chrome):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox SelectedIndex="0">
                            <ComboBoxItem Content="STRICT SECRET DE IMPORTANȚĂ DEOSEBITĂ" />
                            <ComboBoxItem Content="STRICT SECRET" />
                            <ComboBoxItem Content="SECRET" />
                            <ComboBoxItem Content="SECRET DE SERVICIU" />
                            <ComboBoxItem Content="NECLASIFICAT" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="TextBox Read-Only:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="Hash SHA-256 Imuabil" IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="TextBox Disabled:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="Dezactivat" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- DataGrid Preview -->
            <GroupBox Header="3. DataGrid Tactic (RowHeight=40, Alternanță #080C14 / #121A2D, Highlight #3B2677)" Style="{StaticResource TacticalGroupBoxStyle}">
                <DataGrid Height="160" Style="{StaticResource TacticalDataGridStyle}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nr. Înregistrare" Width="160" />
                        <DataGridTextColumn Header="Nivel Clasificare" Width="140" />
                        <DataGridTextColumn Header="Sursă" Width="*" />
                        <DataGridTextColumn Header="Status" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</Window>
