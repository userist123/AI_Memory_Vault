{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Book knowledge atom V1",
  "type": "object",
  "required": [
    "id",
    "type",
    "statement",
    "status",
    "sources",
    "relations",
    "verification_status",
    "verification_required",
    "utility_score",
    "reuse_probability",
    "stability",
    "misleading_risk",
    "limitations",
    "temporal_validity",
    "cluster_id"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "enum": [
        "SYNTHESIS",
        "SINGLE_SOURCE"
      ]
    },
    "statement": {
      "type": "string"
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "CONFLICTING",
        "CROSS_SOURCE_SUPPORTED",
        "NEEDS_VERIFICATION",
        "READY_FOR_HUMAN_REVIEW",
        "REJECTED",
        "SOURCE_SUPPORTED"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1
    },
    "relations": {
      "type": "array"
    },
    "verification_status": {
      "enum": [
        "CANDIDATE",
        "CONFLICTING",
        "CROSS_SOURCE_SUPPORTED",
        "NEEDS_VERIFICATION",
        "READY_FOR_HUMAN_REVIEW",
        "REJECTED",
        "SOURCE_SUPPORTED"
      ]
    },
    "verification_required": {
      "const": true
    },
    "utility_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reuse_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "stability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "misleading_risk": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array"
    },
    "temporal_validity": {
      "type": "string"
    },
    "cluster_id": {
      "type": "string"
    }
  }
}
