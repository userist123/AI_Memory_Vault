# Deployment-owned directory containing app_settings.json and optional app_settings.local.json.

## For OIDC authorization
# ADMIN_BFF_CONFIG_DIR=./config
# ADMIN_BFF_AUTH_MODE=oidc
# ADMIN_BFF_HTTP_HOST=127.0.0.1
# ADMIN_BFF_HTTP_PORT=3001
# ADMIN_BFF_ADMIN_SHELL_VERSION=1.0.0
# ADMIN_BFF_ADMIN_MANIFESTS_JSON=[]

# ADMIN_BFF_AUTH_ISSUER=https://issuer.example.com
# ADMIN_BFF_AUTH_JWKS_URI=https://issuer.example.com/.well-known/jwks.json
# ADMIN_BFF_AUTH_AUDIENCES_JSON=["https://admin-api.example.com"]
# ADMIN_BFF_AUTH_ALLOWED_ALGORITHMS_JSON=["RS256"]

# ADMIN_BFF_OIDC_AUTHORIZATION_ENDPOINT=https://issuer.example.com/authorize
# ADMIN_BFF_OIDC_TOKEN_ENDPOINT=https://issuer.example.com/token
# ADMIN_BFF_OIDC_REVOCATION_ENDPOINT=https://issuer.example.com/revoke
# ADMIN_BFF_OIDC_REDIRECT_URI=https://admin.example.com/auth/callback
# ADMIN_BFF_OIDC_CLIENT_ID=admin-bff
# ADMIN_BFF_OIDC_SCOPES_JSON=["openid","offline_access"]

## For local authorization
ADMIN_BFF_AUTH_MODE=local
ADMIN_BFF_CONFIG_DIR=./config
ADMIN_BFF_HTTP_HOST=127.0.0.1
ADMIN_BFF_HTTP_PORT=3001
ADMIN_BFF_PUBLIC_ORIGIN=http://127.0.0.1:3000
ADMIN_BFF_LOCAL_AUTH_SECURE_COOKIES=false
ADMIN_BFF_ADMIN_SHELL_VERSION=1.0.0
ADMIN_BFF_ADMIN_MANIFESTS_JSON=[]

# Inject ADMIN_BFF_OIDC_CLIENT_SECRET and ADMIN_BFF_SESSION_KEY_RING_JSON through the deployment secret manager.
# Core TypeORM overrides, if needed, retain the PROSTO_PERSISTENCE__TYPEORM__... namespace.
