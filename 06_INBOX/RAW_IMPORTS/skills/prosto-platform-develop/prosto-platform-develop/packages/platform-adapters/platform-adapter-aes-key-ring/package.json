    "@prosto/platform-sdk": "0.0.0"
  },
  "devDependencies": {
    "@internal/tsconfig": "*",
    "@tsconfig/node22": "^22.0.5",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  }
