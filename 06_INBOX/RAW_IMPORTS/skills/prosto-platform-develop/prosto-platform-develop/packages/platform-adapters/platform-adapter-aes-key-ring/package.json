{
  "name": "@prosto/platform-adapter-aes-key-ring",
  "version": "0.0.0",
  "description": "AES-256-GCM key-ring secret cipher adapter for Prosto platform",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
