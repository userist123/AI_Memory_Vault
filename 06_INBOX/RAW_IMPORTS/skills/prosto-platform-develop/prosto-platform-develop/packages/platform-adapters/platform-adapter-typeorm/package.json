{
  "name": "@prosto/platform-adapter-typeorm",
  "version": "0.0.0",
  "description": "TypeORM persistence adapter for Prosto Platform",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:integration": "cross-env PROSTO_TYPEORM_INTEGRATION=1 vitest run"
  },
  "dependencies": {
    "@prosto/platform-sdk": "0.0.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@internal/tsconfig": "*",
    "@tsconfig/node22": "^22.0.5",
    "cross-env": "^7.0.3",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "pg": "^8.16.0",
    "sqlite3": "^5.1.7",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "pg": "^8.16.0",
    "sqlite3": "^5.1.7"
  },
  "peerDependenciesMeta": {
    "mssql": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  }
}
