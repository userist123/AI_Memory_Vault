{
  "name": "@prosto/platform-admin-shell",
  "version": "0.0.0",
  "description": "Admin shell with Vue 3 plugin runtime for Prosto platform",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --open",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@prosto/platform-admin-contracts": "0.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-router": "^5.1.0",
    "vuetify": "^4.1.1"
  },
  "devDependencies": {
    "@internal/tsconfig": "*",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.10.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.4"
  }
}
