{
  "name": "prosto-platform",
  "version": "0.0.0",
  "description": "A TypeScript-based headless platform with a micro-core architecture and plug-in module extensibility",
  "private": true,
  "author": {
    "name": "PROSTO SYSTEMS",
    "url": "https://github.com/prosto-systems"
  },
  "license": "MIT",
  "homepage": "https://github.com/prosto-systems/prosto-platform#readme",
  "bugs": {
    "url": "https://github.com/prosto-systems/prosto-platform/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prosto-systems/prosto-platform.git"
  },
  "keywords": [
    "prosto",
    "headless",
    "platform",
    "typescript",
    "micro-core",
    "cms",
    "content management system",
    "admin panel",
    "backend"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "start": "npm run start --workspace=@prosto/platform-core",
    "start:local": "turbo build --filter=@examples/admin-bff-http-host... && npm run start:local --workspace=@examples/admin-bff-http-host",
    "auth:bootstrap-local": "turbo build --filter=@prosto/platform-cli... && node packages/platform-cli/dist/index.js auth bootstrap-local",
    "dev": "turbo dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "turbo typecheck",
    "lint:architecture": "node ./scripts/lint-architecture.mjs",
    "validate:dependency-policy": "node ./scripts/validate-dependency-policy.mjs",
    "validate:module-graph": "node ./scripts/validate-module-graph.mjs",
    "validate:public-api-boundary": "node ./scripts/validate-public-api-boundary.mjs",
    "validate:runtime-policy": "node ./scripts/validate-runtime-policy.mjs",
    "test": "turbo test",
    "test:contracts": "turbo test:contracts",
    "test:lifecycle-determinism": "node ./scripts/test-lifecycle-determinism.mjs",
    "bench:startup": "npm run bench:startup --workspace=@prosto/platform-core",
    "bench:events": "npm run bench:events --workspace=@prosto/platform-core",
    "bench:regression": "node ./scripts/check-bench-regression.mjs",
    "bench:calibrate": "node ./scripts/calibrate-bench-baseline.mjs",
    "release:evidence": "node ./scripts/generate-release-evidence.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.8.0",
    "dotenv": "^16.6.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "p-limit": "^7.3.0",
    "prettier": "^3.8.4",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "packages/*/*/*",
    "examples/*"
  ],
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,mdx,yml,yaml,html,css,scss,graphql}": "prettier --write"
  },
  "packageManager": "npm@10.32.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=8.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
