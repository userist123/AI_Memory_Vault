<UserControl x:Class="LogAnalyzer.UI.Views.RiskAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Explainable Risk Analysis" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Heuristic entropy scoring, masquerading detection &amp; ISO/IEC 27042 traceable factor ledger" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Run AI &amp; Heuristic Evaluation" Command="{Binding RunAiAnalysisCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,8"/>
        </DockPanel>

        <!-- KPI Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="OVERALL RISK SCORE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AiRiskScore, StringFormat='{}{0}/100'}" Foreground="{Binding AiRiskColor}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding AiRiskLevel}" Foreground="{Binding AiRiskColor}" FontSize="11" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="SHANNON ENTROPY (H &gt; 4.8)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AiHighEntropyCount}" Foreground="{StaticResource HighBrush}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Obfuscated script payloads" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="PROCESS MASQUERADING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AiMasqueradingCount}" Foreground="{StaticResource CriticalBrush}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Execution from %TEMP%/AppData" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ObsidianCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="YARA MATCHES &amp; OFF-HOURS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AiYaraMatchesCount}" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Malicious pattern alignments" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Executive Summary Box -->
        <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Executive Synthesis &amp; Tactical Guidance:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding AiExecutiveSummary}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Traceable Factor Ledger -->
        <Border Grid.Row="3" Style="{StaticResource ObsidianCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Weighted Risk Breakdown (ISO/IEC 27042 Forensic Audit Trail)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,0,0,10"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding ExplainableRiskFactors}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Points" Binding="{Binding WeightPoints, StringFormat='+{0} pts'}" Width="85" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}"/>
                        <DataGridTextColumn Header="Risk Category" Binding="{Binding Category}" Width="180" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="MITRE ID" Binding="{Binding MitreTechniqueId}" Width="100"/>
                        <DataGridTextColumn Header="Evidence Source" Binding="{Binding EvidenceSource}" Width="150"/>
                        <DataGridTextColumn Header="Forensic Rationale / Justification" Binding="{Binding LegalJustification}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>