<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 8px Base Spacing Grid -->
    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing20">20</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>

    <!-- Margins & Paddings -->
    <Thickness x:Key="MarginSmall">4</Thickness>
    <Thickness x:Key="MarginMedium">8</Thickness>
    <Thickness x:Key="MarginLarge">16</Thickness>
    <Thickness x:Key="MarginXLarge">24</Thickness>

    <Thickness x:Key="PaddingSmall">8,4</Thickness>
    <Thickness x:Key="PaddingMedium">12,6</Thickness>
    <Thickness x:Key="PaddingPanel">16</Thickness>
    <Thickness x:Key="PaddingPanelLarge">24</Thickness>

    <!-- Corner Radius -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">10</CornerRadius>
    <CornerRadius x:Key="RadiusBadge">12</CornerRadius>

</ResourceDictionary>