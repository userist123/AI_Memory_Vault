<Window x:Class="LogAnalyzer.UI.Views.AlertDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forensic Security Alert Triage" Height="500" Width="720"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.20"/>
                    <DoubleAnimation Storyboard.TargetName="RootTransform" Storyboard.TargetProperty="Y" From="15" To="0" Duration="0:0:0.20" DecelerationRatio="0.3"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="RootBorder" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="1.5" CornerRadius="10" Opacity="0" Effect="{StaticResource ModalShadow}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootTransform" Y="15"/>
        </Border.RenderTransform>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>
            
            <!-- Modal Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource Surface2Brush}" MouseDown="TitleBar_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                    <Path Data="M 12 2 L 2 22 L 22 22 Z M 12 6 L 20 20 L 4 20 Z M 11 10 L 13 10 L 13 14 L 11 14 Z M 11 16 L 13 16 L 13 18 L 11 18 Z"
                          Fill="{StaticResource PrimaryAccentBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SECURITY ALERT TRIAGE &amp; PLAYBOOK" Foreground="{StaticResource PrimaryAccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click" Width="38" Height="30" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"/>
            </Grid>

            <!-- Body Details -->
            <ScrollViewer Grid.Row="1" Margin="20,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Severity & Title Header -->
                    <DockPanel LastChildFill="False" Margin="0,0,0,14">
                        <Border x:Name="SeverityBadge" DockPanel.Dock="Left" Background="#2D1217" BorderBrush="{StaticResource CriticalBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SeverityText" Text="CRITICAL" Foreground="{StaticResource CriticalBrush}" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="TitleBlock" DockPanel.Dock="Left" Text="Alert Title" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- MITRE & Compliance References -->
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MITRE ATT&amp;CK TECHNIQUE:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="MitreBlock" Text="T1059.001 (Command and Scripting Interpreter)" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FORENSIC COMPLIANCE SCOPE:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="ComplianceBlock" Text="NIS2 / DNSC Directive 2022/2555" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Detailed Explanation -->
                    <TextBlock Text="TECHNICAL ANALYSIS &amp; DETECTED ARTIFACTS:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="DetailsTextBox" IsReadOnly="True" TextWrapping="Wrap" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource CodeTextBrush}" BorderBrush="{StaticResource BorderBrush}" FontFamily="{StaticResource CodeFontFamily}" FontSize="11.5" Padding="12" MinHeight="140" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Footer -->
            <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                <DockPanel LastChildFill="False">
                    <Button DockPanel.Dock="Right" Content="Acknowledge &amp; Close" Click="Close_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,6" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>