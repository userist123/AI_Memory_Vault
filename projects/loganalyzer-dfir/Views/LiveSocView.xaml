<UserControl x:Class="LogAnalyzer.UI.Views.LiveSocView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Command Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource ObsidianCardStyle}" Margin="0,0,0,16" Padding="14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="TARGET SENSOR:" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding LiveRemoteTargetHost, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    
                    <Button Content="▶ START LIVE STREAM" Command="{Binding StartLiveMonitoringCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="12,5" Margin="0,0,8,0"/>
                    <Button Content="⏹ STOP" Command="{Binding StopLiveMonitoringCommand}" Style="{StaticResource DangerButtonStyle}" Padding="12,5" Margin="0,0,8,0"/>

                    <!-- Attack Simulation Dropdown -->
                    <Button Content="Simulate Attack (11 Scenarios) ▾" Click="SimulateMenuButton_Click" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource PrimaryAccentBrush}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" Padding="12,5" Margin="0,0,8,0">
                        <Button.ContextMenu>
                            <ContextMenu Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
                                <MenuItem Header="1. Generic SOC Signature Match" Command="{Binding SimulateLiveAlertCommand}"/>
                                <MenuItem Header="2. Phishing &amp; Dropper (T1566)" Command="{Binding SimulatePhishingAttackCommand}"/>
                                <MenuItem Header="3. Lateral Movement PsExec (T1021.002)" Command="{Binding SimulateLateralMovementAttackCommand}"/>
                                <MenuItem Header="4. BYOVD Kernel Ring 0 Exploit (T1068)" Command="{Binding SimulateByovdAttackCommand}"/>
                                <MenuItem Header="5. Process Hollowing Injection (T1055.012)" Command="{Binding SimulateProcessHollowingAttackCommand}"/>
                                <MenuItem Header="6. Physical BadUSB / Rubber Ducky (T1052.001)" Command="{Binding SimulateBadUsbAttackCommand}"/>
                                <MenuItem Header="7. Infostealer &amp; Session Hijacking (T1539)" Command="{Binding SimulateMfaBypassStealerAttackCommand}"/>
                                <MenuItem Header="8. LLMNR / NTLM Network Poisoning (T1557.001)" Command="{Binding SimulateLlmnrPoisoningAttackCommand}"/>
                                <MenuItem Header="9. Potato Privilege Escalation (T1134.001)" Command="{Binding SimulatePotatoPrivEscAttackCommand}"/>
                                <MenuItem Header="10. CPU Silicon &amp; Rowhammer (T1499)" Command="{Binding SimulateCpuSiliconAttackCommand}"/>
                                <MenuItem Header="11. Acoustic Fan Exfiltration (T1048)" Command="{Binding SimulateAcousticFanAttackCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Remediation Action Dropdown -->
                    <Button Content="Remediation Playbook ▾" Click="SimulateMenuButton_Click" Background="{StaticResource Surface3Brush}" BorderBrush="{StaticResource SuccessBrush}" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Padding="12,5" Margin="0,0,8,0">
                        <Button.ContextMenu>
                            <ContextMenu Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
                                <MenuItem Header="1. De-Isolate Network (Flush Containment Rules)" Command="{Binding ExecuteRestoreNetworkCommand}"/>
                                <MenuItem Header="2. Purge Remote PsExec Services" Command="{Binding RemediateServicesActionCommand}"/>
                                <MenuItem Header="3. Clean Vulnerable BYOVD Drivers" Command="{Binding RemediateDriversActionCommand}"/>
                                <MenuItem Header="4. Enforce LSA Protection (RunAsPPL &amp; HVCI)" Command="{Binding RemediateLsaProtectionActionCommand}"/>
                                <MenuItem Header="5. Reset Acoustic Fan Policy (TEMPEST)" Command="{Binding RemediateHardwareCoolingActionCommand}"/>
                                <MenuItem Header="6. Total Containment Flush" Command="{Binding RemediateResetAllRulesActionCommand}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Content="Clear Stream" Command="{Binding ClearLiveFeedCommand}" Padding="10,5"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CAPTURED: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding TotalLiveEventsCaptured, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="4,0,10,0"/>
                        <TextBlock Text="ALERTS: " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LiveAlerts.Count, FallbackValue=0}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CriticalBrush}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Live Event Stream Grid -->
        <Border Grid.Row="1" Style="{StaticResource ObsidianCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Left" Text="Live In-Memory Telemetry Stream" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock DockPanel.Dock="Right" Text="Auto-refreshing &lt; 50ms" FontSize="11" Foreground="{StaticResource SuccessBrush}"/>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding LiveStreamingEvents}" SelectedItem="{Binding SelectedLiveStreamingEvent}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding TimeCreated, StringFormat={}{0:HH:mm:ss.fff}}" Width="110"/>
                        <DataGridTextColumn Header="EID" Binding="{Binding EventId}" Width="60"/>
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="80"/>
                        <DataGridTextColumn Header="Provider" Binding="{Binding ProviderName}" Width="140"/>
                        <DataGridTextColumn Header="Host" Binding="{Binding MachineName}" Width="110"/>
                        <DataGridTextColumn Header="Telemetry Payload" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>