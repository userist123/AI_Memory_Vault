<Window x:Class="RegistruTransferuri.UI.Dialogs.FourEyesAuthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUTORIZARE DUALĂ PRINCIPIUL CELOR 4 OCHI (FOUR-EYES)"
        Height="450" Width="600"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Alert Banner -->
        <Border Grid.Row="0" Background="#3B2677" BorderBrush="{StaticResource TacticalVioletBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="🔒 AUTORIZARE DUALĂ OBLIGATORIE (HG 585 / NATO AC/35)" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                <TextBlock Text="Transferul clasificat (Secret / Strict Secret / SSID) impune contrasemnarea de către un al doilea utilizator autorizat (Ofițer Securitate / Martor)."
                           TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Form Content -->
        <GroupBox Grid.Row="1" Header="👥 Autentificare Martor Verificator / Ofițer Securitate" Style="{StaticResource TacticalGroupBoxStyle}">
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Selectați Ofițer Securitate / Martor Verificator: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <ComboBox x:Name="ApproverCombo" Height="36" Margin="0,0,0,12" />

                <TextBlock Text="Funcție &amp; Calitate Martor:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="ApproverRoleBox" Text="Ofițer Securitate INFOSEC / Structura Securitate" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Margin="0,0,0,12" />

                <TextBlock Text="PIN Numeric Securizat (6 cifre) al Martorului: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <PasswordBox x:Name="ApproverPinBox" Style="{StaticResource TacticalPasswordBoxStyle}" Height="38" HorizontalContentAlignment="Center" MaxLength="6" />
            </StackPanel>
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Anulează" Width="110" Height="36" Margin="0,0,10,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnCancelClick" />
            <Button Content="✅ Aprobă &amp; Contrasemnează" Width="220" Height="36" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnAuthorizeClick" />
        </StackPanel>
    </Grid>
</Window>
