<Window x:Class="RegistruTransferuri.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RegistruTransferuri.Models"
        Title="ROMÂNIA — REGISTRU TRANSFERURI (HG 585 / NATO AC/35 / EUCI)"
        Width="1400" Height="860"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= SARCINA 3: LEFT SIDEBAR (MOCKUP EXACT REPRODUCTION) ================= -->
        <Border Grid.Column="0" Background="{StaticResource BgBaseBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand / Military Crest + Collapse Toggle -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Vector Military Crest: Romanian Armed Forces / NATO -->
                        <StackPanel x:Name="PanelBrandText" Grid.Column="0" HorizontalAlignment="Center">
                            <!-- Golden Eagle Crest with Blue Center & NATO Star -->
                            <Grid Width="74" Height="74" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <!-- Outer Glow / Shield Base -->
                                <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1.5" CornerRadius="12" Padding="4">
                                    <Viewbox Stretch="Uniform">
                                        <Canvas Width="100" Height="100">
                                            <!-- Gold Laurel & Eagle Wings -->
                                            <Path Data="M 15,35 C 10,20 25,10 50,8 C 75,10 90,20 85,35 C 80,50 92,65 80,82 C 70,92 50,96 50,96 C 50,96 30,92 20,82 C 8,65 20,50 15,35 Z" Fill="#1E293B" Stroke="#F59E0B" StrokeThickness="3" />
                                            <!-- Inner Blue Shield -->
                                            <Path Data="M 28,30 L 72,30 L 72,55 C 72,70 50,82 50,82 C 50,82 28,70 28,55 Z" Fill="#0D1322" Stroke="#38BDF8" StrokeThickness="2" />
                                            <!-- Golden Sword / Central Axis -->
                                            <Path Data="M 48,15 L 52,15 L 52,78 L 48,78 Z" Fill="#F59E0B" />
                                            <Path Data="M 42,24 L 58,24 L 58,27 L 42,27 Z" Fill="#F59E0B" />
                                            <!-- NATO 4-Point Compass Star -->
                                            <Path Data="M 50,38 L 53,47 L 62,50 L 53,53 L 50,62 L 47,53 L 38,50 L 47,47 Z" Fill="#F8FAFC" Stroke="#00E5FF" StrokeThickness="1" />
                                            <!-- Small Gold Laurel Leaves -->
                                            <Path Data="M 22,48 C 18,52 18,60 24,64" Stroke="#F59E0B" StrokeThickness="2" Fill="Transparent" />
                                            <Path Data="M 78,48 C 82,52 82,60 76,64" Stroke="#F59E0B" StrokeThickness="2" Fill="Transparent" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>

                            <TextBlock Text="STATUL MAJOR AL APĂRĂRII" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="ROMANIAN ARMED FORCES" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>

                        <Button x:Name="BtnToggleSidebar" Grid.Column="1" Content="◀" Width="26" Height="26" VerticalAlignment="Top" Padding="0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnToggleSidebarClick" ToolTip="Comută afișarea meniului" />
                    </Grid>
                    <Border Background="{StaticResource BorderDefaultBrush}" Height="1" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Navigation List (Vertical Menu matching mockup) -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton x:Name="NavRegistru" Content="📋  REGISTRU TRANSFERURI" Style="{StaticResource SidebarNavButtonStyle}" IsChecked="True" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavInregistrare" Content="✈️  TRANSFERURI ÎN AȘTEPTARE" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavIstoric" Content="🕒  ISTORIC TRANSFERURI" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavMedii" Content="🏛️  UNITĂȚI MILITARE" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavOracle" Content="🛡️  CLASIFICĂRI" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavAdmin" Content="👥  UTILIZATORI" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavStats" Content="📊  RAPOARTE" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavAudit" Content="📋  JURNAL SISTEM" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavSetari" Content="⚙️  SETĂRI" Style="{StaticResource SidebarNavButtonStyle}" Checked="OnNavChanged" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Station Telemetry & Air-Gapped Status Card (Mockup Exact Match) -->
                <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,10">
                    <StackPanel>
                        <TextBlock Text="STATION TELEMETRY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                        <!-- Protocol Status Indicator -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Hexagon Shield with Padlock -->
                            <Border Grid.Column="0" Width="36" Height="36" Background="#064E3B" BorderBrush="{StaticResource EmeraldSecurityBrush}" BorderThickness="1.5" CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 6,10 L 18,10 C 19.1,10 20,10.9 20,12 L 20,20 C 20,21.1 19.1,22 18,22 L 6,22 C 4.9,22 4,21.1 4,20 L 4,12 C 4,10.9 4.9,10 6,10 Z" Fill="{StaticResource EmeraldSecurityBrush}" />
                                        <Path Data="M 8,10 L 8,7 C 8,4.8 9.8,3 12,3 C 14.2,3 16,4.8 16,7 L 16,10" Stroke="{StaticResource EmeraldSecurityBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                        <Path Data="M 12,14 C 11.2,14 10.5,14.7 10.5,15.5 C 10.5,16.1 10.9,16.6 11.4,16.8 L 11,19 L 13,19 L 12.6,16.8 C 13.1,16.6 13.5,16.1 13.5,15.5 C 13.5,14.7 12.8,14 12,14 Z" Fill="#064E3B" />
                                    </Canvas>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AIR-GAPPED PROTOCOL:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource EmeraldSecurityBrush}" />
                                <TextBlock Text="ACTIVE" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource EmeraldSecurityBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Telemetry Metrics Key-Value Grid -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NODE ID" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                            <TextBlock x:Name="LblHostInfo" Grid.Row="0" Grid.Column="1" Text="MIL-RO-AGP-01" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource EmeraldSecurityBrush}" FontWeight="SemiBold" Margin="0,2" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="NETWORK STATUS" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="AIR-GAPPED" FontSize="9" Foreground="{StaticResource EmeraldSecurityBrush}" FontWeight="Bold" Margin="0,2" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="LAST SYNC" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="NEVER" FontSize="9" Foreground="{StaticResource EmeraldSecurityBrush}" FontWeight="Bold" Margin="0,2" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="SYSTEM TIME" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="0,2" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="2025-05-20 14:32:18 EEST" FontSize="9" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource EmeraldSecurityBrush}" Margin="0,2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sidebar Footer -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🛡️ DEFEND. PROTECT. SERVE." FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="v2.4.7.1" FontSize="9" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Tactical Header Bar (Mockup Exact Match) -->
            <Border Grid.Row="0" Background="{StaticResource BgBaseBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Hamburger Toggle & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 3,6 L 21,6 M 3,12 L 21,12 M 3,18 L 21,18" Stroke="{StaticResource TextPrimaryBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <Border Width="3" Height="26" CornerRadius="1.5" Background="{StaticResource TacticalVioletBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LblViewTitle" Text="REGISTRU TRANSFERURI" FontSize="17" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="DATA TRANSFER REGISTRY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: NATO Shield, Operator Profile & Avatar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- NATO Shield Icon -->
                        <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 12,2 L 4,5 L 4,11 C 4,16.5 7.4,21.7 12,23 C 16.6,21.7 20,16.5 20,11 L 20,5 Z" Fill="#0D1322" Stroke="{StaticResource CyberBlueBrush}" StrokeThickness="1.8" />
                                    <Path Data="M 12,6 L 13.2,10.2 L 17.5,11.5 L 13.2,12.8 L 12,17 L 10.8,12.8 L 6.5,11.5 L 10.8,10.2 Z" Fill="{StaticResource CyberBlueBrush}" />
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Operator Info Block -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="OPERATOR" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="LblOperatorName" Text="MAJ. ANDREI POPESCU" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,1,0,2" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CLEARANCE LEVEL  " FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource AmberDarkBrush}" BorderBrush="{StaticResource AmberWarningBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblOperatorClearance" Text="NATO CONFIDENTIAL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AmberWarningBrush}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Operator Avatar with Violet Glow & Online Indicator -->
                        <Grid Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border CornerRadius="21" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource TacticalVioletBrush}" BorderThickness="2" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="{StaticResource TacticalVioletColor}" Opacity="0.8" />
                                </Border.Effect>
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M 12,2 C 9.5,2 7.5,4 7.5,6.5 C 7.5,7.8 8.2,9 9.2,9.7 C 6.5,10.8 4.5,13.5 4.5,16.8 L 4.5,20 L 19.5,20 L 19.5,16.8 C 19.5,13.5 17.5,10.8 14.8,9.7 C 15.8,9 16.5,7.8 16.5,6.5 C 16.5,4 14.5,2 12,2 Z" Fill="{StaticResource TextPrimaryBrush}" />
                                        <Path Data="M 6,7 L 18,7 L 16,5 L 8,5 Z" Fill="{StaticResource AmberWarningBrush}" />
                                        <Path Data="M 12,3.5 L 12.6,4.7 L 14,4.7 L 12.9,5.5 L 13.3,6.8 L 12,6 L 10.7,6.8 L 11.1,5.5 L 10,4.7 L 11.4,4.7 Z" Fill="#F59E0B" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <!-- Online Dot -->
                            <Ellipse Width="10" Height="10" Fill="{StaticResource EmeraldSecurityBrush}" Stroke="{StaticResource BgBaseBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                        </Grid>

                        <Button Content="🔒 Delogare" Height="36" Padding="14,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnLogoutClick" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Dynamic Views Container (Wrapped in ScrollViewer) -->
            <Grid Grid.Row="1" Background="{StaticResource BgDeepBrush}">

                <!-- ================= 1. VIEW REGISTRU TRANSFERURI (MOCKUP EXACT REPRODUCTION) ================= -->
                <ScrollViewer x:Name="ViewRegistru" Visibility="Visible" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <!-- Main Card Container with Subtle Purple Glow -->
                        <Border Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="{StaticResource TacticalVioletColor}" Opacity="0.4" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top Filter & Action Bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Date Filter & Filters Button -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <ComboBox x:Name="CmbFilterClassification" Height="36" Width="180" Margin="0,0,10,0" SelectionChanged="OnRegistryFilterChanged" />
                                        <Button Content="☰  FILTRE" Height="36" Width="100" Style="{StaticResource TacticalSecondaryButtonStyle}" />
                                        <TextBox x:Name="TxtSearchRegistry" Width="240" Height="36" Margin="10,0,0,0" Style="{StaticResource TacticalTextBoxStyle}" ToolTip="Filtrează după Nr. Înreg, Sursă, Destinație, Persoană, S/N..." TextChanged="OnRegistryFilterChanged" />
                                    </StackPanel>

                                    <!-- Right: Export CSV Button -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Content="📥  EXPORT CSV" Height="36" Padding="16,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnExportCsvClick" />
                                    </StackPanel>
                                </Grid>

                                <!-- Main Registry DataGrid -->
                                <DataGrid x:Name="GridTransfers" Grid.Row="1" MinHeight="480" Style="{StaticResource TacticalDataGridStyle}" SelectionChanged="OnTransferSelectionChanged">
                                    <DataGrid.Columns>
                                        <!-- 1. Dată / Oră -->
                                        <DataGridTemplateColumn Header="DATĂ / ORĂ  ⇅" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding FormattedDate}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 2. Nivel Clasificare -->
                                        <DataGridTemplateColumn Header="NIVEL CLASIFICARE  ⇅" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse x:Name="DotIndicator" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtClass" Text="{Binding ClassificationDisplayName}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.Neclasificat}">
                                                            <Setter TargetName="DotIndicator" Property="Fill" Value="{StaticResource EmeraldSecurityBrush}" />
                                                            <Setter TargetName="TxtClass" Property="Foreground" Value="{StaticResource EmeraldSecurityBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.SecretDeServiciu}">
                                                            <Setter TargetName="DotIndicator" Property="Fill" Value="{StaticResource AmberWarningBrush}" />
                                                            <Setter TargetName="TxtClass" Property="Foreground" Value="{StaticResource AmberWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.Secret}">
                                                            <Setter TargetName="DotIndicator" Property="Fill" Value="{StaticResource AmberWarningBrush}" />
                                                            <Setter TargetName="TxtClass" Property="Foreground" Value="{StaticResource AmberWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.StrictSecret}">
                                                            <Setter TargetName="DotIndicator" Property="Fill" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="TxtClass" Property="Foreground" Value="{StaticResource CrimsonDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.StrictSecretDeImportantaDeosebita}">
                                                            <Setter TargetName="DotIndicator" Property="Fill" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="TxtClass" Property="Foreground" Value="{StaticResource CrimsonDangerBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 3. Unitate Sursă -->
                                        <DataGridTemplateColumn Header="UNITATE SURSĂ  ⇅" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SourceInstitution}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 4. Unitate Destinație -->
                                        <DataGridTemplateColumn Header="UNITATE DESTINAȚIE  ⇅" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DestinationInstitution}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 5. SHA-256 Hash -->
                                        <DataGridTemplateColumn Header="SHA-256 HASH" Width="260">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PayloadSha256Hash}" 
                                                               FontFamily="Consolas, Cascadia Code" 
                                                               FontSize="10.5" 
                                                               Foreground="{StaticResource CyberBlueBrush}" 
                                                               TextWrapping="Wrap" 
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- 6. Status Badge -->
                                        <DataGridTemplateColumn Header="STATUS" Width="190">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="StatusBadgeBorder" CornerRadius="12" Padding="10,4" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="StatusText" Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.Neclasificat}">
                                                            <Setter TargetName="StatusBadgeBorder" Property="Background" Value="{StaticResource EmeraldDarkBrush}" />
                                                            <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="{StaticResource EmeraldSecurityBrush}" />
                                                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource EmeraldSecurityBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource EmeraldSecurityBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.SecretDeServiciu}">
                                                            <Setter TargetName="StatusBadgeBorder" Property="Background" Value="{StaticResource AmberDarkBrush}" />
                                                            <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="{StaticResource AmberWarningBrush}" />
                                                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource AmberWarningBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AmberWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.Secret}">
                                                            <Setter TargetName="StatusBadgeBorder" Property="Background" Value="{StaticResource AmberDarkBrush}" />
                                                            <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="{StaticResource AmberWarningBrush}" />
                                                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource AmberWarningBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AmberWarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.StrictSecret}">
                                                            <Setter TargetName="StatusBadgeBorder" Property="Background" Value="{StaticResource CrimsonDarkBrush}" />
                                                            <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource CrimsonDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Classification}" Value="{x:Static models:ClassificationLevel.StrictSecretDeImportantaDeosebita}">
                                                            <Setter TargetName="StatusBadgeBorder" Property="Background" Value="{StaticResource CrimsonDarkBrush}" />
                                                            <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource CrimsonDangerBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Cancelled}" Value="True">
                                                            <Setter TargetName="StatusBadgeBorder" Property="Background" Value="{StaticResource CrimsonDarkBrush}" />
                                                            <Setter TargetName="StatusBadgeBorder" Property="BorderBrush" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="StatusDot" Property="Fill" Value="{StaticResource CrimsonDangerBrush}" />
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource CrimsonDangerBrush}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Pagination & Records Footer Bar -->
                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Record Counter -->
                                    <TextBlock Grid.Column="0" Text="AFIȘARE 1 - 10 DIN 237 ÎNREGISTRĂRI" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                    <!-- Center: Pagination Controls -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="&lt;" Width="32" Height="32" Margin="2,0" Style="{StaticResource TacticalSecondaryButtonStyle}" />
                                        <Button Content="1" Width="32" Height="32" Margin="2,0" Style="{StaticResource TacticalPrimaryButtonStyle}" />
                                        <Button Content="2" Width="32" Height="32" Margin="2,0" Style="{StaticResource TacticalSecondaryButtonStyle}" />
                                        <Button Content="3" Width="32" Height="32" Margin="2,0" Style="{StaticResource TacticalSecondaryButtonStyle}" />
                                        <TextBlock Text="..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0" />
                                        <Button Content="24" Width="32" Height="32" Margin="2,0" Style="{StaticResource TacticalSecondaryButtonStyle}" />
                                        <Button Content="&gt;" Width="32" Height="32" Margin="2,0" Style="{StaticResource TacticalSecondaryButtonStyle}" />
                                    </StackPanel>

                                    <!-- Right: Page Size Selector -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="ÎNREGISTRĂRI PE PAGINĂ  " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <ComboBox Width="68" Height="32" SelectedIndex="0">
                                            <ComboBoxItem Content="10" />
                                            <ComboBoxItem Content="25" />
                                            <ComboBoxItem Content="50" />
                                            <ComboBoxItem Content="100" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ================= 2. VIEW ÎNREGISTRARE TRANSFER ================= -->
                <Grid x:Name="ViewInregistrare" Visibility="Collapsed" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Wizard Step Progress Indicator -->
                            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{StaticResource TacticalVioletBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <TextBlock Text="1" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Suport Fizic &amp; Nr." FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="➔" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{StaticResource TacticalVioletBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <TextBlock Text="2" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Flux &amp; Entități" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="➔" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{StaticResource TacticalVioletBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <TextBlock Text="3" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="DLP Magic Bytes" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="5" Text="➔" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Border Background="{StaticResource TacticalVioletBrush}" CornerRadius="12" Width="24" Height="24" Margin="0,0,8,0">
                                            <TextBlock Text="4" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Semnare 4-Eyes" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Secțiunea 0: Număr Înregistrare & Mediu -->
                            <GroupBox Header="[Pasul 1] Număr Înregistrare &amp; Suport Fizic de Stocare" Style="{StaticResource TacticalGroupBoxStyle}">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Număr Înregistrare Transfer (Manual / Parsat / Auto HG 585): *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtRegNumber" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Text="MAPN-2026-S-0001" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Mediu Fizic Conectat Detectat Live (USB / SATA / CD-DVD): *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CmbDetectedMedia" Height="36" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Secțiunea 1: Entități și Flux -->
                            <GroupBox Header="[Pasul 2] Flux &amp; Entități (Sursă / Destinație / Curier)" Style="{StaticResource TacticalGroupBoxStyle}">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Unitate Sursă (Expeditor): *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSrcInst" Text="MApN / Structura Securitate" Style="{StaticResource TacticalTextBoxStyle}" Height="36" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Unitate Destinație (Destinatar): *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtDstInst" Text="Statul Major al Apărării / Baza 2" Style="{StaticResource TacticalTextBoxStyle}" Height="36" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Persoană Responsabilă Sursă: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtSrcPerson" Text="Cpt. Ionescu Radu" Style="{StaticResource TacticalTextBoxStyle}" Height="36" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Persoană Destinatar: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtDstPerson" Text="Mr. Popa Mihai" Style="{StaticResource TacticalTextBoxStyle}" Height="36" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Curier Militar / Delegat Transport:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtCourierName" Style="{StaticResource TacticalTextBoxStyle}" Height="36" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Permis Transport Curier:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtCourierPermit" Style="{StaticResource TacticalTextBoxStyle}" Height="36" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Secțiunea 2: Pachet Date & Inspecție DLP Magic Bytes -->
                            <GroupBox Header="[Pasul 3] Pachet Date, Inspecție DLP Magic Bytes &amp; Hash SHA-256" Style="{StaticResource TacticalGroupBoxStyle}">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Nivel Clasificare (HG 585 / NATO / UE): *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CmbNewTxClass" Height="36" SelectionChanged="OnNewTxClassificationChanged" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Selectare Fișier Fizic (Calculare Instantanee Hash SHA-256):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtPayloadPath" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="📁 Selectează" Width="125" Height="36" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnSelectPayloadFileClick" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                        <TextBlock Text="Denumire Pachet / Arhivă:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPayloadFileName" Text="Pachet_Date_Securizat.zip" Style="{StaticResource TacticalTextBoxStyle}" Height="36" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                        <TextBlock Text="Hash SHA-256 Calculat (Imuabil): 🔒" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtPayloadHash" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" Height="36" FontFamily="Consolas, Cascadia Code" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                        <TextBlock Text="Descriere Conținut Pachet &amp; Justificare:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtContentDesc" Text="Pachet de actualizări și documente operative conform SecOPs." Style="{StaticResource TacticalTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8" />
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- Submit / 4-Eyes Step -->
                            <Button Content="💾 [Pasul 4] Înregistrează Transfer în Sistem (cu Verificare 4-Eyes)" Height="46" FontSize="13" Style="{StaticResource TacticalPrimaryButtonStyle}" Margin="0,4,0,16" Click="OnSubmitTransferClick" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= 3. VIEW CONTROL MEDII ================= -->
                <Grid x:Name="ViewMedii" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ENDPOINT PROTECTION & PORT POLICIES CONTROLLER -->
                    <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🛡️ SUITA ENDPOINT DEVICE CONTROL &amp; POLITICI PORTURI USB" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyberBlueBrush}" VerticalAlignment="Center" />
                                    <Border x:Name="BadgePolicyStatus" Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtPolicyStatus" Text="POLITICĂ ACTIVĂ: WHITELIST STRICT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EmeraldSecurityBrush}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadPolicyWhitelist" Content="🛡️ Whitelist Strict (Doar Medii Înregistrate)" IsChecked="True" GroupName="GrpUsbPolicy" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="RadPolicyReadOnly" Content="👁️ Mod Forțat Doar-Citire (WriteProtect)" GroupName="GrpUsbPolicy" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="RadPolicyBlockAll" Content="🔒 Blocare Totală Porturi USB (USBSTOR)" GroupName="GrpUsbPolicy" Foreground="{StaticResource CrimsonDangerBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <RadioButton x:Name="RadPolicyFullAccess" Content="🔓 Acces Complet" GroupName="GrpUsbPolicy" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⚡ Aplică Politică" Height="36" Padding="10,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Margin="0,0,5,0" Click="OnApplyPortPolicyClick" />
                                <Button Content="🛠️ Reparare &amp; Deblocare Medii" Height="36" Padding="10,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Background="{StaticResource EmeraldSecurityBrush}" Margin="0,0,5,0" Click="OnRepairAndUnlockStorageClick" ToolTip="Șterge politicile GPO blocate, resetează atributele Read-Only și reactivează montarea automată" />
                                <Button Content="🔄 Resetare Politici" Height="36" Padding="10,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Margin="0,0,5,0" Click="OnRemoveAllPoliciesClick" ToolTip="Dezactivează toate restricțiile și readuce porturile la starea implicită" />
                                <Button Content="🔌 Ejectare" Height="36" Padding="10,0" Style="{StaticResource TacticalDangerButtonStyle}" Click="OnForceEjectMediaClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GroupBox Grid.Row="1" Header="🔌 Medii Conectate în Timp Real (Live PnP &amp; Evaluare Endpoint Protection)" Style="{StaticResource TacticalGroupBoxStyle}">
                        <DataGrid x:Name="GridLiveMedia" Style="{StaticResource TacticalDataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Volum" Binding="{Binding DriveLetter}" Width="80" FontWeight="Bold" />
                                <DataGridTextColumn Header="Tip Mediu" Binding="{Binding MediaType}" Width="110" />
                                <DataGridTextColumn Header="Model Fabrică" Binding="{Binding Model}" Width="*" />
                                <DataGridTextColumn Header="Identificator VID:PID" Binding="{Binding VendorId}" Width="120" />
                                <DataGridTextColumn Header="Serie Hardware (S/N 🔒)" Binding="{Binding SerialNumber}" Width="160" FontFamily="Consolas, Cascadia Code" />
                                <DataGridTextColumn Header="Capacitate" Binding="{Binding CapacityGb, StringFormat={}{0} GB}" Width="90" />
                                <DataGridTemplateColumn Header="Acțiune" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="⚡ Amprentează Mediu" Height="28" Padding="6,2" Margin="3" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnEnrollDetectedMediaClick" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Header="📋 Baza de Date a Mediilor de Stocare Amprentate (Device Control Whitelist)" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="TxtSearchMedia" Width="320" Height="36" Style="{StaticResource TacticalTextBoxStyle}" ToolTip="Caută după Denumire Volum, Nr. Înregistrare, Serie..." TextChanged="OnMediaFilterChanged" />
                                <Button Content="🏷️ Modifică Denumire Volum / Nr. Înregistrare" Height="36" Margin="10,0,0,0" Style="{StaticResource TacticalSecondaryButtonStyle}" Click="OnRenameMediaClick" />
                                <Button Content="🧹 Sanitizare NIST SP 800-88r2" Height="36" Margin="10,0,0,0" Style="{StaticResource TacticalDangerButtonStyle}" Click="OnSanitizeMediaClick" />
                            </StackPanel>

                            <DataGrid x:Name="GridMediaWhitelist" Grid.Row="1" Style="{StaticResource TacticalDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Denumire Volum &amp; Nr. Înreg." Binding="{Binding FriendlyName}" Width="200" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Tip Mediu" Binding="{Binding MediaType}" Width="120" />
                                    <DataGridTextColumn Header="Model Fabrică" Binding="{Binding Model}" Width="*" />
                                    <DataGridTextColumn Header="Serie Hardware S/N 🔒" Binding="{Binding SerialNumber}" Width="160" FontFamily="Consolas, Cascadia Code" />
                                    <DataGridTextColumn Header="Capacitate" Binding="{Binding CapacityGb, StringFormat={}{0} GB}" Width="90" />
                                    <DataGridTextColumn Header="Plafon Clasificare" Binding="{Binding MaxClassification}" Width="130" />
                                    <DataGridTextColumn Header="Politică Acces" Binding="{Binding Status}" Width="130" />
                                    <DataGridTextColumn Header="Gestionar" Binding="{Binding CustodianName}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- ================= 4. VIEW SEIF COGNITIV ================= -->
                <Grid x:Name="ViewOracle" Visibility="Collapsed" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="💬 Terminal Asistent INFOSEC &amp; Consultare Oracol Cognitiv" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer x:Name="ScrollOracleChat" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel x:Name="PanelOracleMessages">
                                    <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource CyberBlueBrush}" BorderThickness="2,0,0,0" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="🧠 Oracol INFOSEC (AI Memory Vault Bridge)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyberBlueBrush}" Margin="0,0,0,6" />
                                            <TextBlock Text="Sistemul de consultare cognitivă este activ în regim strict Air-Gapped. Puteți interoga procedurile HG 585/2002, standardele NATO AC/35-D/1022, normele EUCI și ghidurile de sanitizare NIST SP 800-88r2." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOracleQuery" Style="{StaticResource TacticalTextBoxStyle}" Height="38" Text="Care sunt normele de sanitizare NIST 800-88r2 pentru medii secrete?" KeyDown="OnOracleQueryKeyDown" />
                                <Button Grid.Column="1" Content="🔍 Întreabă Oracolul" Height="38" Margin="8,0,0,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnAskOracleClick" />
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Column="1" Header="📜 Inspector Documente &amp; Standarde Clasificate" Style="{StaticResource TacticalGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="140" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox x:Name="TxtSearchProcedures" Grid.Row="0" Style="{StaticResource TacticalTextBoxStyle}" Height="34" ToolTip="Caută în procedurile HG 585 / NATO..." Margin="0,0,0,8" TextChanged="OnSearchProceduresChanged" />
                            <ListBox x:Name="ListProcedures" Grid.Row="1" Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" SelectionChanged="OnProcedureSelectionChanged" />

                            <Border Grid.Row="2" Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtProcedurePreview" Text="Selectați o procedură din listă pentru vizualizare completă." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas, Cascadia Code" />
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- ================= 5. VIEW STATISTICI ================= -->
                <Grid x:Name="ViewStats" Visibility="Collapsed" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL TRANSFERURI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="KpiTotalTransfers" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TacticalVioletBrush}" Margin="0,6,0,0" />
                                        <TextBlock Text="▲ Jurnalizat cu SHA-256" FontSize="10" Foreground="{StaticResource EmeraldSecurityBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SECRET / NATO CONFIDENTIAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="KpiSecretTransfers" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AmberWarningBrush}" Margin="0,6,0,0" />
                                        <TextBlock Text="Autorizare 4-Ochi Aplicată" FontSize="10" Foreground="{StaticResource AmberWarningBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="MEDII AMPRENTATE (WHITELIST)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="KpiEnrolledMedia" Text="0" FontSize="28" FontWeight="Bold" Foreground="{StaticResource EmeraldSecurityBrush}" Margin="0,6,0,0" />
                                        <TextBlock Text="Dispozitive Active P16-P18" FontSize="10" Foreground="{StaticResource EmeraldSecurityBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="VOLUM TOTAL DATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock x:Name="KpiVolumeGb" Text="0.0 GB" FontSize="28" FontWeight="Bold" Foreground="{StaticResource CyberBlueBrush}" Margin="0,6,0,0" />
                                        <TextBlock Text="Trafic Air-Gapped Agregat" FontSize="10" Foreground="{StaticResource CyberBlueBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <GroupBox Header="📜 Raport Sintetic de Conformitate INFOSEC &amp; Registru Militar" Style="{StaticResource TacticalGroupBoxStyle}" MinHeight="420">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Content="📥 Export Raport Oficial Conformitate (PDF Nativ)" Height="36" Padding="14,0" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnExportOfficialStatsPdfClick" />
                                    </StackPanel>
                                    <TextBox Grid.Row="1" x:Name="TxtStatsReport" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code" FontSize="12" MinHeight="340" VerticalContentAlignment="Top" Padding="10,8" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= 6. VIEW JURNAL AUDIT ================= -->
                <Grid x:Name="ViewAudit" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔗 Verifică Integritatea Lanțului Criptografic SHA-256" Height="36" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnVerifyAuditChainClick" />
                            <TextBlock x:Name="LblAuditStatus" Text="Lanț audit: Neverificat" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource EmeraldSecurityBrush}" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="GridAudit" Grid.Row="1" Style="{StaticResource TacticalDataGridStyle}" SelectionChanged="OnAuditSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Secv." Binding="{Binding Sequence}" Width="70" FontWeight="Bold" />
                            <DataGridTextColumn Header="Timestamp UTC" Binding="{Binding TimestampUtc}" Width="160" />
                            <DataGridTextColumn Header="Acțiune" Binding="{Binding Action}" Width="160" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Operator" Binding="{Binding OperatorUsername}" Width="140" />
                            <DataGridTextColumn Header="Detalii Eveniment" Binding="{Binding Details}" Width="*" />
                            <DataGridTextColumn Header="Hash Intrare (SHA-256)" Binding="{Binding EntryHash}" Width="160" FontFamily="Consolas, Cascadia Code" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <GroupBox Grid.Row="2" Header="📋 Inspector Criptografic Bloc Audit &amp; Bloc Rădăcină (GENESIS)" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="280" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAuditInspector" IsReadOnly="True" Style="{StaticResource TacticalTextBoxStyle}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Cascadia Code" FontSize="11" Height="110" VerticalContentAlignment="Top" Padding="10,8" />
                            
                            <Border Grid.Column="1" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="10,0,0,0">
                                <StackPanel>
                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,6">
                                        <TextBlock Text="🏷️ BLOC GENESIS (ANCHOR)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EmeraldSecurityBrush}" />
                                    </Border>
                                    <TextBlock x:Name="TxtGenesisHash" Text="Hash Genesis: Verifică lanțul..." FontSize="10" FontFamily="Consolas, Cascadia Code" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- ================= 7. VIEW GESTIUNE OPERATORI ================= -->
                <Grid x:Name="ViewAdmin" Visibility="Collapsed" Margin="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="👤 Înregistrare Operator Militar Nou" Style="{StaticResource TacticalGroupBoxStyle}" Margin="0,0,14,0">
                                <StackPanel Margin="4,8,4,4">
                                    <TextBlock Text="Nume Complet &amp; Grad: *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtNewOpName" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Margin="0,0,0,10" />

                                    <TextBlock Text="Funcție &amp; Responsabilitate:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtNewOpRole" Text="Operator Transferuri IT" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Margin="0,0,0,10" />

                                    <TextBlock Text="Unitate Militară:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox x:Name="TxtNewOpUnit" Text="MApN / Structura Securitate" Style="{StaticResource TacticalTextBoxStyle}" Height="36" Margin="0,0,0,10" />

                                    <TextBlock Text="Nivel Autorizare (Clearance HG 585):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbNewOpClearance" Height="36" Margin="0,0,0,10" />

                                    <TextBlock Text="PIN Inițial (6 cifre numerice): *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <PasswordBox x:Name="TxtNewOpPin" Style="{StaticResource TacticalPasswordBoxStyle}" Height="40" FontSize="18" MaxLength="6" Margin="0,0,0,16" />

                                    <Button Content="➕ Înregistrează Operator" Height="40" Style="{StaticResource TacticalPrimaryButtonStyle}" Click="OnAddNewOperatorClick" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="👥 Operatori Înregistrați în Baza de Date" Style="{StaticResource TacticalGroupBoxStyle}" MinHeight="480">
                                <DataGrid x:Name="GridOperators" Style="{StaticResource TacticalDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nume Operator" Binding="{Binding FullName}" Width="*" FontWeight="Bold" />
                                        <DataGridTextColumn Header="Funcție" Binding="{Binding Role}" Width="140" />
                                        <DataGridTextColumn Header="Unitate" Binding="{Binding MilitaryUnit}" Width="160" />
                                        <DataGridTextColumn Header="Clearance Maxim" Binding="{Binding MaxClearance}" Width="140" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Active}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
