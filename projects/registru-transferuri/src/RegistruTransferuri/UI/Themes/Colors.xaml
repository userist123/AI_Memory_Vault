<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= OBSIDIAN TACTICAL COMMAND COLOR PALETTE ================= -->
    <!-- Surfaces & Backgrounds -->
    <Color x:Key="Color.Bg.Deep">#080C14</Color>
    <Color x:Key="Color.Bg.Base">#0D1322</Color>
    <Color x:Key="Color.Bg.Card">#121A2D</Color>
    <Color x:Key="Color.Bg.Elevated">#18233C</Color>
    <Color x:Key="Color.Bg.Highlight">#223254</Color>
    <Color x:Key="Color.Bg.Glass">#CC121A2D</Color>

    <!-- Borders & Dividers -->
    <Color x:Key="Color.Border.Default">#1E2C48</Color>
    <Color x:Key="Color.Border.Subtle">#2D3F66</Color>
    <Color x:Key="Color.Border.Glow">#6366F1</Color>

    <!-- Accents & Indicators -->
    <Color x:Key="Color.Accent.Violet">#7C3AED</Color>
    <Color x:Key="Color.Accent.VioletHover">#8B5CF6</Color>
    <Color x:Key="Color.Accent.VioletGlow">#4C1D95</Color>
    <Color x:Key="Color.Accent.CyberBlue">#00E5FF</Color>
    <Color x:Key="Color.Accent.Cyan">#06B6D4</Color>
    <Color x:Key="Color.Accent.Navy">#0284C7</Color>
    <Color x:Key="Color.Accent.Emerald">#10B981</Color>
    <Color x:Key="Color.Accent.EmeraldGlow">#064E3B</Color>
    <Color x:Key="Color.Accent.Amber">#F59E0B</Color>
    <Color x:Key="Color.Accent.AmberGlow">#78350F</Color>
    <Color x:Key="Color.Accent.Crimson">#EF4444</Color>
    <Color x:Key="Color.Accent.CrimsonGlow">#7F1D1D</Color>

    <!-- Text & Typography -->
    <Color x:Key="Color.Text.Primary">#F8FAFC</Color>
    <Color x:Key="Color.Text.Secondary">#94A3B8</Color>
    <Color x:Key="Color.Text.Muted">#64748B</Color>
    <Color x:Key="Color.Text.Cyan">#38BDF8</Color>
    <Color x:Key="Color.Text.Emerald">#34D399</Color>
    <Color x:Key="Color.Text.Amber">#FBBF24</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="Brush.Bg.Deep" Color="{StaticResource Color.Bg.Deep}" />
    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource Color.Bg.Base}" />
    <SolidColorBrush x:Key="Brush.Bg.Card" Color="{StaticResource Color.Bg.Card}" />
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{StaticResource Color.Bg.Elevated}" />
    <SolidColorBrush x:Key="Brush.Bg.Highlight" Color="{StaticResource Color.Bg.Highlight}" />
    <SolidColorBrush x:Key="Brush.Bg.Glass" Color="{StaticResource Color.Bg.Glass}" />

    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Glow" Color="{StaticResource Color.Border.Glow}" />

    <SolidColorBrush x:Key="Brush.Accent.Violet" Color="{StaticResource Color.Accent.Violet}" />
    <SolidColorBrush x:Key="Brush.Accent.VioletHover" Color="{StaticResource Color.Accent.VioletHover}" />
    <SolidColorBrush x:Key="Brush.Accent.VioletGlow" Color="{StaticResource Color.Accent.VioletGlow}" />
    <SolidColorBrush x:Key="Brush.Accent.CyberBlue" Color="{StaticResource Color.Accent.CyberBlue}" />
    <SolidColorBrush x:Key="Brush.Accent.Cyan" Color="{StaticResource Color.Accent.Cyan}" />
    <SolidColorBrush x:Key="Brush.Accent.Navy" Color="{StaticResource Color.Accent.Navy}" />
    <SolidColorBrush x:Key="Brush.Accent.Emerald" Color="{StaticResource Color.Accent.Emerald}" />
    <SolidColorBrush x:Key="Brush.Accent.EmeraldGlow" Color="{StaticResource Color.Accent.EmeraldGlow}" />
    <SolidColorBrush x:Key="Brush.Accent.Amber" Color="{StaticResource Color.Accent.Amber}" />
    <SolidColorBrush x:Key="Brush.Accent.AmberGlow" Color="{StaticResource Color.Accent.AmberGlow}" />
    <SolidColorBrush x:Key="Brush.Accent.Crimson" Color="{StaticResource Color.Accent.Crimson}" />
    <SolidColorBrush x:Key="Brush.Accent.CrimsonGlow" Color="{StaticResource Color.Accent.CrimsonGlow}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.Cyan" Color="{StaticResource Color.Text.Cyan}" />
    <SolidColorBrush x:Key="Brush.Text.Emerald" Color="{StaticResource Color.Text.Emerald}" />
    <SolidColorBrush x:Key="Brush.Text.Amber" Color="{StaticResource Color.Text.Amber}" />

    <!-- Linear Gradients for Badges & Headers -->
    <LinearGradientBrush x:Key="Brush.Gradient.Violet" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#4F46E5" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Gradient.Cyber" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0284C7" Offset="0" />
        <GradientStop Color="#06B6D4" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Gradient.AirGapped" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#064E3B" Offset="0" />
        <GradientStop Color="#047857" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
